{# Interview countdown component — pass interview.scheduledAt as 'scheduled_at' #}
{% if scheduled_at is defined and scheduled_at %}
<div x-data="interviewCountdown('{{ scheduled_at|date('c') }}')" class="inline-flex items-center gap-2 rounded-xl border border-primary/20 bg-primary/5 px-4 py-2 text-sm font-semibold text-primary">
    <i data-lucide="timer" class="h-4 w-4"></i>
    <span x-text="display" x-show="!expired">Loading...</span>
    <span x-show="expired" class="text-destructive">Interview started</span>
</div>
<script>
function interviewCountdown(isoDate) {
    return {
        display: '', expired: false, timer: null,
        init() { this.tick(); this.timer = setInterval(() => this.tick(), 1000); },
        tick() {
            const diff = new Date(isoDate) - Date.now();
            if (diff <= 0) { this.expired = true; this.display = 'Now'; clearInterval(this.timer); return; }
            const d = Math.floor(diff / 86400000), h = Math.floor((diff % 86400000) / 3600000),
                  m = Math.floor((diff % 3600000) / 60000), s = Math.floor((diff % 60000) / 1000);
            this.display = (d > 0 ? d + 'd ' : '') + h + 'h ' + m + 'm ' + s + 's';
        },
        destroy() { clearInterval(this.timer); }
    };
}
</script>
{% endif %}
