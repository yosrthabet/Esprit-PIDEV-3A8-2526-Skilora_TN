{# Status badge component — pass status (string) and optional variant #}
{% set colors = {
    'open': 'bg-blue-500/10 text-blue-600 border-blue-500/30',
    'in_progress': 'bg-amber-500/10 text-amber-600 border-amber-500/30',
    'resolved': 'bg-green-500/10 text-green-600 border-green-500/30',
    'closed': 'bg-gray-500/10 text-gray-500 border-gray-500/30',
    'active': 'bg-green-500/10 text-green-600 border-green-500/30',
    'pending': 'bg-amber-500/10 text-amber-600 border-amber-500/30',
    'rejected': 'bg-red-500/10 text-red-600 border-red-500/30',
    'accepted': 'bg-green-500/10 text-green-600 border-green-500/30',
    'draft': 'bg-gray-500/10 text-gray-500 border-gray-500/30',
    'published': 'bg-emerald-500/10 text-emerald-600 border-emerald-500/30',
    'archived': 'bg-slate-500/10 text-slate-500 border-slate-500/30',
    'completed': 'bg-emerald-500/10 text-emerald-600 border-emerald-500/30',
    'cancelled': 'bg-red-500/10 text-red-600 border-red-500/30',
    'funded': 'bg-violet-500/10 text-violet-600 border-violet-500/30',
    'disputed': 'bg-orange-500/10 text-orange-600 border-orange-500/30',
} %}
{% set color = colors[status|default('open')|lower] | default('bg-gray-500/10 text-gray-500 border-gray-500/30') %}
<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-label {{ color }}">
    {{ label|default(status|default('unknown')) }}
</span>
