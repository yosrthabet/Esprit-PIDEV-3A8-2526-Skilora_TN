{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Job Preferences{% endblock %}
{% block content %}
<div class="mx-auto max-w-3xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <form method="post" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-8 shadow-sm space-y-5">
        <div>
            <p class="text-xs font-black uppercase tracking-[0.35em] text-primary">Candidate preferences</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Shape your job radar.</h1>
            <p class="mt-3 text-base text-muted-foreground">These preferences help discovery and matching understand what you want next.</p>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('job_preferences_' ~ app.user.id) }}">
        <div>
            <label class="block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground mb-1.5">Target title</label>
            <input name="target_title" value="{{ preferences.targetTitle }}" placeholder="e.g. Symfony Developer" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm">
        </div>
        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <label class="block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground mb-1.5">Location</label>
                <input name="location" value="{{ preferences.location }}" placeholder="Preferred location" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm">
            </div>
            <div>
                <label class="block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground mb-1.5">Work type</label>
                <select name="work_type" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm"><option value="">Any work type</option>{% for type in work_types %}<option value="{{ type.value }}" {{ preferences.workType == type ? 'selected' }}>{{ type|work_type_label }}</option>{% endfor %}</select>
            </div>
            <div>
                <label class="block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground mb-1.5">Min salary</label>
                <input name="min_salary" value="{{ preferences.minSalary }}" type="number" min="0" placeholder="Minimum salary" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm">
            </div>
        </div>
        <button class="rounded-full bg-primary px-5 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Save preferences</button>
    </form>
</div>
{% endblock %}
