{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Job Preferences{% endblock %}
{% block content %}
<div class="mx-auto max-w-3xl px-4 py-6 sm:px-6 lg:px-8">
    <form method="post" class="glass-panel space-y-5 p-8">
        <div><p class="text-xs font-bold uppercase tracking-label text-primary">Candidate preferences</p><h1 class="mt-2 text-4xl font-light tracking-holographic">Shape your job radar.</h1><p class="mt-2 text-muted-foreground">These preferences help discovery and matching understand what you want next.</p></div>
        <input type="hidden" name="_token" value="{{ csrf_token('job_preferences_' ~ app.user.id) }}">
        <input name="target_title" value="{{ preferences.targetTitle }}" placeholder="Target title, e.g. Symfony Developer" class="h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm">
        <div class="grid gap-4 md:grid-cols-2">
            <input name="location" value="{{ preferences.location }}" placeholder="Preferred location" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            <select name="work_type" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm"><option value="">Any work type</option>{% for type in work_types %}<option value="{{ type.value }}" {{ preferences.workType == type ? 'selected' }}>{{ type|work_type_label }}</option>{% endfor %}</select>
            <input name="min_salary" value="{{ preferences.minSalary }}" type="number" min="0" placeholder="Minimum salary" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
        </div>
        <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Save preferences</button>
    </form>
</div>
{% endblock %}
