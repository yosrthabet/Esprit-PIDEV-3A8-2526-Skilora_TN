{% extends 'layouts/adaptive.html.twig' %}

{% block page_title %}CV Builder{% endblock %}

{% block content %}
<div class="mx-auto max-w-[90rem] px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[1fr_24rem]">
        <form method="post" enctype="multipart/form-data" class="glass-panel space-y-8 p-8">
            <input type="hidden" name="_token" value="{{ csrf_token('cv_builder') }}">

            <div class="space-y-3">
                <p class="text-xs font-bold uppercase tracking-label text-primary">Candidate CV</p>
                <h1 class="text-4xl font-light tracking-holographic">Build a professional CV</h1>
                <p class="max-w-3xl text-sm text-muted-foreground">Generate a private PDF CV you can download or save for future applications.</p>
                {% if saved_cv_relpath %}
                    <p class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-700">Saved generated CV: <span class="font-semibold">{{ saved_cv_relpath }}</span></p>
                {% endif %}
                {% if errors is not empty %}
                    <div class="rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-700">
                        <p class="font-semibold">Please fix these fields:</p>
                        <ul class="mt-2 space-y-1">
                            {% for error in errors %}<li>{{ error }}</li>{% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>

            <section class="space-y-4">
                <h2 class="text-xl font-semibold">Personal information</h2>
                <div class="grid gap-4 md:grid-cols-2">
                    <label class="block text-sm font-semibold">Full name
                        <input name="full_name" required value="{{ data.full_name }}" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                    </label>
                    <label class="block text-sm font-semibold">Professional title
                        <input name="professional_title" required value="{{ data.professional_title }}" placeholder="Symfony Developer" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                    </label>
                    <label class="block text-sm font-semibold">Email
                        <input type="email" name="email" required value="{{ data.email }}" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                    </label>
                    <label class="block text-sm font-semibold">Phone
                        <input name="phone" value="{{ data.phone }}" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                    </label>
                    <label class="block text-sm font-semibold md:col-span-2">Address
                        <textarea name="address" rows="2" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">{{ data.address }}</textarea>
                    </label>
                    <label class="block text-sm font-semibold md:col-span-2">Profile photo
                        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                        <span class="mt-1 block text-xs text-muted-foreground">Optional. JPEG, PNG or WebP. Max 2 MB.</span>
                    </label>
                </div>
                <label class="block text-sm font-semibold">Professional summary
                    <textarea name="professional_summary" required rows="6" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm" placeholder="Summarize your experience, strengths, and target roles.">{{ data.professional_summary }}</textarea>
                </label>
            </section>

            <section class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 class="text-xl font-semibold">Education</h2>
                    <button type="button" data-add-education class="rounded-xl border border-border px-4 py-2 text-sm font-semibold hover:bg-muted">Add education</button>
                </div>
                <div id="education-list" class="space-y-3" data-index="{{ data.education|length }}">
                    {% for entry in data.education %}
                        <div class="rounded-2xl border border-border/50 bg-background/60 p-4" data-entry>
                            <div class="grid gap-3 md:grid-cols-3">
                                <input name="education[{{ loop.index0 }}][degree]" value="{{ entry.degree }}" placeholder="Degree / training" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                                <input name="education[{{ loop.index0 }}][institution]" value="{{ entry.institution }}" placeholder="Institution" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                                <input name="education[{{ loop.index0 }}][year]" value="{{ entry.year }}" placeholder="Year" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                            </div>
                            <button type="button" data-remove-entry class="mt-3 text-xs font-bold text-red-600">Remove</button>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 class="text-xl font-semibold">Experience</h2>
                    <button type="button" data-add-experience class="rounded-xl border border-border px-4 py-2 text-sm font-semibold hover:bg-muted">Add experience</button>
                </div>
                <div id="experience-list" class="space-y-3" data-index="{{ data.experience|length }}">
                    {% for entry in data.experience %}
                        <div class="rounded-2xl border border-border/50 bg-background/60 p-4" data-entry>
                            <div class="grid gap-3 md:grid-cols-2">
                                <input name="experience[{{ loop.index0 }}][jobTitle]" value="{{ entry.jobTitle }}" placeholder="Job title" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                                <input name="experience[{{ loop.index0 }}][company]" value="{{ entry.company }}" placeholder="Company" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                                <input name="experience[{{ loop.index0 }}][duration]" value="{{ entry.duration }}" placeholder="Duration" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                                <textarea name="experience[{{ loop.index0 }}][description]" rows="3" placeholder="Description" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">{{ entry.description }}</textarea>
                            </div>
                            <button type="button" data-remove-entry class="mt-3 text-xs font-bold text-red-600">Remove</button>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="space-y-4">
                <h2 class="text-xl font-semibold">Skills and languages</h2>
                <label class="block text-sm font-semibold">Skills
                    <textarea name="skills" required rows="4" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm" placeholder="PHP, Symfony, MySQL, Git">{{ data.skills }}</textarea>
                    <span class="mt-1 block text-xs text-muted-foreground">Separate items with commas, semicolons, or new lines.</span>
                </label>
                <label class="block text-sm font-semibold">Languages
                    <textarea name="languages" rows="3" class="mt-2 w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm" placeholder="French native, English B2">{{ data.languages }}</textarea>
                </label>
                <div class="flex flex-wrap gap-4 text-sm font-semibold">
                    <label class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-3"><input type="radio" name="template" value="modern" {{ data.template != 'classic' ? 'checked' : '' }}> Modern</label>
                    <label class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-3"><input type="radio" name="template" value="classic" {{ data.template == 'classic' ? 'checked' : '' }}> Classic</label>
                </div>
            </section>

            <div class="flex flex-wrap justify-end gap-3">
                <button name="intent" value="download" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Download PDF</button>
                <button name="intent" value="save" class="rounded-xl border border-border px-5 py-3 text-sm font-bold hover:bg-muted">Save for applications</button>
            </div>
        </form>

        <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
            <div class="glass-panel p-5">
                <h2 class="font-semibold">Private by default</h2>
                <p class="mt-3 text-sm text-muted-foreground">Saved PDFs are written under the private CV upload directory and are only reusable through authenticated Recruitment flows.</p>
            </div>
            <a href="{{ path('app_jobs') }}" class="block rounded-xl border border-border px-4 py-3 text-center text-sm font-semibold hover:bg-muted">Browse jobs</a>
        </aside>
    </div>
</div>

<template id="education-template">
    <div class="rounded-2xl border border-border/50 bg-background/60 p-4" data-entry>
        <div class="grid gap-3 md:grid-cols-3">
            <input data-name="education[__index__][degree]" placeholder="Degree / training" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
            <input data-name="education[__index__][institution]" placeholder="Institution" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
            <input data-name="education[__index__][year]" placeholder="Year" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
        </div>
        <button type="button" data-remove-entry class="mt-3 text-xs font-bold text-red-600">Remove</button>
    </div>
</template>
<template id="experience-template">
    <div class="rounded-2xl border border-border/50 bg-background/60 p-4" data-entry>
        <div class="grid gap-3 md:grid-cols-2">
            <input data-name="experience[__index__][jobTitle]" placeholder="Job title" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
            <input data-name="experience[__index__][company]" placeholder="Company" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
            <input data-name="experience[__index__][duration]" placeholder="Duration" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
            <textarea data-name="experience[__index__][description]" rows="3" placeholder="Description" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm"></textarea>
        </div>
        <button type="button" data-remove-entry class="mt-3 text-xs font-bold text-red-600">Remove</button>
    </div>
</template>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const addEntry = (listId, templateId) => {
                const list = document.getElementById(listId);
                const template = document.getElementById(templateId);
                if (!list || !(template instanceof HTMLTemplateElement)) return;
                const index = Number.parseInt(list.dataset.index || '0', 10);
                const fragment = template.content.cloneNode(true);
                fragment.querySelectorAll('[data-name]').forEach((field) => {
                    field.setAttribute('name', field.getAttribute('data-name').replace('__index__', String(index)));
                    field.removeAttribute('data-name');
                });
                list.appendChild(fragment);
                list.dataset.index = String(index + 1);
            };

            document.querySelector('[data-add-education]')?.addEventListener('click', () => addEntry('education-list', 'education-template'));
            document.querySelector('[data-add-experience]')?.addEventListener('click', () => addEntry('experience-list', 'experience-template'));
            document.addEventListener('click', (event) => {
                const target = event.target;
                if (target instanceof HTMLElement && target.matches('[data-remove-entry]')) {
                    target.closest('[data-entry]')?.remove();
                }
            });
        })();
    </script>
{% endblock %}
