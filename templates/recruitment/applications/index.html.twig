{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Applications{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Pipeline</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">Your applications</h1>
        <p class="mt-2 text-muted-foreground">Track every opportunity from applied to interview to offer.</p>
    </div>
    <div class="grid gap-4 lg:grid-cols-3">
        {% for app_item in applications %}
            {% set job = app_item.jobOffer %}
            {% set interview = interviews_by_application[app_item.id]|default(null) %}
            {% set hire_offer = offers_by_application[app_item.id]|default(null) %}
            <article class="glass-panel p-5">
                <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ app_item.status.label }}</span>
                <h2 class="mt-3 text-lg font-semibold"><a href="{{ path('app_application_show', {id: app_item.id}) }}" class="hover:text-primary">{{ job.title }}</a></h2>
                <p class="mt-1 text-sm text-muted-foreground">{{ job.companyLabel }} · {{ app_item.appliedAt|date('M d, Y') }}</p>
                <div class="mt-4 h-2 overflow-hidden rounded-full bg-muted"><div class="h-full rounded-full bg-primary" style="width: {{ app_item.matchScore }}%"></div></div>
                <p class="mt-2 text-xs text-muted-foreground">{{ app_item.matchScore }}% application readiness</p>
                {% if interview %}
                    <div class="mt-4 rounded-xl border border-primary/20 bg-primary/5 p-3 text-xs text-muted-foreground">
                        <p class="font-semibold text-foreground">Interview: {{ interview.scheduledAt|date('M d, H:i') }}</p>
                        {% if interview.notes %}<p class="mt-1 line-clamp-2">{{ interview.notes }}</p>{% endif %}
                        {% if interview.meetingUrl %}<a href="{{ interview.meetingUrl }}" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex font-semibold text-primary">Open meeting link →</a>{% endif %}
                    </div>
                {% elseif hire_offer %}
                    <div class="mt-4 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3 text-xs text-muted-foreground">
                        <p class="font-semibold text-foreground">Hire offer: {{ hire_offer.status.value|title }}</p>
                        <a href="{{ path('app_hire_offers') }}" class="mt-2 inline-flex font-semibold text-primary">View offer →</a>
                    </div>
                {% endif %}
                <a href="{{ path('app_application_show', {id: app_item.id}) }}" class="mt-4 inline-flex text-xs font-semibold text-primary">View details →</a>
            </article>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No applications yet. Start from Find Work.</div>
        {% endfor %}
    </div>
</div>
{% endblock %}
