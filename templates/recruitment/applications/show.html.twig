{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Application{% endblock %}
{% block content %}
{% set is_employer = app.user.role == 'EMPLOYER' %}
{% set job = application.jobOffer %}

<div class="mx-auto max-w-[92rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="relative overflow-hidden rounded-[2rem] border border-border bg-card p-6 shadow-xl shadow-black/5 sm:p-8 lg:p-10">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-primary/10 blur-3xl"></div>
        <a href="{{ path('app_applications') }}" class="relative inline-flex items-center gap-2 text-sm font-bold text-muted-foreground hover:text-foreground"><i data-lucide="arrow-left" class="h-4 w-4"></i>Back to applications</a>
        <div class="relative mt-6 grid gap-8 lg:grid-cols-[1fr_26rem] lg:items-end">
            <div>
                <div class="flex flex-wrap items-center gap-2"><span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-black text-primary">{{ application.status.label }}</span><span class="text-xs font-semibold text-muted-foreground">{{ application.appliedAt|date('M d, Y H:i') }}</span></div>
                <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">{{ is_employer ? application.candidate.displayName : job.title }}</h1>
                <p class="mt-3 text-lg text-muted-foreground">{{ is_employer ? 'Applied to' : 'Application for' }} <a href="{{ path('app_job_show', {id: job.id}) }}" class="font-bold text-foreground hover:text-primary">{{ job.title }}</a></p>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ application.matchScore }}%</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Match</p></div>
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ interview ? 'Yes' : 'No' }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Interview</p></div>
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ hire_offer ? hire_offer.status.value|title : 'None' }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Offer</p></div>
            </div>
        </div>
    </section>

    {# ── Application Timeline ── #}
    <section class="glass-panel p-6">
        <h2 class="text-sm font-semibold text-foreground mb-4">Application timeline</h2>
        {% set steps = [
            {key: 'applied', icon: 'send', label: 'Applied'},
            {key: 'viewed', icon: 'eye', label: 'Viewed'},
            {key: 'interview', icon: 'video', label: 'Interview'},
            {key: 'offer', icon: 'gift', label: 'Offer'},
            {key: 'hired', icon: 'check-circle', label: 'Hired'}
        ] %}
        {% set statusMap = {applied: 0, viewed: 1, interview: 2, offer: 3, accepted: 4, hired: 4, rejected: -1} %}
        {% set currentStep = statusMap[application.status.value]|default(0) %}
        <div class="flex items-center justify-between">
            {% for step in steps %}
            <div class="flex flex-col items-center gap-1.5 text-center flex-1">
                <div class="flex h-10 w-10 items-center justify-center rounded-full transition
                    {% if application.status.value == 'rejected' and loop.index0 == 0 %}bg-rose-500/10 text-rose-500
                    {% elseif loop.index0 <= currentStep %}bg-primary text-primary-foreground
                    {% else %}bg-muted text-muted-foreground{% endif %}">
                    <i data-lucide="{{ step.icon }}" class="h-4 w-4"></i>
                </div>
                <span class="text-[10px] font-semibold
                    {% if loop.index0 <= currentStep %}text-foreground{% else %}text-muted-foreground{% endif %}">
                    {{ step.label }}
                </span>
            </div>
            {% if not loop.last %}
            <div class="h-px flex-1 mx-1 {{ loop.index0 < currentStep ? 'bg-primary' : 'bg-muted' }}"></div>
            {% endif %}
            {% endfor %}
        </div>
        {% if application.status.value == 'rejected' %}
        <div class="mt-4 flex items-center gap-2 rounded-xl bg-rose-500/5 border border-rose-500/20 px-3 py-2 text-xs text-rose-600 dark:text-rose-400">
            <i data-lucide="x-circle" class="h-3.5 w-3.5 shrink-0"></i> Application was rejected
        </div>
        {% endif %}
    </section>

    <div class="grid gap-6 lg:grid-cols-[1fr_24rem]">
        <article class="space-y-6">
            <section class="rounded-[1.75rem] border border-border bg-card p-6 shadow-sm">
                <h2 class="text-xl font-bold">Cover letter</h2>
                <p class="mt-4 whitespace-pre-line rounded-2xl border border-border/70 bg-background/70 p-5 leading-7 text-muted-foreground">{{ application.coverLetter ?: 'No cover note.' }}</p>
            </section>

            <section class="rounded-[1.75rem] border border-border bg-card p-6 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-xl font-bold">Candidate CV</h2>{% if application.cvPath %}<div class="flex gap-2"><a href="{{ path('app_application_cv', {id: application.id, inline: 1}) }}" target="_blank" class="rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Open CV</a><a href="{{ path('app_application_cv', {id: application.id}) }}" class="rounded-full border border-border px-4 py-2 text-sm font-bold hover:bg-muted">Download</a></div>{% endif %}</div>
                {% if not application.cvPath %}<p class="mt-4 rounded-2xl border border-dashed border-border bg-background/70 p-5 text-sm text-muted-foreground">No CV attached to this application.</p>{% endif %}
            </section>

            {% if interview %}
                <section class="rounded-[1.75rem] border border-primary/20 bg-primary/5 p-6 shadow-sm">
                    <h2 class="text-xl font-bold">Interview</h2>
                    <p class="mt-2 text-sm text-muted-foreground">{{ interview.scheduledAt|date('M d, Y H:i') }} · {{ interview.format.value|title }} · {{ interview.durationMinutes }} minutes</p>
                    {% if interview.notes %}<p class="mt-4 whitespace-pre-line text-sm leading-7 text-muted-foreground">{{ interview.notes }}</p>{% endif %}
                    {% if interview.location %}<p class="mt-2 text-sm text-muted-foreground">Location: {{ interview.location }}</p>{% endif %}
                    {% if interview.meetingUrl %}<a href="{{ interview.meetingUrl }}" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Open meeting link</a>{% endif %}
                </section>
            {% endif %}

            {% if hire_offer %}
                <section class="rounded-[1.75rem] border border-emerald-500/20 bg-emerald-500/5 p-6 shadow-sm">
                    <h2 class="text-xl font-bold">Hire offer</h2>
                    <p class="mt-2 text-sm text-muted-foreground">{{ hire_offer.salaryOffered ?: 'Negotiable' }} {{ hire_offer.currency.value }} · {{ hire_offer.contractType ?: 'Contract' }} · {{ hire_offer.status.value|title }}</p>
                    {% if not is_employer and hire_offer.status.value == 'pending' %}
                        <div class="mt-4 flex gap-2">
                            <form method="post" action="{{ path('app_hire_offer_accept', {id: hire_offer.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('accept_offer_' ~ hire_offer.id) }}"><button class="rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Accept offer</button></form>
                            <form method="post" action="{{ path('app_hire_offer_reject', {id: hire_offer.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('reject_offer_' ~ hire_offer.id) }}"><button class="rounded-full border border-border px-4 py-2 text-sm font-bold hover:bg-muted">Reject</button></form>
                        </div>
                    {% endif %}
                </section>
            {% endif %}
        </article>

        {% if is_employer %}
            <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
                <div class="rounded-[1.75rem] border border-border bg-card p-5 shadow-sm">
                    <h2 class="font-bold">Review actions</h2>
                    <div class="mt-4 grid gap-2">
                        {% for status in ['viewed', 'interview', 'rejected'] %}
                            <form method="post" action="{{ path('app_application_status', {id: application.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('application_status_' ~ application.id) }}">
                                <input type="hidden" name="status" value="{{ status }}">
                                <button class="w-full rounded-xl border border-border px-4 py-2 text-sm font-bold transition hover:bg-muted">Mark {{ status|title }}</button>
                            </form>
                        {% endfor %}
                    </div>
                </div>
                <a href="{{ path('app_application_interview', {id: application.id}) }}" class="block rounded-xl bg-primary px-4 py-3 text-center text-sm font-bold text-primary-foreground">Plan interview</a>
                <a href="{{ path('app_application_offer', {id: application.id}) }}" class="block rounded-xl border border-border px-4 py-3 text-center text-sm font-bold transition hover:bg-muted">Send hire offer</a>
            </aside>
        {% endif %}
    </div>
</div>
{% endblock %}
