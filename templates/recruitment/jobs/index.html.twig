{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Find Work{% endblock %}
{% block content %}
{% set source_labels = {all: 'All', aneti: 'ANETI', reddit: 'Reddit', rss: 'RSS'} %}
{% set base_query = app.request.query.all|merge({page: 1}) %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel relative overflow-hidden p-5 sm:p-7">
        <div class="absolute right-0 top-0 h-48 w-96 bg-[radial-gradient(circle,rgba(99,102,241,.16),transparent_70%)]"></div>
        <div class="relative flex flex-col gap-4">
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <p class="text-xs font-bold uppercase tracking-label text-primary">Opportunity Radar</p>
                    <span class="rounded-full bg-muted px-2.5 py-1 text-[11px] font-semibold text-muted-foreground">ANETI · Reddit · RSS</span>
                </div>
                <h1 class="mt-2 max-w-4xl text-4xl font-light tracking-holographic sm:text-5xl">Find work that actually fits.</h1>
                <p class="mt-3 max-w-3xl text-muted-foreground">Search by role, skill, source, or work style. Try <span class="font-medium text-foreground">React remote</span>, <span class="font-medium text-foreground">Symfony Tunis</span>, or <span class="font-medium text-foreground">Data analyst</span>.</p>
            </div>
        </div>

        <form class="relative mt-6 space-y-4" method="get" action="{{ path('app_jobs') }}">
            <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
                <div class="relative flex h-12 items-center rounded-2xl border border-border bg-background/75 transition-within focus-within:border-primary focus-within:ring-4 focus-within:ring-primary/10">
                    <div class="pointer-events-none flex h-full w-12 shrink-0 items-center justify-center text-muted-foreground">
                        <i data-lucide="search" class="h-5 w-5"></i>
                    </div>
                    <input name="q" value="{{ q }}" placeholder="React, Symfony, Tunis, remote..." class="h-full min-w-0 flex-1 rounded-2xl border-0 bg-transparent pr-4 text-base leading-none outline-none placeholder:text-muted-foreground focus:ring-0">
                </div>
                <button class="inline-flex h-12 min-w-36 items-center justify-center rounded-2xl bg-primary px-7 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary/90">
                    Search jobs
                </button>
            </div>

            <div class="grid gap-3 md:grid-cols-3">
                <select name="work_type" class="h-11 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <option value="all">All work types</option>
                    <option value="remote" {{ work_type == 'remote' ? 'selected' }}>Remote</option>
                    <option value="hybrid" {{ work_type == 'hybrid' ? 'selected' }}>Hybrid</option>
                    <option value="onsite" {{ work_type == 'onsite' ? 'selected' }}>On site</option>
                </select>
                <select name="source" class="h-11 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <option value="all">All sources</option>
                    <option value="aneti" {{ source == 'aneti' ? 'selected' }}>ANETI Tunisia</option>
                    <option value="reddit" {{ source == 'reddit' ? 'selected' }}>Reddit hiring</option>
                    <option value="rss" {{ source == 'rss' ? 'selected' }}>Curated RSS</option>
                </select>
                <select name="sort" class="h-11 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <option value="match" {{ sort == 'match' ? 'selected' }}>Best match</option>
                    <option value="fresh" {{ sort == 'fresh' ? 'selected' }}>Freshest</option>
                    <option value="salary" {{ sort == 'salary' ? 'selected' }}>Salary</option>
                </select>
            </div>
        </form>

        <div class="relative mt-5 flex flex-wrap gap-2">
            {% for label, chip_query in {
                'Fresh jobs': {sort: 'fresh'},
                'Remote only': {work_type: 'remote'},
                'ANETI Tunisia': {source: 'aneti'},
                'Reddit hiring': {source: 'reddit'},
                'Symfony': {q: 'Symfony'},
                'React': {q: 'React'}
            } %}
                <a href="{{ path('app_jobs', base_query|merge(chip_query)) }}" class="rounded-full border border-border bg-background/60 px-3 py-1.5 text-xs font-semibold text-muted-foreground transition hover:border-primary/40 hover:text-foreground">{{ label }}</a>
            {% endfor %}
        </div>
    </section>

    <section class="glass-panel p-4">
        <div class="flex flex-wrap items-center gap-2">
            {% for source_key, label in source_labels %}
                {% set active = source == source_key or (source_key == 'all' and source == 'all') %}
                {% set query = base_query|merge({source: source_key}) %}
                <a href="{{ path('app_jobs', query) }}" class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-bold transition {{ active ? 'bg-primary text-primary-foreground' : 'bg-muted text-muted-foreground hover:text-foreground' }}">
                    {{ label }}
                    <span class="rounded-full bg-background/30 px-1.5 py-0.5 text-[10px]">{{ source_counts[source_key]|default(0) }}</span>
                </a>
            {% endfor %}
        </div>
    </section>

    <div class="flex items-center justify-between">
        <p class="text-sm text-muted-foreground"><strong class="text-foreground">{{ total }}</strong> jobs found</p>
        <p class="text-xs text-muted-foreground">Page {{ page }} / {{ page_count }}</p>
    </div>

    <section class="grid gap-4 lg:grid-cols-2">
        {% for item in match_cards %}
            {% include 'recruitment/jobs/_card.html.twig' with {item: item} %}
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No jobs match that search yet. Try broader keywords or clear source filters.</div>
        {% endfor %}
    </section>

    {% if page_count > 1 %}
        <nav class="flex justify-center gap-3">
            <a class="rounded-full border border-border px-4 py-2 text-sm {{ page <= 1 ? 'pointer-events-none opacity-40' }}" href="{{ path('app_jobs', app.request.query.all|merge({page: page - 1})) }}">Previous</a>
            <a class="rounded-full border border-border px-4 py-2 text-sm {{ page >= page_count ? 'pointer-events-none opacity-40' }}" href="{{ path('app_jobs', app.request.query.all|merge({page: page + 1})) }}">Next</a>
        </nav>
    {% endif %}
</div>
{% endblock %}
