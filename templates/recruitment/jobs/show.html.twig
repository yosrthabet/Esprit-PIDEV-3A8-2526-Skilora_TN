{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ job.title }}{% endblock %}
{% block content %}
{% set clean_description = job.description|clean_job_description %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <a href="{{ path('app_jobs', app.request.query.all) }}" class="inline-flex items-center gap-2 rounded-full border border-border bg-background/70 px-4 py-2 text-sm font-semibold text-muted-foreground transition hover:text-foreground hover:bg-muted">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            Back to job radar
        </a>
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
            <span>{{ job.viewsCount }} views</span>
            <span>•</span>
            <span>{{ job.applicationsCount }} applications</span>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1fr_25rem]">
        <article class="glass-panel overflow-hidden p-0">
            <header class="relative border-b border-border/50 p-8">
                <div class="absolute right-0 top-0 h-56 w-96 bg-[radial-gradient(circle,rgba(99,102,241,.16),transparent_70%)]"></div>
                <div class="relative">
                    <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                        <span class="rounded-full bg-primary/10 px-3 py-1 font-bold text-primary">{{ match.score }}% {{ match.confidence|default('match') }}</span>
                        <span>{{ job.companyLabel }}</span>
                        {% if job.location %}<span>• {{ job.location }}</span>{% endif %}
                        {% if job.feedSource %}<span class="rounded-full border border-border px-2.5 py-1">{{ job.feedSource.value|replace({'_': ' '})|title }}</span>{% endif %}
                    </div>
                    <h1 class="mt-4 max-w-5xl text-3xl font-semibold tracking-tight text-foreground sm:text-5xl">{{ job.title }}</h1>
                    <div class="mt-5 flex flex-wrap gap-2 text-xs">
                        {% if job.workType %}<span class="rounded-lg bg-muted px-3 py-1.5">{{ job.workType|work_type_label }}</span>{% endif %}
                        {% if job.experienceLevel %}<span class="rounded-lg bg-muted px-3 py-1.5">{{ job.experienceLevel.labelFr }}</span>{% endif %}
                        {% if job.maxSalary %}<span class="rounded-lg bg-emerald-500/10 px-3 py-1.5 text-emerald-600">{{ job.minSalary ?: 'Up to' }} - {{ job.maxSalary }} {{ job.currency.value }}</span>{% endif %}
                        <span class="rounded-lg bg-muted px-3 py-1.5">Posted {{ job.postedAt|date('M d, Y') }}</span>
                    </div>
                </div>
            </header>

            <section class="space-y-8 p-8">
                <div>
                    <h2 class="text-xl font-semibold">About the job</h2>
                    <div class="mt-4 whitespace-pre-line text-base leading-8 text-muted-foreground">{{ clean_description ?: 'No description provided.' }}</div>
                </div>
                {% if job.requirements %}
                    <div>
                        <h2 class="text-xl font-semibold">Requirements</h2>
                        <p class="mt-4 whitespace-pre-line leading-8 text-muted-foreground">{{ job.requirements }}</p>
                    </div>
                {% endif %}
            </section>
        </article>

        <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
            <div class="glass-panel p-5">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="font-semibold">Match insight</h2>
                    <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">{{ match.score }}%</span>
                </div>
                <p class="mt-2 text-xs text-muted-foreground">Scores use your current profile skills plus job metadata. Low-confidence scores mean your profile needs more skills before the number is truly reliable.</p>
                <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
                    {% for reason in match.reasons %}
                        <li class="flex gap-2"><span class="text-primary">•</span>{{ reason }}</li>
                    {% endfor %}
                </ul>
            </div>

            {% if job.isExternal and job.feedUrl %}
                <a href="{{ job.feedUrl }}" target="_blank" rel="noopener noreferrer" class="block rounded-xl bg-primary px-4 py-3 text-center text-sm font-bold text-primary-foreground">Apply on source site</a>
                <p class="text-center text-xs text-muted-foreground">External listing imported from {{ job.feedSource.value|replace({'_': ' '})|title }}.</p>
            {% elseif app.user.role != 'EMPLOYER' %}
                {% if has_applied %}
                    <div class="glass-panel p-5 text-center text-sm font-bold text-muted-foreground">Already applied</div>
                {% else %}
                    <a href="{{ path('app_job_apply', {id: job.id}) }}" class="block rounded-xl bg-primary px-4 py-3 text-center text-sm font-bold text-primary-foreground">Apply with CV</a>
                    <a href="{{ path('app_candidate_job_preferences') }}" class="block rounded-xl border border-border px-4 py-3 text-center text-sm font-semibold hover:bg-muted">Update job preferences</a>
                {% endif %}
            {% endif %}

            {% if app.user.role != 'EMPLOYER' %}
                <form method="post" action="{{ path('app_job_save', {id: job.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('save_job_' ~ job.id) }}">
                    <button class="w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm font-semibold transition hover:bg-muted">{{ is_saved ? 'Saved' : 'Save job' }}</button>
                </form>
            {% endif %}
        </aside>
    </div>
</div>
{% endblock %}
