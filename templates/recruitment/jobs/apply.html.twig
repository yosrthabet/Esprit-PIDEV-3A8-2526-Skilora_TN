{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Apply · {{ job.title }}{% endblock %}
{% block content %}
<div class="mx-auto grid max-w-[90rem] gap-6 px-4 py-6 lg:grid-cols-[1fr_24rem] sm:px-6 lg:px-8">
    <form method="post" enctype="multipart/form-data" class="glass-panel space-y-5 p-8">
        <a href="{{ path('app_job_show', {id: job.id}) }}" class="inline-flex text-sm font-semibold text-muted-foreground hover:text-foreground">Back to job</a>
        <div><p class="text-xs font-bold uppercase tracking-label text-primary">Application</p><h1 class="mt-2 text-4xl font-light tracking-holographic">{{ job.title }}</h1><p class="mt-2 text-muted-foreground">{{ job.companyLabel }}</p></div>
        {% if has_applied %}
            <div class="rounded-2xl border border-border bg-muted p-5 text-sm text-muted-foreground">You already applied to this job.</div>
        {% else %}
            {% set has_generated_cv = saved_cv_relpath is defined and saved_cv_relpath is not empty %}
            <input type="hidden" name="_token" value="{{ csrf_token('apply_job_' ~ job.id) }}">
            {% if has_generated_cv %}
                <label class="flex gap-3 rounded-2xl border border-primary/30 bg-primary/5 p-4 text-sm">
                    <input type="checkbox" name="use_generated_cv" value="1" class="mt-1 rounded border-border">
                    <span><span class="font-semibold text-foreground">Use generated CV</span><span class="mt-1 block text-xs text-muted-foreground">Use the private PDF saved from the CV builder: {{ saved_cv_relpath }}</span></span>
                </label>
            {% endif %}
            <div><label class="text-sm font-semibold">CV file</label><input type="file" name="cv" {{ has_generated_cv ? '' : 'required' }} accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/*" class="mt-2 block w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm"><p class="mt-1 text-xs text-muted-foreground">PDF, Word, JPG, PNG or WebP. Max 5 MB.{% if has_generated_cv %} Leave empty if using your generated CV.{% endif %}</p></div>
            <div><label class="text-sm font-semibold">Cover letter</label><textarea name="cover_letter" rows="8" class="mt-2 w-full rounded-xl border border-border bg-background/70 p-3 text-sm" placeholder="Tell the employer why you're a strong fit..."></textarea></div>
            <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Send application</button>
        {% endif %}
    </form>
    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <div class="glass-panel p-5"><h2 class="font-semibold">Match insight</h2><p class="mt-3 text-3xl font-light">{{ match.score }}%</p><ul class="mt-4 space-y-2 text-sm text-muted-foreground">{% for reason in match.reasons %}<li>• {{ reason }}</li>{% endfor %}</ul></div>
        <a href="{{ path('app_candidate_job_preferences') }}" class="block rounded-xl border border-border px-4 py-3 text-center text-sm font-semibold hover:bg-muted">Tune job preferences</a>
    </aside>
</div>
{% endblock %}
