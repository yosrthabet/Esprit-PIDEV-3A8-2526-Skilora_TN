{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Apply · {{ job.title }}{% endblock %}
{% block content %}
<div class="mx-auto grid max-w-[90rem] gap-6 px-4 py-6 lg:grid-cols-[1fr_24rem] sm:px-6 lg:px-8" x-data="applyPage()">
    <form method="post" enctype="multipart/form-data" class="glass-panel space-y-5 p-8">
        <a href="{{ path('app_job_show', {id: job.id}) }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-muted-foreground hover:text-foreground"><i data-lucide="arrow-left" class="h-3.5 w-3.5"></i> Back to job</a>
        <div><p class="text-xs font-bold uppercase tracking-label text-primary">Application</p><h1 class="mt-2 text-4xl font-light tracking-holographic">{{ job.title }}</h1><p class="mt-2 text-muted-foreground">{{ job.companyLabel }}</p></div>
        {% if has_applied %}
            <div class="rounded-2xl border border-border bg-muted p-5 text-sm text-muted-foreground">You already applied to this job.</div>
        {% else %}
            {% set has_generated_cv = saved_cv_relpath is defined and saved_cv_relpath is not empty %}
            <input type="hidden" name="_token" value="{{ csrf_token('apply_job_' ~ job.id) }}">
            {% if has_generated_cv %}
                <label class="flex gap-3 rounded-2xl border border-primary/30 bg-primary/5 p-4 text-sm">
                    <input type="checkbox" name="use_generated_cv" value="1" class="mt-1 rounded border-border">
                    <span><span class="font-semibold text-foreground">Use generated CV</span><span class="mt-1 block text-xs text-muted-foreground">Use the private PDF saved from the CV builder: {{ saved_cv_relpath }}</span></span>
                </label>
            {% endif %}
            <div>
                <label class="text-sm font-semibold">CV file</label>
                <input type="file" name="cv" x-ref="cvFile" {{ has_generated_cv ? '' : 'required' }} accept=".pdf,.doc,.docx,.txt,.jpg,.jpeg,.png,.webp" class="mt-2 block w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm">
                <p class="mt-1 text-xs text-muted-foreground">PDF, Word, TXT or image. Max 5 MB.{% if has_generated_cv %} Leave empty if using your generated CV.{% endif %}</p>
            </div>

            {# ── AI CV Analysis ── #}
            <div class="rounded-2xl border border-primary/20 bg-primary/5 p-5 space-y-3">
                <div class="flex items-center gap-2">
                    <i data-lucide="sparkles" class="h-4 w-4 text-primary"></i>
                    <h3 class="text-sm font-bold">AI Career Coach</h3>
                    <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary">Beta</span>
                </div>
                <p class="text-xs text-muted-foreground">Upload your CV above, then click "Analyze" to get personalized feedback on how well you match this job, cover letter tips, and interview prep.</p>
                <button type="button" @click="analyzeCv()" :disabled="analyzing" class="rounded-full bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-sm transition hover:shadow-md disabled:opacity-50">
                    <span x-show="!analyzing" class="flex items-center gap-1.5"><i data-lucide="brain" class="h-3.5 w-3.5"></i> Analyze my CV for this job</span>
                    <span x-show="analyzing" class="flex items-center gap-1.5"><i data-lucide="loader-2" class="h-3.5 w-3.5 animate-spin"></i> Analyzing…</span>
                </button>

                <div x-show="analysis" x-transition class="space-y-4 mt-3">
                    {# Fit Score #}
                    <div class="flex items-center gap-3">
                        <div class="relative h-16 w-16 shrink-0">
                            <svg viewBox="0 0 36 36" class="h-16 w-16 -rotate-90">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="currentColor" stroke-width="2.5" class="text-muted/30"></circle>
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary" :stroke-dasharray="(analysis.fit_score || 0) + ', 100'"></circle>
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-sm font-black" x-text="(analysis.fit_score || 0) + '%'"></span>
                        </div>
                        <div>
                            <p class="text-sm font-bold">Job Fit Score</p>
                            <p class="text-xs text-muted-foreground" x-text="analysis.application_advice || ''"></p>
                        </div>
                    </div>

                    {# Matching Skills #}
                    <template x-if="analysis.matching_skills && analysis.matching_skills.length">
                        <div>
                            <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider">Matching Skills</p>
                            <div class="mt-1.5 flex flex-wrap gap-1.5">
                                <template x-for="s in analysis.matching_skills" :key="s">
                                    <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-600" x-text="s"></span>
                                </template>
                            </div>
                        </div>
                    </template>

                    {# Missing Skills #}
                    <template x-if="analysis.missing_skills && analysis.missing_skills.length">
                        <div>
                            <p class="text-xs font-bold text-amber-600 uppercase tracking-wider">Skills to Develop</p>
                            <div class="mt-1.5 flex flex-wrap gap-1.5">
                                <template x-for="s in analysis.missing_skills" :key="s">
                                    <span class="rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold text-amber-600" x-text="s"></span>
                                </template>
                            </div>
                        </div>
                    </template>

                    {# Cover Letter Tips #}
                    <template x-if="analysis.cover_letter_tips && analysis.cover_letter_tips.length">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-wider"><i data-lucide="pen-line" class="mr-1 inline h-3 w-3"></i> Cover Letter Tips</p>
                            <ul class="mt-1.5 space-y-1 text-xs text-muted-foreground">
                                <template x-for="tip in analysis.cover_letter_tips" :key="tip">
                                    <li class="flex gap-1.5"><span class="text-primary">→</span><span x-text="tip"></span></li>
                                </template>
                            </ul>
                        </div>
                    </template>

                    {# Interview Prep #}
                    <template x-if="analysis.interview_prep && analysis.interview_prep.length">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-wider"><i data-lucide="message-square" class="mr-1 inline h-3 w-3"></i> Likely Interview Questions</p>
                            <ul class="mt-1.5 space-y-1 text-xs text-muted-foreground">
                                <template x-for="q in analysis.interview_prep" :key="q">
                                    <li class="flex gap-1.5"><span class="text-primary font-bold">Q:</span><span x-text="q"></span></li>
                                </template>
                            </ul>
                        </div>
                    </template>

                    {# Profile Improvements #}
                    <template x-if="analysis.profile_improvements && analysis.profile_improvements.length">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-wider"><i data-lucide="user-cog" class="mr-1 inline h-3 w-3"></i> Profile Improvements</p>
                            <ul class="mt-1.5 space-y-1 text-xs text-muted-foreground">
                                <template x-for="imp in analysis.profile_improvements" :key="imp">
                                    <li class="flex gap-1.5"><span class="text-primary">•</span><span x-text="imp"></span></li>
                                </template>
                            </ul>
                        </div>
                    </template>
                </div>

                <p x-show="analysisError" class="text-xs text-red-500" x-text="analysisError"></p>
            </div>

            <div>
                <label class="text-sm font-semibold">Cover letter</label>
                <textarea name="cover_letter" rows="8" class="mt-2 w-full rounded-xl border border-border bg-background/70 p-3 text-sm" placeholder="Tell the employer why you're a strong fit..."></textarea>
            </div>
            <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Send application</button>
        {% endif %}
    </form>
    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <div class="glass-panel p-5"><h2 class="font-semibold">Match insight</h2><p class="mt-3 text-3xl font-light">{{ match.score }}%</p><ul class="mt-4 space-y-2 text-sm text-muted-foreground">{% for reason in match.reasons %}<li>• {{ reason }}</li>{% endfor %}</ul></div>
        <a href="{{ path('app_candidate_cv_builder') }}" class="block rounded-xl border border-primary/30 bg-primary/5 px-4 py-3 text-center text-sm font-semibold text-primary hover:bg-primary/10 transition"><i data-lucide="file-text" class="mr-1.5 inline h-3.5 w-3.5"></i> Build your CV</a>
        <a href="{{ path('app_candidate_job_preferences') }}" class="block rounded-xl border border-border px-4 py-3 text-center text-sm font-semibold hover:bg-muted">Tune job preferences</a>
    </aside>
</div>
<script>
function applyPage() {
    return {
        analyzing: false, analysis: null, analysisError: '',
        async analyzeCv() {
            const fileInput = this.$refs.cvFile;
            if (!fileInput || !fileInput.files.length) {
                this.analysisError = 'Please select a CV file first.';
                return;
            }
            this.analyzing = true;
            this.analysis = null;
            this.analysisError = '';
            try {
                const fd = new FormData();
                fd.append('cv', fileInput.files[0]);
                const res = await fetch('{{ path("app_job_ai_cv_analysis", {id: job.id}) }}', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.error) {
                    this.analysisError = data.error;
                } else {
                    this.analysis = data;
                }
            } catch (e) {
                this.analysisError = 'Could not reach AI service. Try again.';
            }
            this.analyzing = false;
        }
    };
}
</script>
{% endblock %}
