{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Hire Offers{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8"><p class="text-xs font-bold uppercase tracking-label text-primary">Offer desk</p><h1 class="mt-2 text-4xl font-light tracking-holographic">Hire offers</h1></section>
    <section class="grid gap-4 lg:grid-cols-2">
        {% for offer in offers %}
            <article class="glass-panel p-5"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ offer.status.value|title }}</span><h2 class="mt-3 text-xl font-semibold">{{ offer.application.jobOffer.title }}</h2><p class="mt-1 text-sm text-muted-foreground">{{ offer.salaryOffered ?: 'Negotiable' }} {{ offer.currency.value }} · {{ offer.contractType ?: 'Contract' }}</p>{% if offer.status.value == 'pending' %}<div class="mt-4 flex gap-2"><form method="post" action="{{ path('app_hire_offer_accept', {id: offer.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('accept_offer_' ~ offer.id) }}"><button class="rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Accept</button></form><form method="post" action="{{ path('app_hire_offer_reject', {id: offer.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('reject_offer_' ~ offer.id) }}"><button class="rounded-xl border border-border px-4 py-2 text-sm font-semibold">Reject</button></form></div>{% elseif offer.status.value == 'accepted' %}<a href="{{ path('app_contracts') }}" class="mt-4 inline-flex rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Open contracts</a>{% endif %}</article>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No hire offers yet.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
