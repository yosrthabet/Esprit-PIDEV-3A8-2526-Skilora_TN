{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Admin · {{ job.title }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-[92rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="relative overflow-hidden rounded-[2rem] border border-border bg-card p-6 shadow-xl shadow-black/5 sm:p-8 lg:p-10">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-primary/10 blur-3xl"></div>
        <a href="{{ path('app_admin_recruitment') }}" class="relative inline-flex items-center gap-2 text-sm font-bold text-muted-foreground hover:text-foreground"><i data-lucide="arrow-left" class="h-4 w-4"></i>Back to recruitment</a>
        <div class="relative mt-6 grid gap-8 lg:grid-cols-[1fr_26rem] lg:items-end">
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    {% set st_color = job.status.value == 'open' ? 'emerald' : (job.status.value == 'filled' ? 'indigo' : (job.status.value == 'closed' ? 'rose' : 'amber')) %}
                    <span class="rounded-full bg-{{ st_color }}-500/10 px-3 py-1 text-xs font-black text-{{ st_color }}-600">{{ job.status.value|title }}</span>
                    {% if job.featured %}<span class="rounded-full bg-amber-500/10 px-3 py-1 text-xs font-black text-amber-600">Featured</span>{% endif %}
                    {% if job.external %}<span class="rounded-full bg-muted px-3 py-1 text-xs font-black text-muted-foreground">{{ job.feedSource.value|title }}</span>{% endif %}
                </div>
                <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">{{ job.title }}</h1>
                <p class="mt-3 text-lg text-muted-foreground">{{ job.companyLabel }} · {{ job.location ?: 'Remote' }}</p>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ job.applicationsCount }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Apps</p></div>
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ job.viewsCount }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Views</p></div>
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ job.sourceQuality }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.2em] text-muted-foreground">Quality</p></div>
            </div>
        </div>
    </section>

    <div class="grid gap-6 lg:grid-cols-[1fr_20rem]">
        <div class="space-y-6">
            <section class="rounded-[1.75rem] border border-border bg-card p-6 shadow-sm">
                <h2 class="text-xl font-bold">Details</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <div><p class="text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">Work type</p><p class="mt-1 font-bold">{{ job.workType ? job.workType.value|title : 'N/A' }}</p></div>
                    <div><p class="text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">Experience</p><p class="mt-1 font-bold">{{ job.experienceLevel ? job.experienceLevel.value|title : 'N/A' }}</p></div>
                    <div><p class="text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">Salary</p><p class="mt-1 font-bold">{{ job.minSalary ? job.minSalary ~ ' - ' ~ job.maxSalary ~ ' ' ~ job.currency.value : 'Negotiable' }}</p></div>
                    <div><p class="text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">Posted</p><p class="mt-1 font-bold">{{ job.postedAt|date('M d, Y H:i') }}</p></div>
                    <div><p class="text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">Updated</p><p class="mt-1 font-bold">{{ job.updatedAt|date('M d, Y H:i') }}</p></div>
                    {% if job.expiresAt %}<div><p class="text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">Expires</p><p class="mt-1 font-bold">{{ job.expiresAt|date('M d, Y') }}</p></div>{% endif %}
                </div>
            </section>

            {% if job.description %}
                <section class="rounded-[1.75rem] border border-border bg-card p-6 shadow-sm">
                    <h2 class="text-xl font-bold">Description</h2>
                    <div class="prose prose-sm mt-4 max-w-none text-muted-foreground">{{ job.description|clean_job_description|nl2br }}</div>
                </section>
            {% endif %}

            {% if job.skillsRequired %}
                <section class="rounded-[1.75rem] border border-border bg-card p-6 shadow-sm">
                    <h2 class="text-xl font-bold">Skills required</h2>
                    <div class="mt-4 flex flex-wrap gap-2">
                        {% for skill in job.skillsRequired|split(',') %}
                            <span class="rounded-full bg-muted px-3 py-1 text-xs font-bold">{{ skill|trim }}</span>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            <section class="rounded-[1.75rem] border border-border bg-card p-6 shadow-sm">
                <h2 class="text-xl font-bold">Applications ({{ applications|length }})</h2>
                {% if applications|length > 0 %}
                    <div class="mt-4 overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-muted/40 text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
                                <tr><th class="px-4 py-3">Candidate</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Match</th><th class="px-4 py-3">Applied</th><th class="px-4 py-3 text-right">Profile</th></tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                {% for app_item in applications %}
                                    <tr class="transition hover:bg-muted/30">
                                        <td class="px-4 py-3 font-bold">{{ app_item.candidate.displayName }}</td>
                                        <td class="px-4 py-3"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-black text-primary">{{ app_item.status.label }}</span></td>
                                        <td class="px-4 py-3 tabular-nums">{{ app_item.matchScore }}%</td>
                                        <td class="px-4 py-3 text-xs text-muted-foreground">{{ app_item.appliedAt|date('M d, Y') }}</td>
                                        <td class="px-4 py-3 text-right"><a href="{{ path('app_application_profile', {id: app_item.id}) }}" class="rounded-xl border border-border px-3 py-2 text-xs font-bold hover:bg-muted">View</a></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="mt-4 text-sm text-muted-foreground">No applications yet.</p>
                {% endif %}
            </section>
        </div>

        <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
            <div class="rounded-[1.75rem] border border-border bg-card p-5 shadow-sm">
                <h2 class="font-bold">Admin actions</h2>
                <div class="mt-4 grid gap-2">
                    {% for st in ['open', 'closed', 'draft', 'expired'] %}
                        {% if st != job.status.value %}
                            <form method="post" action="{{ path('app_admin_recruitment_status', {id: job.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_job_status_' ~ job.id) }}">
                                <input type="hidden" name="status" value="{{ st }}">
                                <button class="w-full rounded-xl border border-border px-4 py-2 text-sm font-bold transition hover:bg-muted">Set {{ st|title }}</button>
                            </form>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div class="rounded-[1.75rem] border border-border bg-card p-5 shadow-sm">
                <h2 class="font-bold">Visibility</h2>
                <form method="post" action="{{ path('app_admin_recruitment_toggle_featured', {id: job.id}) }}" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_job_feature_' ~ job.id) }}">
                    <button class="w-full rounded-xl border border-border px-4 py-2 text-sm font-bold transition hover:bg-muted">{{ job.featured ? 'Remove from featured' : 'Mark as featured' }}</button>
                </form>
            </div>
            <div class="rounded-[1.75rem] border border-destructive/30 bg-card p-5 shadow-sm">
                <h2 class="font-bold text-destructive">Danger zone</h2>
                <form method="post" action="{{ path('app_admin_recruitment_delete', {id: job.id}) }}" data-confirm="Delete this job offer permanently?" data-confirm-label="Delete" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_job_delete_' ~ job.id) }}">
                    <button class="w-full rounded-xl border border-destructive/50 px-4 py-2 text-sm font-bold text-destructive transition hover:bg-destructive/10">Delete permanently</button>
                </form>
            </div>
            <a href="{{ path('app_job_show', {id: job.id}) }}" class="block rounded-xl border border-border px-4 py-3 text-center text-sm font-bold transition hover:bg-muted">View public page</a>
        </aside>
    </div>
</div>
{% endblock %}
