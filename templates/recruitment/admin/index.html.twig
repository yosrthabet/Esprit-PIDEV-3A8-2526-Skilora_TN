{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Admin Recruitment{% endblock %}
{% block content %}
<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="relative overflow-hidden rounded-[2rem] border border-border bg-card p-6 shadow-xl shadow-black/5 sm:p-8 lg:p-10">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-primary/10 blur-3xl"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-6">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.3em] text-primary">Admin recruitment</p>
                <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">Job offers</h1>
                <p class="mt-3 max-w-2xl text-muted-foreground">Review, moderate, and manage all job listings on the platform.</p>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ total }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Total offers</p></div>
                {% for st in statuses %}
                    <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ status_counts[st.value]|default(0) }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">{{ st.value|title }}</p></div>
                {% endfor %}
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ total_applications }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Applications</p></div>
                <div class="rounded-3xl border border-border bg-background/70 p-4"><p class="text-3xl font-light">{{ total_companies }}</p><p class="mt-1 text-[11px] font-black uppercase tracking-[0.18em] text-muted-foreground">Companies</p></div>
            </div>
        </div>
    </section>

    <section class="rounded-[1.75rem] border border-border bg-card p-5 shadow-sm">
        <form method="get" action="{{ path('app_admin_recruitment') }}" class="grid gap-3 lg:grid-cols-[1fr_180px_auto_auto]">
            <input name="q" value="{{ q }}" placeholder="Search title, company, location" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            <select name="status" class="h-11 rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="all">All statuses</option>
                {% for st in statuses %}<option value="{{ st.value }}" {{ status == st.value ? 'selected' }}>{{ st.value|title }}</option>{% endfor %}
            </select>
            <button class="rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground">Filter</button>
            <a href="{{ path('app_admin_recruitment') }}" class="inline-flex h-11 items-center justify-center rounded-xl border border-border px-5 text-sm font-bold hover:bg-muted">Reset</a>
        </form>
    </section>

    <section class="rounded-[1.75rem] border border-border bg-card shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-5">
            <div><h2 class="text-xl font-bold">Job offers</h2><p class="text-sm text-muted-foreground">{{ total }} results · page {{ page }} / {{ page_count }}</p></div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[860px] text-left text-sm">
                <thead class="bg-muted/40 text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
                    <tr>
                        <th class="px-5 py-4">Job</th>
                        <th class="px-5 py-4">Company</th>
                        <th class="px-5 py-4">Status</th>
                        <th class="px-5 py-4">Apps</th>
                        <th class="px-5 py-4">Views</th>
                        <th class="px-5 py-4">Posted</th>
                        <th class="px-5 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    {% for job in jobs %}
                        <tr class="transition hover:bg-muted/30">
                            <td class="px-5 py-4">
                                <a href="{{ path('app_admin_recruitment_show', {id: job.id}) }}" class="font-bold hover:text-primary">{{ job.title }}</a>
                                {% if job.featured %}<span class="ml-1 rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-black text-amber-600">Featured</span>{% endif %}
                                <p class="mt-1 text-xs text-muted-foreground">{{ job.location ?: 'Remote' }} · {{ job.workType ? job.workType.value|title : 'N/A' }}</p>
                            </td>
                            <td class="px-5 py-4 text-sm text-muted-foreground">{{ job.companyLabel }}</td>
                            <td class="px-5 py-4">
                                {% set st_color = job.status.value == 'open' ? 'emerald' : (job.status.value == 'filled' ? 'indigo' : (job.status.value == 'closed' ? 'rose' : 'amber')) %}
                                <span class="rounded-full bg-{{ st_color }}-500/10 px-2.5 py-1 text-xs font-black text-{{ st_color }}-600">{{ job.status.value|title }}</span>
                            </td>
                            <td class="px-5 py-4 tabular-nums">{{ job.applicationsCount }}</td>
                            <td class="px-5 py-4 tabular-nums text-muted-foreground">{{ job.viewsCount }}</td>
                            <td class="px-5 py-4 text-xs text-muted-foreground">{{ job.postedAt|date('M d, Y') }}</td>
                            <td class="px-5 py-4 text-right">
                                <a href="{{ path('app_admin_recruitment_show', {id: job.id}) }}" class="rounded-xl border border-border px-3 py-2 text-xs font-bold hover:bg-muted">View</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="px-5 py-16 text-center text-muted-foreground">No job offers match those filters.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {% if page_count > 1 %}
        <nav class="flex justify-center gap-3">
            <a class="rounded-full border border-border px-4 py-2 text-sm {{ page <= 1 ? 'pointer-events-none opacity-40' }}" href="{{ path('app_admin_recruitment', {q: q, status: status, page: page - 1}) }}">Previous</a>
            <a class="rounded-full border border-border px-4 py-2 text-sm {{ page >= page_count ? 'pointer-events-none opacity-40' }}" href="{{ path('app_admin_recruitment', {q: q, status: status, page: page + 1}) }}">Next</a>
        </nav>
    {% endif %}
</div>
{% endblock %}
