{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Candidates{% endblock %}
{% block content %}
{% set columns = {
    applied: 'Applied',
    viewed: 'Viewed',
    interview: 'Interview',
    offer: 'Offer',
    rejected: 'Rejected'
} %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Candidate Pipeline</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">Applications to review</h1>
        <p class="mt-2 text-sm text-muted-foreground">Move candidates from applied to interview to offer.</p>
    </section>
    <section class="grid gap-4 xl:grid-cols-5">
        {% for status, label in columns %}
            <div class="glass-panel min-h-60 p-4">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-sm font-bold uppercase tracking-label">{{ label }}</h2>
                    <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-bold">{{ applications|filter(a => a.status.value == status)|length }}</span>
                </div>
                <div class="space-y-3">
                    {% for app_item in applications|filter(a => a.status.value == status) %}
                        <a href="{{ path('app_application_profile', {id: app_item.id}) }}" class="block rounded-2xl border border-border/50 bg-background/60 p-4 transition hover:border-primary/40">
                            <p class="font-semibold">{{ app_item.candidate.displayName }}</p>
                            <p class="mt-1 line-clamp-1 text-xs text-muted-foreground">{{ app_item.jobOffer.title }}</p>
                            <p class="mt-3 text-xs text-muted-foreground">{{ app_item.matchScore }}% match · {{ app_item.appliedAt|date('M d') }}</p>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
