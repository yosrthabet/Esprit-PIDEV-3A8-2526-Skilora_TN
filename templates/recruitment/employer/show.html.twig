{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ job.title }}{% endblock %}
{% block content %}
{% set readiness = job.readiness %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-between gap-3"><a href="{{ path('app_active_offers') }}" class="inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 text-sm font-semibold text-muted-foreground hover:text-foreground"><i data-lucide="arrow-left" class="h-4 w-4"></i>Back to offers</a><div class="flex flex-wrap gap-2"><a href="{{ path('app_employer_offer_edit', {id: job.id}) }}" class="rounded-xl border border-border px-4 py-2 text-sm font-semibold hover:bg-muted">Edit</a><form method="post" action="{{ path('app_employer_offer_duplicate', {id: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('duplicate_job_' ~ job.id) }}"><button class="rounded-xl border border-border px-4 py-2 text-sm font-semibold hover:bg-muted">Duplicate</button></form><form method="post" action="{{ path('app_employer_offer_delete', {id: job.id}) }}" onsubmit="return confirm('Delete this offer?');"><input type="hidden" name="_token" value="{{ csrf_token('delete_job_' ~ job.id) }}"><button class="rounded-xl bg-red-500 px-4 py-2 text-sm font-bold text-white">Delete</button></form></div></div>
    <section class="glass-panel p-8"><div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between"><div><span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">{{ job.status.value|title }}</span><h1 class="mt-4 text-4xl font-light tracking-holographic">{{ job.title }}</h1><p class="mt-2 text-muted-foreground">{{ job.companyLabel }}{% if job.location %} · {{ job.location }}{% endif %}</p></div><div class="grid grid-cols-3 gap-3 text-center"><div class="rounded-2xl bg-muted p-4"><p class="text-2xl font-light">{{ job.viewsCount }}</p><p class="text-[10px] uppercase tracking-label text-muted-foreground">views</p></div><div class="rounded-2xl bg-muted p-4"><p class="text-2xl font-light">{{ job.applicationsCount }}</p><p class="text-[10px] uppercase tracking-label text-muted-foreground">apps</p></div><div class="rounded-2xl bg-muted p-4"><p class="text-2xl font-light">{{ readiness.score }}%</p><p class="text-[10px] uppercase tracking-label text-muted-foreground">quality</p></div></div></div></section>
    <div class="grid gap-6 lg:grid-cols-[1fr_24rem]"><article class="glass-panel space-y-8 p-8"><section><h2 class="text-xl font-semibold">Description</h2><p class="mt-4 whitespace-pre-line leading-8 text-muted-foreground">{{ job.description ?: 'No description.' }}</p></section>{% if job.requirements %}<section><h2 class="text-xl font-semibold">Requirements</h2><p class="mt-4 whitespace-pre-line leading-8 text-muted-foreground">{{ job.requirements }}</p></section>{% endif %}{% if job.skillsRequired %}<section><h2 class="text-xl font-semibold">Skills</h2><p class="mt-4 text-muted-foreground">{{ job.skillsRequired }}</p></section>{% endif %}{% if job.benefits %}<section><h2 class="text-xl font-semibold">Benefits</h2><p class="mt-4 whitespace-pre-line leading-8 text-muted-foreground">{{ job.benefits }}</p></section>{% endif %}</article><aside class="space-y-4"><div class="glass-panel p-5"><h2 class="font-semibold">Improve this offer</h2><p class="mt-1 text-sm text-muted-foreground">{{ readiness.label }}</p><ul class="mt-4 space-y-2 text-sm text-muted-foreground">{% for item in readiness.missing %}<li>• {{ item }}</li>{% else %}<li class="text-emerald-600">No major gaps.</li>{% endfor %}</ul></div><div class="glass-panel p-5"><h2 class="font-semibold">Candidate funnel</h2><p class="mt-4 text-sm text-muted-foreground">{{ applications|length }} candidates in this company queue.</p><a href="{{ path('app_applications') }}" class="mt-4 inline-flex rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Open pipeline</a></div></aside></div>
</div>
{% endblock %}
