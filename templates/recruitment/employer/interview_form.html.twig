{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Plan Interview{% endblock %}
{% block content %}
<div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 lg:px-8">
    <form method="post" class="glass-panel space-y-6 p-8">
        <input type="hidden" name="_token" value="{{ csrf_token('schedule_interview_' ~ application.id) }}">
        <header>
            <a href="{{ path('app_application_show', {id: application.id}) }}" class="inline-flex items-center gap-2 text-sm font-semibold text-muted-foreground hover:text-foreground"><i data-lucide="arrow-left" class="h-4 w-4"></i>Back to application</a>
            <p class="mt-6 text-xs font-bold uppercase tracking-label text-primary">Interview planner</p>
            <h1 class="mt-2 text-4xl font-light tracking-holographic">Plan a meeting with {{ application.candidate.displayName }}</h1>
        </header>
        <div class="grid gap-4 md:grid-cols-2">
            <label class="space-y-1"><span class="text-sm font-semibold">Date and time</span><input type="datetime-local" name="scheduled_at" value="{{ interview ? interview.scheduledAt|date('Y-m-d\\TH:i') : '' }}" class="w-full rounded-xl border border-border bg-background/70 p-3"></label>
            <label class="space-y-1"><span class="text-sm font-semibold">Duration</span><select name="duration_minutes" class="w-full rounded-xl border border-border bg-background/70 p-3"><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">60 minutes</option></select></label>
            <label class="space-y-1"><span class="text-sm font-semibold">Format</span><select name="format" class="w-full rounded-xl border border-border bg-background/70 p-3"><option value="online">Online</option><option value="onsite">On site</option><option value="phone">Phone</option></select></label>
            <label class="space-y-1"><span class="text-sm font-semibold">Meeting provider</span><select name="meeting_provider" class="w-full rounded-xl border border-border bg-background/70 p-3"><option value="jitsi">Generate test Jitsi link</option><option value="manual">Paste Google Meet/Zoom/Teams link</option></select></label>
            <label class="space-y-1 md:col-span-2"><span class="text-sm font-semibold">Meeting URL</span><input name="meeting_url" value="{{ interview ? interview.meetingUrl : '' }}" placeholder="Leave empty to auto-generate Jitsi, or paste Google Meet/Zoom" class="w-full rounded-xl border border-border bg-background/70 p-3"></label>
            <label class="space-y-1 md:col-span-2"><span class="text-sm font-semibold">Location / notes</span><textarea name="notes" rows="4" class="w-full rounded-xl border border-border bg-background/70 p-3">{{ interview ? interview.notes : '' }}</textarea></label>
        </div>
        <button class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">Save interview</button>
    </form>
</div>
{% endblock %}
