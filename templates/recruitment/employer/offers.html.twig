{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Active Offers{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <header class="glass-panel p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-label text-primary">Hiring cockpit</p>
                <h1 class="mt-1 text-4xl font-light tracking-holographic">Your offers</h1>
                <p class="mt-2 text-sm text-muted-foreground">Manage active roles, drafts, and candidate funnel health.</p>
            </div>
            <a href="{{ path('app_post_job') }}" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground"><i data-lucide="plus" class="h-4 w-4"></i>New offer</a>
        </div>
    </header>

    <section class="grid gap-4 lg:grid-cols-2">
        {% for job in jobs %}
            {% set readiness = job.readiness %}
            <article class="glass-panel p-5 transition hover:border-primary/40">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                            <span class="rounded-full bg-primary/10 px-2 py-0.5 font-bold text-primary">{{ job.status.value|title }}</span>
                            <span>{{ job.applicationsCount }} applications</span>
                            <span>{{ job.viewsCount }} views</span>
                        </div>
                        <h2 class="mt-2 text-xl font-semibold"><a href="{{ path('app_employer_offer_show', {id: job.id}) }}" class="hover:text-primary">{{ job.title }}</a></h2>
                        <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{{ job.description ?: 'No description yet.' }}</p>
                    </div>
                    <div class="shrink-0 rounded-2xl bg-muted px-3 py-2 text-center"><p class="text-sm font-bold">{{ readiness.score }}%</p><p class="text-[10px] text-muted-foreground">quality</p></div>
                </div>
                <div class="mt-5 flex flex-wrap gap-2">
                    <a href="{{ path('app_employer_offer_show', {id: job.id}) }}" class="rounded-xl border border-border px-3 py-2 text-xs font-semibold hover:bg-muted">View</a>
                    <a href="{{ path('app_employer_offer_edit', {id: job.id}) }}" class="rounded-xl border border-border px-3 py-2 text-xs font-semibold hover:bg-muted">Edit</a>
                    <form method="post" action="{{ path('app_employer_offer_duplicate', {id: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('duplicate_job_' ~ job.id) }}"><button class="rounded-xl border border-border px-3 py-2 text-xs font-semibold hover:bg-muted">Duplicate</button></form>
                    {% if job.status.value == 'closed' %}
                        <form method="post" action="{{ path('app_employer_offer_reopen', {id: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('reopen_job_' ~ job.id) }}"><button class="rounded-xl border border-border px-3 py-2 text-xs font-semibold hover:bg-muted">Reopen</button></form>
                    {% else %}
                        <form method="post" action="{{ path('app_employer_offer_close', {id: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('close_job_' ~ job.id) }}"><button class="rounded-xl border border-border px-3 py-2 text-xs font-semibold hover:bg-muted">Close</button></form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No jobs posted yet. Create one focused offer to start your pipeline.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
