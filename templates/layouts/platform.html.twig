{# Global confirm modal — replaces browser confirm() everywhere #}
<div id="global-confirm-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" id="confirm-modal-backdrop"></div>
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl animate-in fade-in zoom-in-95 duration-200">
        <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-100 dark:bg-red-950/50 text-red-600 dark:text-red-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <h3 id="confirm-modal-title" class="text-lg font-semibold text-foreground">Are you sure?</h3>
                <p id="confirm-modal-desc" class="mt-1 text-sm text-muted-foreground">This action cannot be undone.</p>
            </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
            <button id="confirm-modal-cancel" type="button"
                class="rounded-xl border border-border px-4 py-2 text-sm font-semibold transition hover:bg-muted">
                Cancel
            </button>
            <button id="confirm-modal-ok" type="button"
                class="rounded-xl bg-red-600 hover:bg-red-700 px-4 py-2 text-sm font-bold text-white transition">
                Delete
            </button>
        </div>
    </div>
</div>
<script>
window.confirmModal = function(opts) {
    return new Promise(function(resolve) {
        var modal = document.getElementById('global-confirm-modal');
        var title = document.getElementById('confirm-modal-title');
        var desc = document.getElementById('confirm-modal-desc');
        var okBtn = document.getElementById('confirm-modal-ok');
        var cancelBtn = document.getElementById('confirm-modal-cancel');
        var backdrop = document.getElementById('confirm-modal-backdrop');

        title.textContent = (opts && opts.title) || 'Are you sure?';
        desc.textContent = (opts && opts.description) || 'This action cannot be undone.';
        okBtn.textContent = (opts && opts.confirmLabel) || 'Delete';

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        function close(result) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            okBtn.removeEventListener('click', onOk);
            cancelBtn.removeEventListener('click', onCancel);
            backdrop.removeEventListener('click', onCancel);
            document.removeEventListener('keydown', onKey);
            resolve(result);
        }
        function onOk() { close(true); }
        function onCancel() { close(false); }
        function onKey(e) { if (e.key === 'Escape') close(false); }

        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        backdrop.addEventListener('click', onCancel);
        document.addEventListener('keydown', onKey);
    });
};

document.addEventListener('submit', async function(e) {
    var form = e.target;
    var msg = form.getAttribute('data-confirm');
    if (!msg) return;
    if (form._confirmed) { form._confirmed = false; return; }
    e.preventDefault();
    var ok = await window.confirmModal({ title: msg, description: 'This action cannot be undone.', confirmLabel: form.getAttribute('data-confirm-label') || 'Confirm' });
    if (ok) { form._confirmed = true; form.submit(); }
});

document.addEventListener('click', async function(e) {
    var btn = e.target.closest('[data-confirm-click]');
    if (!btn) return;
    if (btn._confirmed) { btn._confirmed = false; return; }
    e.preventDefault(); e.stopImmediatePropagation();
    var ok = await window.confirmModal({ title: btn.getAttribute('data-confirm-click'), description: 'This action cannot be undone.', confirmLabel: btn.getAttribute('data-confirm-label') || 'Confirm' });
    if (ok) { btn._confirmed = true; btn.click(); }
}, true);
</script>

{# Hand Gesture Control — lazy-loaded on demand or when enabled #}
{{ include('components/hand-gesture.html.twig') }}
<script>
(function(){
    var loaded=false;
    function loadGesture(){
        if(loaded)return;loaded=true;
        var s=document.createElement('script');s.src='{{ asset('js/hand-gesture.js') }}';document.head.appendChild(s);
    }
    var btn=document.getElementById('gesture-toggle-btn');
    if(btn)btn.addEventListener('click',loadGesture);
    /* Never auto-load on page start — user must explicitly click the button */
})();
</script>

