                        { name: 'Amira Ben Salah', role: 'UI/UX Designer', text: 'Skilora completely changed how I find clients. The AI matching saved me hours of pitching — now projects come to me.', avatar: 'A', accent: 'from-indigo-500 to-violet-500' },
                        { name: 'Yassine Khlifi', role: 'Full-Stack Developer', text: 'The real-time chat and milestone payments make collaboration seamless. Best freelancing platform in Tunisia, hands down.', avatar: 'Y', accent: 'from-teal-400 to-cyan-500' },
                        { name: 'Sarah Trabelsi', role: 'Marketing Manager at Vermeg', text: 'We hired 3 freelancers through Skilora in one week. The talent quality and verification process is outstanding.', avatar: 'S', accent: 'from-amber-400 to-orange-500' },
