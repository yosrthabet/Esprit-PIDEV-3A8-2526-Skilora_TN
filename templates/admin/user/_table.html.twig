<div class="overflow-x-auto" x-data="{ editOpen: false, editUser: {}, confirmOpen: false, confirmUser: {} }">
    <table class="w-full min-w-[860px] text-left text-sm">
        <thead class="bg-muted/40 text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
            <tr>
                <th class="px-5 py-4">User</th>
                <th class="px-5 py-4">Role</th>
                <th class="px-5 py-4">Status</th>
                <th class="px-5 py-4">Security</th>
                <th class="px-5 py-4">Created</th>
                <th class="px-5 py-4 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-border">
            {% for user in users %}
                <tr class="transition hover:bg-muted/30">
                    <td class="px-5 py-4">
                        <div class="flex items-center gap-3">
                            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-foreground text-sm font-black text-background">{{ user.displayName|slice(0, 2)|upper }}</div>
                            <div><p class="font-bold">{{ user.displayName }}</p><p class="text-xs text-muted-foreground">{{ user.email ?: user.username }}</p></div>
                        </div>
                    </td>
                    <td class="px-5 py-4"><span class="rounded-full bg-muted px-2.5 py-1 text-xs font-black">{{ user.roleDisplayName }}</span></td>
                    <td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-black {{ user.active ? 'bg-emerald-500/10 text-emerald-600' : 'bg-rose-500/10 text-rose-600' }}">{{ user.active ? 'Active' : 'Inactive' }}</span></td>
                    <td class="px-5 py-4"><span class="text-xs text-muted-foreground">{{ user.verified ? 'Verified' : 'Pending' }} · {{ user.twoFactorEnabled ? '2FA on' : '2FA off' }}</span></td>
                    <td class="px-5 py-4 text-xs text-muted-foreground">{{ user.createdAt|date('M d, Y') }}</td>
                    <td class="px-5 py-4">
                        <div class="flex justify-end gap-2">
                            <button type="button" @click="editUser = { id: {{ user.id }}, username: '{{ user.username|e('js') }}', email: '{{ (user.email ?? '')|e('js') }}', fullName: '{{ (user.fullName ?? '')|e('js') }}', role: '{{ user.role }}', active: {{ user.active ? 'true' : 'false' }}, verified: {{ user.verified ? 'true' : 'false' }}, isSelf: {{ user.id == app.user.id ? 'true' : 'false' }}, token: '{{ csrf_token('admin_user_edit_' ~ user.id) }}' }; editOpen = true" class="inline-flex items-center gap-1 rounded-xl border border-border px-3 py-2 text-xs font-bold hover:bg-muted transition"><i data-lucide="pen-line" class="h-3 w-3"></i> Edit</button>
                            {% if user.id != app.user.id %}
                                <button type="button" @click="confirmUser = { id: {{ user.id }}, name: '{{ user.displayName|e('js') }}', active: {{ user.active ? 'true' : 'false' }}, token: '{{ csrf_token('admin_user_toggle_' ~ user.id) }}' }; confirmOpen = true" class="inline-flex items-center gap-1 rounded-xl border border-border px-3 py-2 text-xs font-bold transition {{ user.active ? 'text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950' : 'text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-950' }}"><i data-lucide="{{ user.active ? 'shield-off' : 'shield-check' }}" class="h-3 w-3"></i> {{ user.active ? 'Disable' : 'Enable' }}</button>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-5 py-16 text-center text-muted-foreground">No users match those filters.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {# ── Edit User Modal ── #}
    <div x-show="editOpen" x-transition.opacity x-cloak @keydown.escape.window="editOpen = false" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div @click.outside="editOpen = false" x-show="editOpen" x-transition.scale.95 class="w-full max-w-lg rounded-[1.75rem] border border-border bg-card p-6 shadow-2xl">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-bold">Edit User</h2>
                <button @click="editOpen = false" class="rounded-full p-1.5 hover:bg-muted transition"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
            <form method="post" :action="'/admin/users/' + editUser.id + '/edit'" class="mt-5 space-y-4">
                <input type="hidden" name="_token" :value="editUser.token">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="text-xs font-bold text-muted-foreground">Username</label>
                        <input name="username" x-model="editUser.username" required class="mt-1 h-10 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-muted-foreground">Email</label>
                        <input name="email" x-model="editUser.email" type="email" class="mt-1 h-10 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-muted-foreground">Full name</label>
                        <input name="full_name" x-model="editUser.fullName" class="mt-1 h-10 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-muted-foreground">Role</label>
                        <select name="role" x-model="editUser.role" class="mt-1 h-10 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                            <option value="USER">User</option>
                            <option value="EMPLOYER">Employer</option>
                            <option value="TRAINER">Trainer</option>
                            <option value="ADMIN">Admin</option>
                        </select>
                    </div>
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                    <label class="flex items-center gap-3 rounded-2xl border border-border bg-background/50 p-3 text-sm">
                        <input type="checkbox" name="active" value="1" x-model="editUser.active" :disabled="editUser.isSelf" class="rounded">
                        <span class="font-bold">Active account</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-2xl border border-border bg-background/50 p-3 text-sm">
                        <input type="checkbox" name="verified" value="1" x-model="editUser.verified" class="rounded">
                        <span class="font-bold">Verified</span>
                    </label>
                </div>
                <p x-show="editUser.isSelf" class="text-xs text-muted-foreground">You cannot deactivate your own account.</p>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" @click="editOpen = false" class="rounded-xl border border-border px-4 py-2.5 text-sm font-bold hover:bg-muted transition">Cancel</button>
                    <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Save changes</button>
                </div>
            </form>
        </div>
    </div>

    {# ── Confirm Toggle Modal ── #}
    <div x-show="confirmOpen" x-transition.opacity x-cloak @keydown.escape.window="confirmOpen = false" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div @click.outside="confirmOpen = false" x-show="confirmOpen" x-transition.scale.95 class="w-full max-w-sm rounded-[1.75rem] border border-border bg-card p-6 shadow-2xl text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full" :class="confirmUser.active ? 'bg-rose-500/10' : 'bg-emerald-500/10'">
                <i data-lucide="shield-off" class="h-6 w-6 text-rose-600" x-show="confirmUser.active"></i>
                <i data-lucide="shield-check" class="h-6 w-6 text-emerald-600" x-show="!confirmUser.active"></i>
            </div>
            <h2 class="mt-4 text-lg font-bold" x-text="confirmUser.active ? 'Disable account?' : 'Enable account?'"></h2>
            <p class="mt-2 text-sm text-muted-foreground">
                <span x-show="confirmUser.active">This will immediately revoke <strong x-text="confirmUser.name"></strong>'s access to the platform.</span>
                <span x-show="!confirmUser.active">This will restore <strong x-text="confirmUser.name"></strong>'s access to the platform.</span>
            </p>
            <div class="mt-6 flex justify-center gap-3">
                <button @click="confirmOpen = false" class="rounded-xl border border-border px-5 py-2.5 text-sm font-bold hover:bg-muted transition">Cancel</button>
                <form method="post" :action="'/admin/users/' + confirmUser.id + '/toggle-active'">
                    <input type="hidden" name="_token" :value="confirmUser.token">
                    <button type="submit" class="rounded-xl px-5 py-2.5 text-sm font-bold text-white shadow-sm transition" :class="confirmUser.active ? 'bg-rose-600 hover:bg-rose-700' : 'bg-emerald-600 hover:bg-emerald-700'" x-text="confirmUser.active ? 'Yes, disable' : 'Yes, enable'"></button>
                </form>
            </div>
        </div>
    </div>
</div>
