{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Edit User{% endblock %}
{% block content %}
<div class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="rounded-[2rem] border border-border bg-card p-6 shadow-xl shadow-black/5 sm:p-8">
        <a href="{{ path('app_admin_user_index') }}" class="text-sm font-bold text-muted-foreground hover:text-foreground">← Back to users</a>
        <p class="mt-6 text-xs font-black uppercase tracking-[0.3em] text-primary">Admin user editor</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight">{{ managed_user.displayName }}</h1>
        <p class="mt-2 text-muted-foreground">{{ managed_user.email ?: managed_user.username }}</p>
    </section>

    <form method="post" class="rounded-[1.75rem] border border-border bg-card p-6 shadow-sm">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_user_edit_' ~ managed_user.id) }}">
        <div class="grid gap-4 md:grid-cols-2">
            <div><label class="text-sm font-bold">Username</label><input name="username" value="{{ managed_user.username }}" required class="mt-2 h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm"></div>
            <div><label class="text-sm font-bold">Email</label><input name="email" value="{{ managed_user.email }}" type="email" class="mt-2 h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm"></div>
            <div><label class="text-sm font-bold">Full name</label><input name="full_name" value="{{ managed_user.fullName }}" class="mt-2 h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm"></div>
            <div><label class="text-sm font-bold">Role</label><select name="role" class="mt-2 h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm">{% for role in roles %}<option value="{{ role }}" {{ managed_user.role == role ? 'selected' }}>{{ role|title }}</option>{% endfor %}</select></div>
        </div>
        <div class="mt-6 grid gap-3 md:grid-cols-2">
            <label class="flex items-center gap-3 rounded-2xl border border-border bg-background/50 p-4"><input type="checkbox" name="active" value="1" {{ managed_user.active ? 'checked' }} {{ managed_user.id == app.user.id ? 'disabled' }}><span class="font-bold">Active account</span></label>
            <label class="flex items-center gap-3 rounded-2xl border border-border bg-background/50 p-4"><input type="checkbox" name="verified" value="1" {{ managed_user.verified ? 'checked' }}><span class="font-bold">Verified account</span></label>
        </div>
        {% if managed_user.id == app.user.id %}<p class="mt-3 text-xs text-muted-foreground">You cannot deactivate your own account.</p>{% endif %}
        <button class="mt-6 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Save changes</button>
    </form>
</div>
{% endblock %}
