{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}New Ticket{% endblock %}
{% block content %}
<div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 lg:px-8">
    <form method="post" class="glass-panel space-y-5 p-8">
        <input type="hidden" name="_token" value="{{ csrf_token('support_ticket_new') }}">
        <header><a href="{{ path('app_support') }}" class="text-sm font-semibold text-muted-foreground hover:text-foreground">← Back to support</a><p class="mt-6 text-xs font-bold uppercase tracking-label text-primary">New ticket</p><h1 class="mt-2 text-4xl font-light tracking-holographic">Tell us what happened.</h1></header>
        <label class="block space-y-1"><span class="text-sm font-semibold">Subject</span><input required name="subject" class="w-full rounded-xl border border-border bg-background/70 p-3"></label>
        <div class="grid gap-4 md:grid-cols-2"><label class="block space-y-1"><span class="text-sm font-semibold">Category</span><select name="category" class="w-full rounded-xl border border-border bg-background/70 p-3"><option value="account">Account</option><option value="recruitment">Recruitment</option><option value="finance">Finance</option><option value="technical">Technical</option><option value="other">Other</option></select></label><label class="block space-y-1"><span class="text-sm font-semibold">Priority</span><select name="priority" class="w-full rounded-xl border border-border bg-background/70 p-3"><option value="normal">Normal</option><option value="low">Low</option><option value="high">High</option><option value="urgent">Urgent</option></select></label></div>
        <label class="block space-y-1"><span class="text-sm font-semibold">Description</span><textarea required name="description" rows="7" class="w-full rounded-xl border border-border bg-background/70 p-3"></textarea></label>
        <button class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">Create ticket</button>
    </form>
</div>
{% endblock %}
