{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}New Ticket{% endblock %}
{% block content %}
<div x-data="ticketForm()" class="mx-auto max-w-3xl space-y-6 px-4 py-6 sm:px-6 lg:px-8 animate-fade-in">

    {% include 'components/_breadcrumbs.html.twig' with {items: [{label: 'Support', route: 'app_support'}, {label: 'New Ticket'}]} %}

    {# ── Progress Steps ── #}
    <div class="flex items-center justify-center gap-2">
        {% for i in 1..3 %}
        <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold transition-colors"
                :class="step >= {{ i }} ? 'bg-primary text-primary-foreground' : 'bg-muted text-muted-foreground'">{{ i }}</div>
            <span class="text-xs font-medium hidden sm:inline" :class="step >= {{ i }} ? 'text-foreground' : 'text-muted-foreground'">
                {% if i == 1 %}Category{% elseif i == 2 %}Details{% else %}Review{% endif %}
            </span>
        </div>
        {% if i < 3 %}<div class="h-px w-8 sm:w-12 transition-colors" :class="step > {{ i }} ? 'bg-primary' : 'bg-muted'"></div>{% endif %}
        {% endfor %}
    </div>

    <form method="post" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-8 shadow-sm">
        <input type="hidden" name="_token" value="{{ csrf_token('support_ticket_new') }}">

        {# Step 1: Category + Priority #}
        <div x-show="step === 1" x-transition>
            <p class="text-xs font-black uppercase tracking-[0.35em] text-primary">Step 1</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight">What do you need help with?</h2>
            <p class="mt-2 text-sm text-muted-foreground">Select the category and priority level.</p>

            <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3">
                {% set cats = [
                    {val: 'account', icon: 'user', label: 'Account'},
                    {val: 'recruitment', icon: 'briefcase', label: 'Recruitment'},
                    {val: 'finance', icon: 'wallet', label: 'Finance'},
                    {val: 'technical', icon: 'settings', label: 'Technical'},
                    {val: 'other', icon: 'help-circle', label: 'Other'}
                ] %}
                {% for cat in cats %}
                <label class="cursor-pointer">
                    <input type="radio" name="category" value="{{ cat.val }}" x-model="category" class="peer sr-only">
                    <div class="flex flex-col items-center gap-2 rounded-2xl border-2 border-border p-4 text-center transition peer-checked:border-primary peer-checked:bg-primary/5 hover:bg-muted/40">
                        <i data-lucide="{{ cat.icon }}" class="h-5 w-5 text-muted-foreground peer-checked:text-primary"></i>
                        <span class="text-sm font-semibold">{{ cat.label }}</span>
                    </div>
                </label>
                {% endfor %}
            </div>

            <div class="mt-6">
                <label class="block text-xs font-semibold uppercase tracking-label text-muted-foreground mb-2">Priority</label>
                <div class="flex flex-wrap gap-2">
                    {% set prios = [
                        {val: 'low', color: 'sky', label: 'Low'},
                        {val: 'normal', color: 'amber', label: 'Normal'},
                        {val: 'high', color: 'orange', label: 'High'},
                        {val: 'urgent', color: 'red', label: 'Urgent'}
                    ] %}
                    {% for p in prios %}
                    <label class="cursor-pointer">
                        <input type="radio" name="priority" value="{{ p.val }}" x-model="priority" class="peer sr-only">
                        <div class="inline-flex items-center gap-1.5 rounded-xl border-2 border-border px-4 py-2 text-sm font-semibold transition peer-checked:border-{{ p.color }}-500 peer-checked:bg-{{ p.color }}-500/10 peer-checked:text-{{ p.color }}-600 dark:peer-checked:text-{{ p.color }}-400 hover:bg-muted/40">
                            <div class="h-2 w-2 rounded-full bg-{{ p.color }}-500"></div>
                            {{ p.label }}
                        </div>
                    </label>
                    {% endfor %}
                </div>
            </div>

            <div class="mt-8 flex justify-end">
                <button type="button" @click="step = 2" class="inline-flex h-11 items-center gap-2 rounded-xl bg-primary px-6 text-sm font-bold text-primary-foreground transition hover:bg-primary/90">
                    Next <i data-lucide="arrow-right" class="h-4 w-4"></i>
                </button>
            </div>
        </div>

        {# Step 2: Subject + Description #}
        <div x-show="step === 2" x-transition>
            <p class="text-xs font-black uppercase tracking-[0.35em] text-primary">Step 2</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight">Describe your issue</h2>
            <p class="mt-2 text-sm text-muted-foreground">Be specific so we can help you faster.</p>

            <div class="mt-6 space-y-4">
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-semibold uppercase tracking-label text-muted-foreground">Subject</label>
                        <button type="button" @click="aiSuggestSubject()" :disabled="aiLoading || !description.trim()" class="inline-flex items-center gap-1 text-[10px] font-bold text-primary hover:underline disabled:opacity-40 disabled:no-underline">
                            <i data-lucide="sparkles" class="h-3 w-3"></i>
                            <span x-text="aiLoading && aiLabel==='subject' ? 'Generating...' : 'AI suggest'"></span>
                        </button>
                    </div>
                    <input required name="subject" x-model="subject" placeholder="Brief summary of the issue" class="h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm transition focus:border-primary focus:ring-2 focus:ring-primary/10">
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-semibold uppercase tracking-label text-muted-foreground">Description</label>
                        <button type="button" @click="aiCorrectDescription()" :disabled="aiLoading || !description.trim()" class="inline-flex items-center gap-1 text-[10px] font-bold text-primary hover:underline disabled:opacity-40 disabled:no-underline">
                            <i data-lucide="spell-check" class="h-3 w-3"></i>
                            <span x-text="aiLoading && aiLabel==='desc' ? 'Correcting...' : 'AI correct'"></span>
                        </button>
                    </div>
                    <textarea required name="description" x-model="description" rows="7" placeholder="What happened? Include steps to reproduce if applicable..." class="w-full rounded-xl border border-border bg-background/70 p-4 text-sm transition focus:border-primary focus:ring-2 focus:ring-primary/10"></textarea>
                </div>
            </div>

            <div class="mt-8 flex justify-between">
                <button type="button" @click="step = 1" class="inline-flex h-11 items-center gap-2 rounded-xl border border-border px-5 text-sm font-semibold hover:bg-muted transition">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i> Back
                </button>
                <button type="button" @click="step = 3" class="inline-flex h-11 items-center gap-2 rounded-xl bg-primary px-6 text-sm font-bold text-primary-foreground transition hover:bg-primary/90">
                    Review <i data-lucide="arrow-right" class="h-4 w-4"></i>
                </button>
            </div>
        </div>

        {# Step 3: Review + Submit #}
        <div x-show="step === 3" x-transition>
            <p class="text-xs font-black uppercase tracking-[0.35em] text-primary">Step 3</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight">Review & submit</h2>
            <p class="mt-2 text-sm text-muted-foreground">Confirm the details before submitting.</p>

            <div class="mt-6 space-y-3">
                <div class="rounded-2xl border border-border bg-background/50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-label text-muted-foreground">Category & Priority</p>
                    <p class="mt-1 text-sm font-medium text-foreground capitalize" x-text="category + ' · ' + priority"></p>
                </div>
                <div class="rounded-2xl border border-border bg-background/50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-label text-muted-foreground">Subject</p>
                    <p class="mt-1 text-sm font-medium text-foreground" x-text="subject || '(empty)'"></p>
                </div>
                <div class="rounded-2xl border border-border bg-background/50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-label text-muted-foreground">Description</p>
                    <p class="mt-1 text-sm text-foreground whitespace-pre-line" x-text="description || '(empty)'"></p>
                </div>
            </div>

            <div class="mt-8 flex justify-between">
                <button type="button" @click="step = 2" class="inline-flex h-11 items-center gap-2 rounded-xl border border-border px-5 text-sm font-semibold hover:bg-muted transition">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i> Back
                </button>
                <button type="submit" class="inline-flex h-11 items-center gap-2 rounded-xl bg-primary px-6 text-sm font-bold text-primary-foreground transition hover:bg-primary/90 hover:scale-[1.02]">
                    <i data-lucide="send" class="h-4 w-4"></i> Create ticket
                </button>
            </div>
        </div>
    </form>
</div>
<script>
function ticketForm() {
    return {
        step: 1,
        category: 'account',
        priority: 'normal',
        subject: '',
        description: '',
        aiLoading: false,
        aiLabel: '',

        aiSuggestSubject() {
            if (!this.description.trim() || this.aiLoading) return;
            this.aiLoading = true;
            this.aiLabel = 'subject';
            fetch('/api/chat/correct', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: 'Suggest a concise subject line for this support ticket: ' + this.description })
            })
            .then(r => r.json())
            .then(d => { if (d.corrected) this.subject = d.corrected.replace(/^["']+|["']+$/g, ''); })
            .finally(() => { this.aiLoading = false; this.aiLabel = ''; });
        },

        aiCorrectDescription() {
            if (!this.description.trim() || this.aiLoading) return;
            this.aiLoading = true;
            this.aiLabel = 'desc';
            fetch('/api/chat/correct', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: this.description })
            })
            .then(r => r.json())
            .then(d => { if (d.corrected) this.description = d.corrected; })
            .finally(() => { this.aiLoading = false; this.aiLabel = ''; });
        }
    };
}
</script>
{% endblock %}
