{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Support{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-label text-primary">Support desk</p>
                <h1 class="mt-2 text-4xl font-light tracking-holographic">Your tickets</h1>
                <p class="mt-2 text-muted-foreground">Create a ticket and chat with support in real time.</p>
            </div>
            <a href="{{ path('app_support_new') }}" class="inline-flex rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">New ticket</a>
        </div>
    </section>

    <form method="get" action="{{ path('app_support') }}" class="glass-panel grid gap-3 p-4 md:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(10rem,1fr))_auto] md:items-end">
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Search</span>
            <input name="q" value="{{ filters.q|default('') }}" placeholder="Subject, description, or message" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
        </label>
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Status</span>
            <select name="status" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="all">All statuses</option>
                {% for status in statuses %}
                    <option value="{{ status.value }}" {{ filters.status|default('all') == status.value ? 'selected' }}>{{ status.label }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Category</span>
            <select name="category" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="all">All categories</option>
                {% for category in categories %}
                    <option value="{{ category.value }}" {{ filters.category|default('all') == category.value ? 'selected' }}>{{ category.label }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Priority</span>
            <select name="priority" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="all">All priorities</option>
                {% for priority in priorities %}
                    <option value="{{ priority.value }}" {{ filters.priority|default('all') == priority.value ? 'selected' }}>{{ priority.label }}</option>
                {% endfor %}
            </select>
        </label>
        <div class="flex gap-2">
            <button class="h-11 rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground">Filter</button>
            <a href="{{ path('app_support') }}" class="inline-flex h-11 items-center rounded-xl border border-border px-4 text-sm font-semibold text-muted-foreground hover:text-foreground">Reset</a>
        </div>
    </form>

    <section class="grid gap-4 lg:grid-cols-2">
        {% for ticket in tickets %}
            <a href="{{ path('app_support_show', {id: ticket.id}) }}" class="glass-panel p-5 transition hover:border-primary/40">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ ticket.status.label }}</span>
                    <span class="text-xs text-muted-foreground">{{ ticket.priority.label }} · {{ ticket.category.label }}</span>
                </div>
                <h2 class="mt-3 text-xl font-semibold">{{ ticket.subject }}</h2>
                <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{{ ticket.description }}</p>
                <p class="mt-4 text-xs text-muted-foreground">Updated {{ ticket.updatedAt|date('M d, H:i') }}</p>
            </a>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">
                No tickets match your filters. Try a different search or create a new ticket.
            </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
