{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Support Calendar{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8 animate-fade-in">

    {% include 'components/_breadcrumbs.html.twig' with {items: [{label: 'Support', route: 'app_admin_support'}, {label: 'Calendar'}]} %}

    <section class="glass-panel p-8">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-xs font-bold uppercase tracking-label text-primary">Support operations</p>
                <h1 class="mt-2 text-4xl font-light tracking-holographic">Ticket calendar</h1>
                <p class="mt-2 text-muted-foreground">Visual timeline of support tickets by creation and due dates.</p>
            </div>
            <a href="{{ path('app_admin_support') }}" class="inline-flex h-11 items-center gap-2 rounded-xl border border-border/70 bg-background/70 px-5 text-sm font-bold transition hover:bg-muted">
                <i data-lucide="list" class="h-4 w-4 text-muted-foreground"></i> Ticket list
            </a>
        </div>
    </section>

    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="glass-panel p-4 flex items-center gap-3">
            <div class="h-3 w-3 rounded-full bg-red-500"></div>
            <span class="text-xs font-semibold text-muted-foreground">Urgent / High</span>
        </div>
        <div class="glass-panel p-4 flex items-center gap-3">
            <div class="h-3 w-3 rounded-full bg-amber-500"></div>
            <span class="text-xs font-semibold text-muted-foreground">Normal</span>
        </div>
        <div class="glass-panel p-4 flex items-center gap-3">
            <div class="h-3 w-3 rounded-full bg-sky-500"></div>
            <span class="text-xs font-semibold text-muted-foreground">Low</span>
        </div>
        <div class="glass-panel p-4 flex items-center gap-3">
            <div class="h-3 w-3 rounded-full bg-emerald-500"></div>
            <span class="text-xs font-semibold text-muted-foreground">Resolved</span>
        </div>
    </section>

    <section class="glass-panel p-6">
        <div id="calendar"></div>
    </section>
</div>
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const cal = new FullCalendar.Calendar(document.getElementById('calendar'), {
        initialView: 'dayGridMonth',
        headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,dayGridWeek,listMonth' },
        events: {{ events_json|raw }},
        eventClick: function(info) { if (info.event.url) { window.location.href = info.event.url; info.jsEvent.preventDefault(); } },
        height: 'auto'
    });
    cal.render();
});
</script>
{% endblock %}
