{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Admin Support{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-label text-primary">Support operations</p>
                <h1 class="mt-2 text-4xl font-light tracking-holographic">Ticket queue</h1>
                <p class="mt-2 text-muted-foreground">Search, prioritize, and route current support requests.</p>
            </div>
            <a href="{{ path('app_admin_support_export_csv', filters) }}" class="inline-flex h-11 items-center justify-center rounded-xl border border-border px-4 text-sm font-bold hover:bg-muted/50">Export CSV</a>
        </div>
    </section>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="glass-panel p-5"><p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Open</p><p class="mt-2 text-3xl font-light">{{ status_stats.open|default(0) }}</p></div>
        <div class="glass-panel p-5"><p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Active</p><p class="mt-2 text-3xl font-light">{{ active_count }}</p></div>
        <div class="glass-panel p-5"><p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Resolved</p><p class="mt-2 text-3xl font-light">{{ status_stats.resolved|default(0) }}</p></div>
        <div class="glass-panel p-5"><p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Closed</p><p class="mt-2 text-3xl font-light">{{ status_stats.closed|default(0) }}</p></div>
    </section>

    <section class="grid gap-4 lg:grid-cols-3">
        <div class="glass-panel p-5">
            <h2 class="font-semibold">Priority distribution</h2>
            <div class="mt-4 space-y-2">
                {% for key, count in priority_stats %}
                    <div class="flex items-center justify-between rounded-xl bg-muted/30 px-3 py-2 text-sm"><span>{{ key|replace({'_': ' '})|title }}</span><strong>{{ count }}</strong></div>
                {% endfor %}
            </div>
        </div>
        <div class="glass-panel p-5">
            <h2 class="font-semibold">Category distribution</h2>
            <div class="mt-4 space-y-2">
                {% for key, count in category_stats %}
                    <div class="flex items-center justify-between rounded-xl bg-muted/30 px-3 py-2 text-sm"><span>{{ key|replace({'_': ' '})|title }}</span><strong>{{ count }}</strong></div>
                {% endfor %}
            </div>
        </div>
        <div class="glass-panel p-5">
            <h2 class="font-semibold">7-day volume</h2>
            <div class="mt-4 space-y-2">
                {% for day, count in daily_stats %}
                    <div class="flex items-center justify-between rounded-xl bg-muted/30 px-3 py-2 text-sm"><span>{{ day|date('M d') }}</span><strong>{{ count }}</strong></div>
                {% endfor %}
            </div>
        </div>
    </section>

    <form method="get" action="{{ path('app_admin_support') }}" class="glass-panel grid gap-3 p-4 xl:grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(10rem,1fr))_auto] xl:items-end">
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Search</span>
            <input name="q" value="{{ filters.q|default('') }}" placeholder="Subject, requester, description, or message" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
        </label>
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Status</span>
            <select name="status" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="all">All statuses</option>
                {% for status in statuses %}
                    <option value="{{ status.value }}" {{ filters.status|default('all') == status.value ? 'selected' }}>{{ status.label }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Category</span>
            <select name="category" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="all">All categories</option>
                {% for category in categories %}
                    <option value="{{ category.value }}" {{ filters.category|default('all') == category.value ? 'selected' }}>{{ category.label }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Priority</span>
            <select name="priority" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="all">All priorities</option>
                {% for priority in priorities %}
                    <option value="{{ priority.value }}" {{ filters.priority|default('all') == priority.value ? 'selected' }}>{{ priority.label }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-label text-muted-foreground">Sort</span>
            <select name="sort" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                <option value="updated" {{ filters.sort|default('updated') == 'updated' ? 'selected' }}>Recently updated</option>
                <option value="newest" {{ filters.sort|default('updated') == 'newest' ? 'selected' }}>Newest first</option>
                <option value="oldest" {{ filters.sort|default('updated') == 'oldest' ? 'selected' }}>Oldest first</option>
                <option value="priority" {{ filters.sort|default('updated') == 'priority' ? 'selected' }}>Highest priority</option>
            </select>
        </label>
        <div class="flex gap-2">
            <button class="h-11 rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground">Filter</button>
            <a href="{{ path('app_admin_support') }}" class="inline-flex h-11 items-center rounded-xl border border-border px-4 text-sm font-semibold text-muted-foreground hover:text-foreground">Reset</a>
        </div>
    </form>

    <section class="overflow-hidden rounded-2xl border border-border/70 bg-card/60">
        <div class="hidden grid-cols-[1.1fr_0.8fr_0.7fr_0.7fr_0.8fr] gap-4 border-b border-border/70 px-5 py-3 text-xs font-bold uppercase tracking-label text-muted-foreground lg:grid">
            <span>Ticket</span>
            <span>Requester</span>
            <span>Status</span>
            <span>Priority</span>
            <span>Updated</span>
        </div>
        {% for ticket in tickets %}
            <a href="{{ path('app_admin_support_show', {id: ticket.id}) }}" class="grid gap-3 border-b border-border/50 px-5 py-4 transition last:border-b-0 hover:bg-muted/30 lg:grid-cols-[1.1fr_0.8fr_0.7fr_0.7fr_0.8fr] lg:items-center">
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">#{{ ticket.id }}</span>
                        <span class="text-xs text-muted-foreground">{{ ticket.category.label }}</span>
                    </div>
                    <h2 class="mt-2 text-lg font-semibold">{{ ticket.subject }}</h2>
                    <p class="mt-1 line-clamp-1 text-sm text-muted-foreground lg:hidden">{{ ticket.requester.displayName }}</p>
                </div>
                <p class="hidden text-sm text-muted-foreground lg:block">{{ ticket.requester.displayName }}</p>
                <div><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ ticket.status.label }}</span></div>
                <p class="text-sm text-muted-foreground">{{ ticket.priority.label }}</p>
                <p class="text-xs text-muted-foreground">{{ ticket.updatedAt|date('M d, H:i') }}</p>
            </a>
        {% else %}
            <div class="p-12 text-center text-muted-foreground">No tickets match the current filters.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
