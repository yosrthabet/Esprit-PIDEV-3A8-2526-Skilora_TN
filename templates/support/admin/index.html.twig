{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Admin Support{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8"><p class="text-xs font-bold uppercase tracking-label text-primary">Support operations</p><h1 class="mt-2 text-4xl font-light tracking-holographic">Ticket queue</h1></section>
    <section class="grid gap-4 lg:grid-cols-2">
        {% for ticket in tickets %}<a href="{{ path('app_admin_support_show', {id: ticket.id}) }}" class="glass-panel p-5 transition hover:border-primary/40"><div class="flex flex-wrap items-center gap-2"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ ticket.status.label }}</span><span class="text-xs text-muted-foreground">{{ ticket.priority.label }} · {{ ticket.category.label }}</span></div><h2 class="mt-3 text-xl font-semibold">#{{ ticket.id }} {{ ticket.subject }}</h2><p class="mt-1 text-sm text-muted-foreground">{{ ticket.requester.displayName }} · updated {{ ticket.updatedAt|date('M d, H:i') }}</p></a>{% else %}<div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No tickets.</div>{% endfor %}
    </section>
</div>
{% endblock %}
