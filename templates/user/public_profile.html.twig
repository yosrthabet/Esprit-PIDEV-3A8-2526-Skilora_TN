{% extends 'layouts/adaptive.html.twig' %}

{% block title %}{{ target_user.fullName ?? target_user.username }} · Profil{% endblock %}
{% block page_title %}Profil{% endblock %}

{% block content %}
<div class="max-w-4xl space-y-6 animate-fade-in">

    {# Hero section #}
    <div class="glass-panel relative overflow-hidden p-0">
        <div class="h-28 bg-gradient-to-br from-primary/20 via-indigo-500/10 to-violet-500/10"></div>
        <div class="px-6 pb-6 -mt-10 relative z-10">
            <div class="flex items-end gap-5">
                <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl border-4 border-card bg-primary text-primary-foreground text-2xl font-bold uppercase shadow-lg">
                    {% set initials = (target_user.fullName ?? target_user.username)|split(' ')|map(w => w|first)|join('')|upper %}
                    {{ initials }}
                </div>
                <div class="flex-1 min-w-0 pb-1">
                    <div class="flex items-center gap-3 flex-wrap">
                        <h1 class="text-xl font-semibold tracking-tight text-foreground">{{ target_user.fullName ?? target_user.username }}</h1>
                        {% if average_rating %}
                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-2.5 py-0.5 text-xs font-semibold text-amber-700 dark:text-amber-400">
                                <i data-lucide="star" class="h-3 w-3 fill-current"></i> {{ average_rating }} <span class="text-muted-foreground font-normal">({{ review_count }})</span>
                            </span>
                        {% endif %}
                        <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary">{{ target_user.roleDisplayName }}</span>
                    </div>
                    {% if profile and profile.headline %}
                        <p class="text-sm text-muted-foreground mt-1">{{ profile.headline }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="flex items-center gap-4 mt-4 text-xs text-muted-foreground">
                {% if profile and profile.location %}
                    <span class="inline-flex items-center gap-1"><i data-lucide="map-pin" class="h-3.5 w-3.5"></i> {{ profile.location }}</span>
                {% endif %}
                <span class="inline-flex items-center gap-1"><i data-lucide="calendar" class="h-3.5 w-3.5"></i> Membre depuis {{ target_user.createdAt ? target_user.createdAt|date('m/Y') : '—' }}</span>
            </div>
            {% if profile and profile.bio %}
                <div class="mt-4 pt-4 border-t border-border/40">
                    <p class="text-sm text-foreground/80 leading-relaxed">{{ profile.bio }}</p>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">

            {# Portfolio #}
            {% if portfolio_items|length > 0 %}
            <div class="rounded-xl border border-border bg-card shadow-sm p-6">
                <h2 class="text-base font-semibold mb-4">Portfolio</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {% for item in portfolio_items %}
                        <div class="rounded-lg border border-border bg-background p-4 space-y-2">
                            {% if item.imageUrl %}
                                <img src="{{ item.imageUrl }}" alt="{{ item.title }}" class="w-full h-32 object-cover rounded-md" loading="lazy">
                            {% endif %}
                            <h3 class="text-sm font-semibold">{{ item.title }}</h3>
                            {% if item.description %}
                                <p class="text-xs text-muted-foreground line-clamp-2">{{ item.description }}</p>
                            {% endif %}
                            {% if item.technologies %}
                                <div class="flex flex-wrap gap-1">
                                    {% for tech in item.technologies|split(',') %}
                                        <span class="inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground">{{ tech|trim }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% if item.projectUrl %}
                                <a href="{{ item.projectUrl }}" target="_blank" rel="noopener" class="text-xs text-primary hover:underline">Voir le projet →</a>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Reviews #}
            {% if reviews|length > 0 %}
            <div class="rounded-xl border border-border bg-card shadow-sm p-6">
                <h2 class="text-base font-semibold mb-4">Avis reçus</h2>
                <div class="space-y-3">
                    {% for review in reviews %}
                        <div class="{% if not loop.first %}border-t border-border pt-3{% endif %}">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-amber-400 text-sm">{% for i in 1..review.rating %}★{% endfor %}{% for i in review.rating+1..5 %}☆{% endfor %}</span>
                                <span class="text-xs text-muted-foreground">par {{ review.author.fullName ?? 'Anonyme' }} · {{ review.createdAt|date('d/m/Y') }}</span>
                            </div>
                            {% if review.comment %}
                                <p class="text-sm text-foreground/80">{{ review.comment }}</p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>

        {# Sidebar: Skills #}
        <div class="space-y-6">
            {% if skills|length > 0 %}
            <div class="rounded-xl border border-border bg-card shadow-sm p-6">
                <h2 class="text-base font-semibold mb-4">Compétences</h2>
                <div class="space-y-2.5">
                    {% for skill in skills %}
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">{{ skill.skillName }}</span>
                                {% if skill.verified %}
                                    <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400">Vérifié</span>
                                {% endif %}
                            </div>
                            <div class="text-xs text-muted-foreground">
                                {% if skill.proficiencyLevel %}{{ skill.proficiencyLevel }}{% endif %}
                                {% if skill.yearsExperience %} · {{ skill.yearsExperience }} an{{ skill.yearsExperience > 1 ? 's' : '' }}{% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Quick stats #}
            <div class="glass-panel p-6">
                <h2 class="text-base font-semibold mb-4">Statistiques</h2>
                <div class="grid grid-cols-2 gap-3">
                    <div class="rounded-xl border border-border bg-background/50 p-3 text-center">
                        <div class="flex h-8 w-8 mx-auto items-center justify-center rounded-lg bg-amber-500/10 text-amber-500"><i data-lucide="message-square" class="h-4 w-4"></i></div>
                        <p class="mt-2 text-lg font-semibold">{{ review_count }}</p>
                        <p class="text-[10px] text-muted-foreground">Avis</p>
                    </div>
                    {% if average_rating %}
                    <div class="rounded-xl border border-border bg-background/50 p-3 text-center">
                        <div class="flex h-8 w-8 mx-auto items-center justify-center rounded-lg bg-amber-500/10 text-amber-500"><i data-lucide="star" class="h-4 w-4 fill-current"></i></div>
                        <p class="mt-2 text-lg font-semibold">{{ average_rating }}</p>
                        <p class="text-[10px] text-muted-foreground">Note</p>
                    </div>
                    {% endif %}
                    <div class="rounded-xl border border-border bg-background/50 p-3 text-center">
                        <div class="flex h-8 w-8 mx-auto items-center justify-center rounded-lg bg-sky-500/10 text-sky-500"><i data-lucide="zap" class="h-4 w-4"></i></div>
                        <p class="mt-2 text-lg font-semibold">{{ skills|length }}</p>
                        <p class="text-[10px] text-muted-foreground">Compétences</p>
                    </div>
                    <div class="rounded-xl border border-border bg-background/50 p-3 text-center">
                        <div class="flex h-8 w-8 mx-auto items-center justify-center rounded-lg bg-violet-500/10 text-violet-500"><i data-lucide="folder" class="h-4 w-4"></i></div>
                        <p class="mt-2 text-lg font-semibold">{{ portfolio_items|length }}</p>
                        <p class="text-[10px] text-muted-foreground">Projets</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
