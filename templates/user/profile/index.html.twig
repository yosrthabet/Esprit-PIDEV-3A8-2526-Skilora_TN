{# templates/profile/index.html.twig — Own profile edit page #}
{% extends 'layouts/adaptive.html.twig' %}

{% block page_title %}My Profile{% endblock %}

{% block content %}
<div class="grid gap-6 lg:grid-cols-3">

    {# ===== LEFT COLUMN (2/3) ===== #}
    <div class="lg:col-span-2 space-y-6">

        {# --- Profile Info Card --- #}
        <div class="glass-panel overflow-hidden">
            <div class="flex flex-col space-y-1.5 p-6">
                <h3 class="font-semibold leading-none tracking-label">Profile Information</h3>
                <p class="text-sm text-muted-foreground">Update your personal details</p>
            </div>
            <div class="p-6 pt-0">
                <form action="{{ path('app_profile_update') }}" method="post" class="space-y-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_update') }}">

                    <div class="grid gap-4 sm:grid-cols-2">
                        {{ include('components/input.html.twig', {
                            name: 'first_name', label: 'First Name', type: 'text',
                            placeholder: 'John', value: profile.firstName
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'last_name', label: 'Last Name', type: 'text',
                            placeholder: 'Doe', value: profile.lastName
                        }) }}
                    </div>

                    {{ include('components/input.html.twig', {
                        name: 'headline', label: 'Headline', type: 'text',
                        placeholder: 'Full-Stack Developer | Open Source Enthusiast',
                        value: profile.headline
                    }) }}

                    <div class="space-y-2">
                        {{ include('components/label.html.twig', { for: 'bio', text: 'Bio' }) }}
                        <textarea
                            id="bio" name="bio" rows="4"
                            placeholder="Tell us about yourself..."
                            class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        >{{ profile.bio }}</textarea>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        {{ include('components/input.html.twig', {
                            name: 'phone', label: 'Phone', type: 'tel',
                            placeholder: '+216 XX XXX XXX', value: profile.phone
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'location', label: 'Location', type: 'text',
                            placeholder: 'Tunis, Tunisia', value: profile.location
                        }) }}
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        {{ include('components/input.html.twig', {
                            name: 'website', label: 'Website', type: 'url',
                            placeholder: 'https://yoursite.com', value: profile.website
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'birth_date', label: 'Date of Birth', type: 'date',
                            value: profile.birthDate ? profile.birthDate|date('Y-m-d') : ''
                        }) }}
                    </div>

                    <div class="flex justify-end">
                        {{ include('components/button.html.twig', { label: 'Save Changes', type: 'submit', variant: 'default' }) }}
                    </div>
                </form>
            </div>
        </div>

        {# ─── AI Profile Intelligence Panel ─────────────────────────────── #}
        <div id="ai-profile-panel"
             x-data="profileAI()"
             x-init="init()"
             class="relative overflow-hidden rounded-2xl border border-violet-200/60 dark:border-violet-800/40 bg-white dark:bg-zinc-900 shadow-lg shadow-violet-100/50 dark:shadow-violet-900/20">

            {# Gradient accent top bar #}
            <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-violet-500 via-indigo-500 to-purple-500"></div>

            {# Subtle background gradient blob #}
            <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-violet-400/10 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-16 -left-16 h-48 w-48 rounded-full bg-indigo-400/10 blur-3xl"></div>

            {# ── Header ── #}
            <div class="relative flex items-center justify-between px-6 py-5">
                <div class="flex items-center gap-3.5">
                    <div class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 text-white shadow-md shadow-violet-500/30">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
                        </svg>
                        {# Glow ring on streaming #}
                        <span x-show="status === 'streaming'"
                              class="absolute inset-0 rounded-xl animate-ping bg-violet-400/40"></span>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-50">AI Profile Intelligence</h3>
                        <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-0.5">Auto-analyzes as you edit • AI powered</p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    {# Status pill #}
                    <div class="hidden sm:flex">
                        <span x-show="status === 'idle'" class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-2.5 py-1 text-[11px] font-medium text-zinc-400">
                            <span class="h-1.5 w-1.5 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>Waiting
                        </span>
                        <span x-show="status === 'debouncing'" class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-medium text-amber-600">
                            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>Detecting…
                        </span>
                        <span x-show="status === 'streaming'" class="inline-flex items-center gap-1.5 rounded-full border border-violet-200 bg-violet-50 px-2.5 py-1 text-[11px] font-medium text-violet-600">
                            <span class="h-1.5 w-1.5 rounded-full bg-violet-500 animate-pulse"></span>Analyzing…
                        </span>
                        <span x-show="status === 'done'" class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-medium text-emerald-600">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Analysis ready
                        </span>
                    </div>

                    {# Analyze button #}
                    <button @click="triggerNow()"
                            :disabled="status === 'streaming'"
                            class="group inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-br from-violet-500 to-indigo-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm shadow-violet-500/30 transition-all hover:shadow-md hover:shadow-violet-500/40 hover:-translate-y-px active:translate-y-0 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-none disabled:hover:translate-y-0">
                        <svg class="h-3 w-3 transition-transform group-hover:rotate-180 duration-500" :class="{ 'animate-spin': status === 'streaming' }" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/>
                        </svg>
                        <span x-text="status === 'streaming' ? 'Analyzing…' : 'Analyze now'"></span>
                    </button>
                </div>
            </div>

            {# Divider #}
            <div class="mx-6 h-px bg-gradient-to-r from-transparent via-violet-100 dark:via-violet-900/50 to-transparent"></div>

            {# ── Empty state ── #}
            <div x-show="status === 'idle' && !result" class="px-6 py-10">
                <div class="flex flex-col items-center gap-3 text-center">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-violet-100 dark:border-violet-900/50 bg-violet-50 dark:bg-violet-950/30 text-2xl shadow-inner">🧠</div>
                    <div>
                        <p class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Edit your profile to trigger an analysis</p>
                        <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-1 max-w-xs mx-auto">The AI re-analyzes automatically 2 seconds after you stop typing — or hit <strong>Analyze now</strong> at any time.</p>
                    </div>
                </div>
            </div>

            {# ── Streaming skeleton ── #}
            <div x-show="status === 'streaming' && !result" class="px-6 py-5">
                <div class="rounded-xl border border-violet-100 dark:border-violet-900/40 bg-violet-50/50 dark:bg-violet-950/20 p-4">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="flex gap-1">
                            <span class="h-2 w-2 rounded-full bg-violet-400 animate-bounce [animation-delay:0ms]"></span>
                            <span class="h-2 w-2 rounded-full bg-violet-400 animate-bounce [animation-delay:150ms]"></span>
                            <span class="h-2 w-2 rounded-full bg-violet-400 animate-bounce [animation-delay:300ms]"></span>
                        </div>
                        <span class="text-[11px] font-medium text-violet-500 uppercase tracking-widest">GPT is thinking</span>
                    </div>
                    <p class="font-mono text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed whitespace-pre-wrap break-words min-h-[3rem]"
                       x-text="streamBuffer || ' '"></p>
                </div>
            </div>

            {# ── Structured result ── #}
            <template x-if="result">
                <div class="px-6 pb-6 space-y-3 mt-1">

                    {# Row 1: Roast + Archetype #}
                    <div class="grid gap-3 sm:grid-cols-2">

                        {# Roast card #}
                        <div class="group relative overflow-hidden rounded-xl border border-orange-100 dark:border-orange-900/30 bg-gradient-to-br from-orange-50 to-amber-50/60 dark:from-orange-950/20 dark:to-amber-950/10 p-4 transition-shadow hover:shadow-sm">
                            <div class="absolute top-0 right-0 h-16 w-16 translate-x-4 -translate-y-4 rounded-full bg-orange-200/40 dark:bg-orange-800/20 blur-xl"></div>
                            <div class="flex items-center gap-2 mb-2.5">
                                <span class="flex h-6 w-6 items-center justify-center rounded-md bg-orange-100 dark:bg-orange-900/40 text-sm">🔥</span>
                                <span class="text-[10px] font-bold uppercase tracking-widest text-orange-500 dark:text-orange-400">Honest Take</span>
                            </div>
                            <p class="text-sm leading-relaxed text-zinc-700 dark:text-zinc-300" x-text="result.roast"></p>
                        </div>

                        {# Archetype card #}
                        <div class="group relative overflow-hidden rounded-xl border border-violet-100 dark:border-violet-900/30 bg-gradient-to-br from-violet-50 to-purple-50/60 dark:from-violet-950/20 dark:to-purple-950/10 p-4 transition-shadow hover:shadow-sm">
                            <div class="absolute top-0 right-0 h-16 w-16 translate-x-4 -translate-y-4 rounded-full bg-violet-200/40 dark:bg-violet-800/20 blur-xl"></div>
                            <div class="flex items-center gap-2 mb-2.5">
                                <span class="flex h-6 w-6 items-center justify-center rounded-md bg-violet-100 dark:bg-violet-900/40 text-sm">🎭</span>
                                <span class="text-[10px] font-bold uppercase tracking-widest text-violet-500 dark:text-violet-400">Your Archetype</span>
                            </div>
                            <p class="text-sm font-bold text-zinc-900 dark:text-zinc-100" x-text="result.archetype"></p>
                            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5 leading-relaxed" x-text="result.archetype_reason"></p>
                        </div>
                    </div>

                    {# Competitive Edge #}
                    <div class="relative overflow-hidden rounded-xl border border-emerald-100 dark:border-emerald-900/30 bg-gradient-to-br from-emerald-50 to-teal-50/60 dark:from-emerald-950/20 dark:to-teal-950/10 p-4">
                        <div class="absolute top-0 right-0 h-20 w-20 translate-x-6 -translate-y-6 rounded-full bg-emerald-200/40 dark:bg-emerald-800/20 blur-2xl"></div>
                        <div class="flex items-center gap-2 mb-2.5">
                            <span class="flex h-6 w-6 items-center justify-center rounded-md bg-emerald-100 dark:bg-emerald-900/40 text-sm">⚡</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Competitive Edge</span>
                        </div>
                        <p class="text-sm leading-relaxed text-zinc-700 dark:text-zinc-300" x-text="result.competitive_edge"></p>
                    </div>

                    {# AI Rewrite #}
                    <div class="rounded-xl border border-blue-100 dark:border-blue-900/30 bg-gradient-to-br from-blue-50 to-sky-50/60 dark:from-blue-950/20 dark:to-sky-950/10 p-4 space-y-4">
                        <div class="flex items-center gap-2">
                            <span class="flex h-6 w-6 items-center justify-center rounded-md bg-blue-100 dark:bg-blue-900/40 text-sm">✍️</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">AI Rewrite</span>
                        </div>

                        {# Headline #}
                        <div class="rounded-lg bg-white/70 dark:bg-zinc-800/50 border border-blue-100/80 dark:border-blue-900/30 p-3">
                            <p class="text-[10px] font-semibold uppercase tracking-widest text-blue-400 dark:text-blue-500 mb-1.5">Headline</p>
                            <div class="flex items-start justify-between gap-3">
                                <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 leading-snug" x-text="result.rewritten_headline"></p>
                                <button @click="copyToField('headline', result.rewritten_headline)"
                                        class="shrink-0 inline-flex items-center gap-1 rounded-md border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/30 px-2 py-1 text-[11px] font-semibold text-blue-600 dark:text-blue-400 transition hover:bg-blue-100 dark:hover:bg-blue-900/50">
                                    Use this ↗
                                </button>
                            </div>
                        </div>

                        {# Bio #}
                        <div class="rounded-lg bg-white/70 dark:bg-zinc-800/50 border border-blue-100/80 dark:border-blue-900/30 p-3">
                            <p class="text-[10px] font-semibold uppercase tracking-widest text-blue-400 dark:text-blue-500 mb-1.5">Bio</p>
                            <div class="flex items-start justify-between gap-3">
                                <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed" x-text="result.rewritten_bio"></p>
                                <button @click="copyToField('bio', result.rewritten_bio)"
                                        class="shrink-0 inline-flex items-center gap-1 rounded-md border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/30 px-2 py-1 text-[11px] font-semibold text-blue-600 dark:text-blue-400 transition hover:bg-blue-100 dark:hover:bg-blue-900/50">
                                    Use this ↗
                                </button>
                            </div>
                        </div>
                    </div>

                    {# Top 3 Actions #}
                    <div class="rounded-xl border border-zinc-200/80 dark:border-zinc-700/50 bg-zinc-50/80 dark:bg-zinc-800/30 p-4">
                        <div class="flex items-center gap-2 mb-3">
                            <span class="flex h-6 w-6 items-center justify-center rounded-md bg-zinc-200 dark:bg-zinc-700 text-sm">🎯</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">Top 3 Actions</span>
                        </div>
                        <ol class="space-y-2">
                            <template x-for="(action, idx) in result.top_3_actions" :key="idx">
                                <li class="flex items-start gap-3 rounded-lg border border-zinc-200/60 dark:border-zinc-700/40 bg-white dark:bg-zinc-800/50 px-3 py-2.5">
                                    <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 text-[10px] font-bold text-white shadow-sm" x-text="idx + 1"></span>
                                    <span class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed" x-text="action"></span>
                                </li>
                            </template>
                        </ol>
                    </div>

                </div>
            </template>

            {# Error #}
            <div x-show="error" class="mx-6 mb-6 flex items-start gap-2 rounded-xl border border-red-200 dark:border-red-900/40 bg-red-50 dark:bg-red-950/20 p-4">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z"/>
                </svg>
                <p class="text-sm text-red-700 dark:text-red-400" x-text="error"></p>
            </div>

        </div>
        {# ─────────────────────────────────────────────────────────────────── #}

        {# --- Skills Section --- #}
        <div class="glass-panel overflow-hidden">
            <div class="flex flex-col space-y-1.5 p-6">
                <h3 class="font-semibold leading-none tracking-label">Skills</h3>
                <p class="text-sm text-muted-foreground">Manage your technical and professional skills</p>
            </div>
            <div class="p-6 pt-0 space-y-4">
                {# Existing skills #}
                {% if skills|length > 0 %}
                <div class="flex flex-wrap gap-2">
                    {% for skill in skills %}
                    <div class="inline-flex items-center gap-1.5 rounded-md border border-border bg-secondary/50 px-2.5 py-1 text-xs font-medium">
                        <span>{{ skill.skillName }}</span>
                        {% if skill.proficiencyLevel %}
                            <span class="text-muted-foreground">· {{ skill.proficiencyLevel|lower|capitalize }}</span>
                        {% endif %}
                        {% if skill.yearsExperience %}
                            <span class="text-muted-foreground">· {{ skill.yearsExperience }}y</span>
                        {% endif %}
                        <form action="{{ path('app_profile_skill_delete', { id: skill.id }) }}" method="post" class="inline">
                            <button type="submit" class="ml-1 text-muted-foreground hover:text-destructive transition-colors" title="Remove skill">
                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-sm text-muted-foreground">No skills added yet.</p>
                {% endif %}

                {# Add skill form #}
                <div class="shrink-0 bg-border/50 h-[1px] w-full"></div>
                <form action="{{ path('app_profile_skill_add') }}" method="post" class="space-y-3">
                    <p class="text-sm font-medium">Add a Skill</p>
                    <div class="grid gap-3 sm:grid-cols-3">
                        {{ include('components/input.html.twig', {
                            name: 'skill_name', type: 'text',
                            placeholder: 'e.g. PHP, React, Docker', required: true
                        }) }}
                        {{ include('components/select.html.twig', {
                            name: 'proficiency_level',
                            placeholder: 'Level',
                            options: [
                                { value: 'BEGINNER', label: 'Beginner' },
                                { value: 'INTERMEDIATE', label: 'Intermediate' },
                                { value: 'ADVANCED', label: 'Advanced' },
                                { value: 'EXPERT', label: 'Expert' },
                            ]
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'years_experience', type: 'number',
                            placeholder: 'Years'
                        }) }}
                    </div>
                    <div class="flex justify-end">
                        {{ include('components/button.html.twig', { label: 'Add Skill', type: 'submit', variant: 'outline', size: 'sm' }) }}
                    </div>
                </form>
            </div>
        </div>

        {# --- Experience Section --- #}
        <div class="glass-panel overflow-hidden">
            <div class="flex flex-col space-y-1.5 p-6">
                <h3 class="font-semibold leading-none tracking-label">Experience</h3>
                <p class="text-sm text-muted-foreground">Your work history and professional experience</p>
            </div>
            <div class="p-6 pt-0 space-y-4">
                {# Existing experiences #}
                {% if experiences|length > 0 %}
                <div class="space-y-3">
                    {% for exp in experiences %}
                    <div class="flex items-start justify-between rounded-lg border border-border p-4">
                        <div class="space-y-1">
                            <p class="font-medium text-sm">{{ exp.position }}</p>
                            <p class="text-sm text-muted-foreground">{{ exp.company }}</p>
                            <p class="text-xs text-muted-foreground">
                                {{ exp.startDate ? exp.startDate|date('M Y') : '?' }}
                                —
                                {{ exp.currentJob ? 'Present' : (exp.endDate ? exp.endDate|date('M Y') : '?') }}
                            </p>
                            {% if exp.description %}
                                <p class="text-sm text-muted-foreground mt-1">{{ exp.description|length > 150 ? exp.description|slice(0, 150) ~ '…' : exp.description }}</p>
                            {% endif %}
                        </div>
                        <form action="{{ path('app_profile_experience_delete', { id: exp.id }) }}" method="post">
                            {{ include('components/button.html.twig', { label: '✕', type: 'submit', variant: 'ghost', size: 'icon', class: 'h-7 w-7 text-muted-foreground hover:text-destructive' }) }}
                        </form>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-sm text-muted-foreground">No experience added yet.</p>
                {% endif %}

                {# Add experience form #}
                <div class="shrink-0 bg-border/50 h-[1px] w-full"></div>
                <form action="{{ path('app_profile_experience_add') }}" method="post" class="space-y-3">
                    <p class="text-sm font-medium">Add Experience</p>
                    <div class="grid gap-3 sm:grid-cols-2">
                        {{ include('components/input.html.twig', {
                            name: 'company', type: 'text',
                            placeholder: 'Company name', required: true
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'position', type: 'text',
                            placeholder: 'Job title', required: true
                        }) }}
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        {{ include('components/input.html.twig', {
                            name: 'start_date', label: 'Start Date', type: 'date', required: true
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'end_date', label: 'End Date', type: 'date'
                        }) }}
                    </div>
                    <div class="space-y-2">
                        <textarea
                            id="description" name="description" rows="3"
                            placeholder="Describe your responsibilities and achievements..."
                            class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        ></textarea>
                    </div>
                    {{ include('components/checkbox.html.twig', { name: 'current_job', label: 'I currently work here' }) }}
                    <div class="flex justify-end">
                        {{ include('components/button.html.twig', { label: 'Add Experience', type: 'submit', variant: 'outline', size: 'sm' }) }}
                    </div>
                </form>
            </div>
        </div>

        {# --- Portfolio Section --- #}
        <div class="glass-panel overflow-hidden">
            <div class="flex flex-col space-y-1.5 p-6">
                <h3 class="font-semibold leading-none tracking-label">Portfolio</h3>
                <p class="text-sm text-muted-foreground">Showcase your best work</p>
            </div>
            <div class="p-6 pt-0 space-y-4">
                {# Existing portfolio items #}
                {% if portfolioItems|length > 0 %}
                <div class="grid gap-4 sm:grid-cols-2">
                    {% for item in portfolioItems %}
                    <div class="rounded-lg border border-border overflow-hidden">
                        {% if item.imageUrl %}
                        <div class="aspect-video bg-muted overflow-hidden">
                            <img src="{{ item.imageUrl }}" alt="{{ item.title }}" class="h-full w-full object-cover">
                        </div>
                        {% endif %}
                        <div class="p-4 space-y-2">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="font-medium text-sm">{{ item.title }}</p>
                                    {% if item.description %}
                                        <p class="text-xs text-muted-foreground mt-0.5">{{ item.description|length > 100 ? item.description|slice(0, 100) ~ '…' : item.description }}</p>
                                    {% endif %}
                                </div>
                                <form action="{{ path('app_profile_portfolio_delete', { id: item.id }) }}" method="post">
                                    <button type="submit" class="text-muted-foreground hover:text-destructive transition-colors">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                            {% if item.technologies %}
                            <div class="flex flex-wrap gap-1">
                                {% for tech in item.technologies|split(',') %}
                                    {{ include('components/badge.html.twig', { label: tech|trim, variant: 'secondary' }) }}
                                {% endfor %}
                            </div>
                            {% endif %}
                            {% if item.projectUrl %}
                            <a href="{{ item.projectUrl }}" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-1 text-xs text-primary hover:underline">
                                View Project →
                            </a>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-sm text-muted-foreground">No portfolio items yet.</p>
                {% endif %}

                {# Add portfolio form #}
                <div class="shrink-0 bg-border/50 h-[1px] w-full"></div>
                <form action="{{ path('app_profile_portfolio_add') }}" method="post" class="space-y-3">
                    <p class="text-sm font-medium">Add Portfolio Item</p>
                    <div class="grid gap-3 sm:grid-cols-2">
                        {{ include('components/input.html.twig', {
                            name: 'title', type: 'text',
                            placeholder: 'Project title', required: true
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'project_url', type: 'url',
                            placeholder: 'https://github.com/...'
                        }) }}
                    </div>
                    <div class="space-y-2">
                        <textarea
                            id="portfolio_description" name="description" rows="2"
                            placeholder="Brief description of the project..."
                            class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        ></textarea>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        {{ include('components/input.html.twig', {
                            name: 'image_url', type: 'url',
                            placeholder: 'Image URL (optional)'
                        }) }}
                        {{ include('components/input.html.twig', {
                            name: 'technologies', type: 'text',
                            placeholder: 'PHP, Symfony, React (comma-separated)'
                        }) }}
                    </div>
                    <div class="flex justify-end">
                        {{ include('components/button.html.twig', { label: 'Add Portfolio Item', type: 'submit', variant: 'outline', size: 'sm' }) }}
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# ===== RIGHT COLUMN (1/3) — Profile Preview ===== #}
    <div class="space-y-6">
        <div class="glass-panel overflow-hidden sticky top-6">
            <div class="p-6 space-y-4">
                {# Avatar + photo upload #}
                <div class="flex flex-col items-center space-y-3" x-data="profilePhoto()">
                    {% set initials = ((profile.firstName ?? '')|first|upper) ~ ((profile.lastName ?? '')|first|upper) %}

                    {# Clickable avatar area #}
                    <div class="relative group cursor-pointer" @click="$refs.fileInput.click()">
                        <span class="relative flex shrink-0 overflow-hidden rounded-full h-20 w-20 text-xl ring-2 ring-transparent group-hover:ring-primary/50 transition-all">
                            {% if profile.photoUrl %}
                                <img
                                    :src="currentPhoto || '{{ profile.photoUrl }}'"
                                    alt="Profile photo"
                                    class="aspect-square h-full w-full object-cover"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                />
                                <span class="hidden items-center justify-center h-full w-full rounded-full bg-muted font-medium text-muted-foreground">
                                    {{ initials ?: '?' }}
                                </span>
                            {% else %}
                                <template x-if="currentPhoto">
                                    <img :src="currentPhoto" alt="Profile photo" class="aspect-square h-full w-full object-cover" />
                                </template>
                                <span x-show="!currentPhoto" class="flex items-center justify-center h-full w-full rounded-full bg-muted font-medium text-muted-foreground">
                                    {{ initials ?: '?' }}
                                </span>
                            {% endif %}
                        </span>

                        {# Hover overlay #}
                        <div class="absolute inset-0 rounded-full bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/>
                            </svg>
                        </div>
                    </div>

                    <input type="file" x-ref="fileInput" @change="onFileSelected" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />

                    <div class="flex items-center gap-2">
                        <button @click="$refs.fileInput.click()" type="button"
                                class="text-xs text-primary hover:underline font-medium">
                            Change photo
                        </button>
                        <template x-if="currentPhoto">
                            <button @click="removePhoto()" type="button"
                                    class="text-xs text-destructive hover:underline font-medium">
                                Remove
                            </button>
                        </template>
                    </div>

                    {# Upload status #}
                    <template x-if="uploading">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <svg class="animate-spin h-3 w-3" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                            Uploading...
                        </div>
                    </template>

                    <div class="text-center">
                        <p class="font-semibold text-lg">{{ profile.fullName ?: app.user.displayName }}</p>
                        {% if profile.headline %}
                            <p class="text-sm text-muted-foreground">{{ profile.headline }}</p>
                        {% endif %}
                    </div>

                    {# ===== Crop Modal ===== #}
                    <div x-show="showCropper" x-cloak
                         class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm"
                         @keydown.escape.window="cancelCrop()">
                        <div class="bg-card rounded-xl shadow-2xl border border-border w-full max-w-lg mx-4 overflow-hidden"
                             @click.outside="cancelCrop()">
                            <div class="flex items-center justify-between p-4 border-b border-border">
                                <h3 class="font-semibold">Crop Profile Photo</h3>
                                <button @click="cancelCrop()" type="button" class="text-muted-foreground hover:text-foreground transition-colors">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                                </button>
                            </div>
                            <div class="p-4">
                                <div class="relative w-full" style="max-height: 400px;">
                                    <img x-ref="cropImage" :src="cropImageSrc" class="max-w-full" style="display: block;" />
                                </div>
                            </div>
                            <div class="flex items-center justify-between p-4 border-t border-border">
                                <div class="flex gap-2">
                                    <button @click="rotateCrop(-90)" type="button" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-8 w-8 border border-input bg-background hover:bg-accent transition-colors" title="Rotate left">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
                                    </button>
                                    <button @click="rotateCrop(90)" type="button" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-8 w-8 border border-input bg-background hover:bg-accent transition-colors" title="Rotate right">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l6-6m0 0l-6-6m6 6H9a6 6 0 000 12h3"/></svg>
                                    </button>
                                    <button @click="resetCrop()" type="button" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-8 px-2 border border-input bg-background hover:bg-accent transition-colors text-xs" title="Reset">
                                        Reset
                                    </button>
                                </div>
                                <div class="flex gap-2">
                                    <button @click="cancelCrop()" type="button"
                                            class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background shadow-sm hover:bg-accent h-9 px-4">
                                        Cancel
                                    </button>
                                    <button @click="applyCrop()" type="button"
                                            class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4">
                                        Apply & Upload
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                {# Bio preview #}
                {% if profile.bio %}
                <p class="text-sm text-muted-foreground">{{ profile.bio|length > 120 ? profile.bio|slice(0, 120) ~ '…' : profile.bio }}</p>
                {% endif %}

                {# Skill badges #}
                {% if skills|length > 0 %}
                <div class="flex flex-wrap gap-1.5">
                    {% for skill in skills|slice(0, 8) %}
                        {{ include('components/badge.html.twig', { label: skill.skillName, variant: 'secondary' }) }}
                    {% endfor %}
                    {% if skills|length > 8 %}
                        <span class="text-xs text-muted-foreground self-center">+{{ skills|length - 8 }} more</span>
                    {% endif %}
                </div>
                {% endif %}

                {# View public profile link #}
                <a href="{{ path('app_profile_public', { username: app.user.username }) }}"
                   class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full text-sm font-medium transition-colors border border-input bg-background/50 backdrop-blur-md shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 w-full">
                    View Public Profile
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block head %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('profilePhoto', () => ({
        currentPhoto: {{ profile.photoUrl ? profile.photoUrl|json_encode|raw : 'null' }},
        showCropper: false,
        cropImageSrc: '',
        cropper: null,
        uploading: false,

        onFileSelected(e) {
            const file = e.target.files[0];
            if (!file) return;

            // Validate client-side
            const allowed = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
            if (!allowed.includes(file.type)) {
                alert('Please select a JPG, PNG, WebP, or GIF image.');
                return;
            }
            if (file.size > 10 * 1024 * 1024) {
                alert('Image must be under 10MB.');
                return;
            }

            const reader = new FileReader();
            reader.onload = (ev) => {
                this.cropImageSrc = ev.target.result;
                this.showCropper = true;

                this.$nextTick(() => {
                    const img = this.$refs.cropImage;
                    if (this.cropper) {
                        this.cropper.destroy();
                    }
                    this.cropper = new Cropper(img, {
                        aspectRatio: 1,
                        viewMode: 1,
                        dragMode: 'move',
                        autoCropArea: 0.9,
                        cropBoxResizable: true,
                        cropBoxMovable: true,
                        guides: true,
                        center: true,
                        highlight: false,
                        background: false,
                    });
                });
            };
            reader.readAsDataURL(file);
            // Reset so same file can be re-selected
            e.target.value = '';
        },

        rotateCrop(deg) {
            if (this.cropper) this.cropper.rotate(deg);
        },

        resetCrop() {
            if (this.cropper) this.cropper.reset();
        },

        cancelCrop() {
            this.showCropper = false;
            if (this.cropper) {
                this.cropper.destroy();
                this.cropper = null;
            }
            this.cropImageSrc = '';
        },

        async applyCrop() {
            if (!this.cropper) return;

            const canvas = this.cropper.getCroppedCanvas({
                width: 400,
                height: 400,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high',
            });

            const base64 = canvas.toDataURL('image/jpeg', 0.9);

            this.showCropper = false;
            this.cropper.destroy();
            this.cropper = null;
            this.cropImageSrc = '';
            this.uploading = true;

            try {
                const formData = new FormData();
                formData.append('_token', '{{ csrf_token('profile_photo')|e('js') }}');
                formData.append('cropped_image', base64);

                const resp = await fetch('{{ path('app_profile_photo_upload')|e('js') }}', {
                    method: 'POST',
                    body: formData,
                });

                const data = await resp.json();
                if (data.success) {
                    // Cache-bust the new photo URL
                    this.currentPhoto = data.photoUrl + '?t=' + Date.now();
                } else {
                    alert(data.error || 'Upload failed.');
                }
            } catch (err) {
                console.error('Photo upload error:', err);
                alert('Upload failed. Please try again.');
            } finally {
                this.uploading = false;
            }
        },

        async removePhoto() {
            if (!await window.confirmModal({ title: 'Remove your profile photo?', description: 'Your avatar will be reset to the default.', confirmLabel: 'Remove' })) return;

            this.uploading = true;
            try {
                const formData = new FormData();
                formData.append('_token', '{{ csrf_token('profile_photo')|e('js') }}');

                const resp = await fetch('{{ path('app_profile_photo_delete')|e('js') }}', {
                    method: 'POST',
                    body: formData,
                });

                const data = await resp.json();
                if (data.success) {
                    this.currentPhoto = null;
                } else {
                    alert(data.error || 'Failed to remove photo.');
                }
            } catch (err) {
                console.error('Photo delete error:', err);
                alert('Failed to remove photo.');
            } finally {
                this.uploading = false;
            }
        },
    }));
});

// ─── AI Profile Intelligence ──────────────────────────────────────────────
document.addEventListener('alpine:init', () => {
    Alpine.data('profileAI', () => ({
        status: 'idle',   // idle | debouncing | streaming | done
        streamBuffer: '',
        result: null,
        error: '',
        _debounceTimer: null,
        _csrfToken: '{{ csrf_token('profile_ai_analyze')|e('js') }}',
        _analyzeUrl: '{{ path('app_profile_ai_analyze')|e('js') }}',

        init() {
            // Watch bio, headline, and any skill/experience inputs for changes
            const watched = ['#bio', '[name="headline"]', '[name="first_name"]', '[name="last_name"]', '[name="location"]', '[name="website"]'];
            watched.forEach(sel => {
                document.querySelectorAll(sel).forEach(el => {
                    el.addEventListener('input', () => this._schedule());
                });
            });

            // Also watch dynamically-added skill inputs via event delegation
            document.addEventListener('input', e => {
                if (e.target.closest('#ai-profile-panel')) return; // ignore our own panel
                this._schedule();
            });
        },

        _schedule() {
            this.status = 'debouncing';
            clearTimeout(this._debounceTimer);
            this._debounceTimer = setTimeout(() => this.runAnalysis(), 2000);
        },

        triggerNow() {
            clearTimeout(this._debounceTimer);
            this.runAnalysis();
        },

        async runAnalysis() {
            this.status = 'streaming';
            this.streamBuffer = '';
            this.result = null;
            this.error = '';

            try {
                const body = new URLSearchParams({ _token: this._csrfToken });
                const resp = await fetch(this._analyzeUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString(),
                });

                if (!resp.ok) {
                    this.error = `Server error ${resp.status}`;
                    this.status = 'done';
                    return;
                }

                const reader = resp.body.getReader();
                const decoder = new TextDecoder();
                let rawJson = '';

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    const text = decoder.decode(value, { stream: true });
                    // Parse SSE lines: "data: {...}\n\n"
                    const lines = text.split('\n');
                    for (const line of lines) {
                        if (!line.startsWith('data: ')) continue;
                        const payload = line.slice(6).trim();
                        if (payload === '[DONE]') {
                            // Parse accumulated JSON
                            try {
                                this.result = JSON.parse(rawJson.trim());
                            } catch {
                                this.error = 'Could not parse AI response.';
                            }
                            this.status = 'done';
                            return;
                        }
                        try {
                            const obj = JSON.parse(payload);
                            if (obj.error) {
                                this.error = obj.error;
                                this.status = 'done';
                                return;
                            }
                            if (obj.token !== undefined) {
                                rawJson += obj.token;
                                this.streamBuffer += obj.token;
                            }
                        } catch { /* partial chunk — ignore */ }
                    }
                }

                // If stream ended without [DONE]
                if (!this.result && rawJson.trim()) {
                    try { this.result = JSON.parse(rawJson.trim()); } catch { /* */ }
                }
                this.status = 'done';

            } catch (err) {
                this.error = err.message || 'An unexpected error occurred.';
                this.status = 'done';
            }
        },

        copyToField(fieldName, value) {
            if (fieldName === 'bio') {
                const el = document.getElementById('bio');
                if (el) { el.value = value; el.dispatchEvent(new Event('input')); }
            } else if (fieldName === 'headline') {
                const el = document.querySelector('[name="headline"]');
                if (el) { el.value = value; el.dispatchEvent(new Event('input')); }
            }
        },
    }));
});
</script>
{% endblock %}
