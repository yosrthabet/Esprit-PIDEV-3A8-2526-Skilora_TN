{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Trainer Dashboard{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel flex flex-wrap items-center justify-between gap-4 p-8">
        <div>
            <p class="text-xs font-bold uppercase tracking-label text-primary">Trainer dashboard</p>
            <h1 class="mt-2 text-4xl font-light tracking-holographic">Manage your formation business.</h1>
            <p class="mt-2 text-muted-foreground">Create courses, structure modules, upload resources, and follow learner progress.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="{{ path('app_trainer_formation_new') }}" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Create formation</a>
            <a href="{{ path('app_trainer_formations') }}" class="rounded-xl border border-border px-5 py-3 text-sm font-bold">Manage catalog</a>
        </div>
    </section>
    <section class="grid gap-4 md:grid-cols-3">
        {% for stat in stats %}
            <article class="glass-panel p-5"><p class="text-3xl font-light">{{ stat.value }}</p><p class="mt-1 text-sm font-semibold">{{ stat.label }}</p><p class="text-xs text-muted-foreground">{{ stat.hint }}</p></article>
        {% endfor %}
    </section>
    <section class="glass-panel p-6">
        <div class="flex items-center justify-between gap-4"><h2 class="text-xl font-semibold">Recent formations</h2><a href="{{ path('app_trainer_formations') }}" class="text-sm font-bold text-primary">View all</a></div>
        <div class="mt-5 grid gap-4 lg:grid-cols-2">
            {% for formation in my_formations %}
                <article class="rounded-2xl border border-border bg-background/50 p-4">
                    <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-bold text-muted-foreground">{{ formation.status.value|title }}</span>
                    <h3 class="mt-3 text-lg font-semibold">{{ formation.title }}</h3>
                    <p class="mt-1 text-sm text-muted-foreground">{{ formation.modules|length }} modules · {{ formation.enrollments|length }} students</p>
                    <div class="mt-4 flex flex-wrap gap-2"><a href="{{ path('app_trainer_formation_edit', {id: formation.id}) }}" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">Edit</a><a href="{{ path('app_trainer_formation_modules', {id: formation.id}) }}" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">Modules</a></div>
                </article>
            {% else %}
                <p class="col-span-full text-sm text-muted-foreground">No formations yet. Create your first course to activate the trainer workspace.</p>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
