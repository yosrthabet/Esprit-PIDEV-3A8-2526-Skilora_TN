{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Trainer Dashboard{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8 animate-fade-in relative z-10">

    {# ── Hero ── #}
    <section class="glass-panel relative overflow-hidden p-8 sm:p-10">
        <div class="absolute -top-[30%] -right-[10%] w-[60%] h-[150%] rounded-full bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.08),transparent_70%)] pointer-events-none"></div>
        <div class="relative z-10 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
                <div class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-label text-emerald-600 dark:text-emerald-400 mb-5">
                    <span class="relative flex h-2 w-2 mr-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span>
                    Trainer workspace
                </div>
                <h1 class="text-4xl sm:text-5xl font-light tracking-holographic text-foreground leading-[1.1]">
                    Bon retour,<br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-teal-500 to-sky-500">{{ app.user.fullName ?: app.user.displayName }}</span>.
                </h1>
                <p class="mt-4 max-w-2xl text-lg text-muted-foreground leading-relaxed">
                    {% if my_formations|length > 0 %}
                        Vous gérez {{ my_formations|length }} formation{{ my_formations|length > 1 ? 's' : '' }} avec {{ stats[2].value|default(0) }} apprenants inscrits.
                    {% else %}
                        Créez votre première formation et commencez à partager votre expertise.
                    {% endif %}
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
                <a href="{{ path('app_trainer_formation_new') }}" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-foreground px-5 text-sm font-bold text-background shadow-sm transition hover:scale-[1.02]">
                    <i data-lucide="plus" class="h-4 w-4"></i> Nouvelle formation
                </a>
                <a href="{{ path('app_trainer_formations') }}" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-border/70 bg-background/70 px-5 text-sm font-semibold text-foreground transition hover:bg-muted">
                    <i data-lucide="library" class="h-4 w-4 text-muted-foreground"></i> Mon catalogue
                </a>
            </div>
        </div>
    </section>

    {# ── Stat Cards ── #}
    {% set statIcons = ['graduation-cap', 'layers', 'users', 'award'] %}
    {% set statColors = ['bg-emerald-500/10 text-emerald-500', 'bg-sky-500/10 text-sky-500', 'bg-violet-500/10 text-violet-500', 'bg-amber-500/10 text-amber-500'] %}
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {% for stat in stats %}
        <div class="glass-panel p-5 transition hover:border-primary/30">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl {{ statColors[loop.index0]|default('bg-muted text-muted-foreground') }}">
                <i data-lucide="{{ statIcons[loop.index0]|default('bar-chart') }}" class="h-5 w-5"></i>
            </div>
            <p class="mt-5 text-3xl font-light tracking-holographic text-foreground">{{ stat.value }}</p>
            <p class="mt-1 text-[10px] font-semibold uppercase tracking-label text-muted-foreground">{{ stat.label }}</p>
            <p class="mt-0.5 text-xs text-muted-foreground">{{ stat.hint }}</p>
        </div>
        {% endfor %}
    </section>

    {# ── Main Grid ── #}
    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">

        {# Recent Formations #}
        <section class="glass-panel overflow-hidden">
            <div class="flex items-center justify-between border-b border-border/40 px-6 py-4">
                <div>
                    <h2 class="text-sm font-semibold text-foreground">Mes formations</h2>
                    <p class="text-xs text-muted-foreground mt-0.5">Dernières formations créées</p>
                </div>
                <a href="{{ path('app_trainer_formations') }}" class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline">
                    Tout voir <i data-lucide="chevron-right" class="h-3 w-3"></i>
                </a>
            </div>
            <div class="divide-y divide-border/40">
                {% for formation in my_formations|slice(0, 5) %}
                <div class="flex items-center justify-between px-6 py-4 hover:bg-muted/40 transition-colors group">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2.5">
                            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-500">
                                <i data-lucide="book-open" class="h-4 w-4"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-foreground truncate">{{ formation.title }}</p>
                                <p class="text-xs text-muted-foreground">{{ formation.modules|length }} modules · {{ formation.enrollments|length }} apprenants</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 ml-4 shrink-0">
                        <span class="rounded-full px-2.5 py-0.5 text-[10px] font-bold
                            {% if formation.status.value == 'published' %}bg-emerald-500/10 text-emerald-600 dark:text-emerald-400
                            {% elseif formation.status.value == 'draft' %}bg-amber-500/10 text-amber-600 dark:text-amber-400
                            {% else %}bg-muted text-muted-foreground{% endif %}">
                            {{ formation.status.value|title }}
                        </span>
                        <a href="{{ path('app_trainer_formation_edit', {id: formation.id}) }}" class="opacity-0 group-hover:opacity-100 rounded-lg p-1.5 hover:bg-muted transition"><i data-lucide="pencil" class="h-3.5 w-3.5 text-muted-foreground"></i></a>
                        <a href="{{ path('app_trainer_formation_modules', {id: formation.id}) }}" class="opacity-0 group-hover:opacity-100 rounded-lg p-1.5 hover:bg-muted transition"><i data-lucide="layers" class="h-3.5 w-3.5 text-muted-foreground"></i></a>
                    </div>
                </div>
                {% else %}
                {% include 'components/_empty_state.html.twig' with {icon: 'graduation-cap', title: 'Aucune formation', description: 'Créez votre première formation pour activer votre espace formateur.', cta_label: 'Créer une formation', cta_route: 'app_trainer_formation_new'} %}
                {% endfor %}
            </div>
        </section>

        {# Quick Actions + Stats #}
        <div class="flex flex-col gap-6">
            {# Quick Actions #}
            <section class="glass-panel overflow-hidden">
                <div class="border-b border-border/40 px-6 py-4">
                    <h3 class="text-sm font-semibold text-foreground">Actions rapides</h3>
                </div>
                <div class="grid grid-cols-2 divide-x divide-y divide-border/40">
                    <a href="{{ path('app_trainer_formation_new') }}" class="flex items-center gap-3 px-4 py-3.5 hover:bg-muted/40 transition-colors">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500"><i data-lucide="plus-circle" class="h-4 w-4"></i></div>
                        <div><p class="text-xs font-medium text-foreground">Nouvelle formation</p><p class="text-[10px] text-muted-foreground">Créer un cours</p></div>
                    </a>
                    <a href="{{ path('app_formations') }}" class="flex items-center gap-3 px-4 py-3.5 hover:bg-muted/40 transition-colors">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-500/10 text-sky-500"><i data-lucide="library" class="h-4 w-4"></i></div>
                        <div><p class="text-xs font-medium text-foreground">Catalogue</p><p class="text-[10px] text-muted-foreground">Explorer les cours</p></div>
                    </a>
                    <a href="{{ path('app_learning') }}" class="flex items-center gap-3 px-4 py-3.5 hover:bg-muted/40 transition-colors">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-violet-500/10 text-violet-500"><i data-lucide="book-open" class="h-4 w-4"></i></div>
                        <div><p class="text-xs font-medium text-foreground">Apprentissage</p><p class="text-[10px] text-muted-foreground">Mes cours suivis</p></div>
                    </a>
                    <a href="{{ path('app_certificates') }}" class="flex items-center gap-3 px-4 py-3.5 hover:bg-muted/40 transition-colors">
                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500"><i data-lucide="award" class="h-4 w-4"></i></div>
                        <div><p class="text-xs font-medium text-foreground">Certificats</p><p class="text-[10px] text-muted-foreground">Attestations émises</p></div>
                    </a>
                </div>
            </section>

            {# Engagement Summary #}
            <section class="glass-panel p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-semibold text-foreground">Engagement</h3>
                    <span class="relative flex h-2.5 w-2.5">
                        <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 animate-ping"></span>
                        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                    </span>
                </div>
                <div class="space-y-4">
                    {% set total_students = stats[2].value|default(0) %}
                    {% set total_modules = stats[1].value|default(0) %}
                    <div>
                        <div class="flex items-center justify-between text-xs mb-1.5">
                            <span class="font-medium text-foreground">Apprenants actifs</span>
                            <span class="font-semibold text-emerald-500">{{ total_students }}</span>
                        </div>
                        <div class="h-1.5 w-full rounded-full bg-muted overflow-hidden">
                            <div class="h-full rounded-full bg-emerald-500 transition-all duration-700" style="width:{{ min(100, total_students * 3) }}%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex items-center justify-between text-xs mb-1.5">
                            <span class="font-medium text-foreground">Modules publiés</span>
                            <span class="font-semibold text-sky-500">{{ total_modules }}</span>
                        </div>
                        <div class="h-1.5 w-full rounded-full bg-muted overflow-hidden">
                            <div class="h-full rounded-full bg-sky-500 transition-all duration-700" style="width:{{ min(100, total_modules * 5) }}%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex items-center justify-between text-xs mb-1.5">
                            <span class="font-medium text-foreground">Formations</span>
                            <span class="font-semibold text-violet-500">{{ my_formations|length }}</span>
                        </div>
                        <div class="h-1.5 w-full rounded-full bg-muted overflow-hidden">
                            <div class="h-full rounded-full bg-violet-500 transition-all duration-700" style="width:{{ min(100, my_formations|length * 10) }}%"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

</div>
{% endblock %}
