{# auth/register.html.twig — Registration page with role selection #}
{% extends 'layouts/auth.html.twig' %}

{% block title %}Create Account — Skilora{% endblock %}

{% block auth_quote %}"Skilora helped me hire top freelancers and grow my business."{% endblock %}
{% block auth_attribution %}— Fatma, Startup Founder{% endblock %}

{% block content %}
<div class="glass-panel p-8 space-y-6">
    <div class="space-y-2">
        <h1 class="text-3xl font-light tracking-holographic text-foreground">Create an account</h1>
        <p class="text-sm text-muted-foreground">Join Skilora and unlock opportunities</p>
    </div>

    {% if errors is defined and errors %}
        {% for err in errors %}
            {{ include('components/alert.html.twig', {
                variant: 'destructive',
                body: err,
            }) }}
        {% endfor %}
    {% endif %}

    <form method="post" action="{{ path('app_register') }}" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
        {# Role selection — like JavaFX role picker #}
        <div class="space-y-2">
            {{ include('components/label.html.twig', { text: 'I am a...', required: true }) }}
            <div class="grid grid-cols-2 gap-2" x-data="{ role: '{{ last_role|default('USER') }}' }">
                <input type="hidden" name="role" :value="role">
                <button type="button" @click="role = 'USER'"
                    :class="role === 'USER' ? 'border-primary bg-primary/10 text-primary' : 'border-border text-muted-foreground hover:border-primary/50 hover:bg-muted/30'"
                    class="flex flex-col items-center gap-1.5 rounded-lg border-2 p-3 text-center transition-all cursor-pointer">
                    <i data-lucide="user" class="h-5 w-5"></i>
                    <span class="text-xs font-medium">Freelancer</span>
                </button>
                <button type="button" @click="role = 'EMPLOYER'"
                    :class="role === 'EMPLOYER' ? 'border-primary bg-primary/10 text-primary' : 'border-border text-muted-foreground hover:border-primary/50 hover:bg-muted/30'"
                    class="flex flex-col items-center gap-1.5 rounded-lg border-2 p-3 text-center transition-all cursor-pointer">
                    <i data-lucide="briefcase" class="h-5 w-5"></i>
                    <span class="text-xs font-medium">Client</span>
                </button>
            </div>
        </div>

        <div class="space-y-2">
            {{ include('components/label.html.twig', { for: 'full_name', text: 'Full Name', required: true }) }}
            {{ include('components/input.html.twig', {
                type: 'text',
                name: 'full_name',
                id: 'full_name',
                placeholder: 'Enter your full name',
                value: last_full_name|default(''),
                required: true,
            }) }}
        </div>

        <div class="space-y-2">
            {{ include('components/label.html.twig', { for: 'username', text: 'Username', required: true }) }}
            {{ include('components/input.html.twig', {
                type: 'text',
                name: 'username',
                id: 'username',
                placeholder: 'Choose a username',
                value: last_username|default(''),
                required: true,
            }) }}
        </div>

        <div class="space-y-2">
            {{ include('components/label.html.twig', { for: 'email', text: 'Email', required: true }) }}
            {{ include('components/input.html.twig', {
                type: 'email',
                name: 'email',
                id: 'email',
                placeholder: 'you@example.com',
                value: last_email|default(''),
                required: true,
            }) }}
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div class="space-y-2">
                {{ include('components/label.html.twig', { for: 'password', text: 'Password', required: true }) }}
                {{ include('components/password-input.html.twig', {
                    name: 'password',
                    id: 'password',
                    placeholder: '••••••••',
                    required: true,
                }) }}
            </div>
            <div class="space-y-2">
                {{ include('components/label.html.twig', { for: 'confirm_password', text: 'Confirm', required: true }) }}
                {{ include('components/password-input.html.twig', {
                    name: 'confirm_password',
                    id: 'confirm_password',
                    placeholder: '••••••••',
                    required: true,
                }) }}
            </div>
        </div>

        {{ include('components/button.html.twig', {
            type: 'submit',
            label: 'Create Account',
            variant: 'default',
            size: 'lg',
            class: 'w-full',
        }) }}
    </form>

    <p class="text-center text-sm text-muted-foreground">
        Already have an account?
        <a href="{{ path('app_login') }}" class="font-medium text-primary hover:underline">Sign in</a>
    </p>

    <div class="relative">
        <div class="absolute inset-0 flex items-center">
            <span class="w-full border-t border-border"></span>
        </div>
        <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-background px-2 text-muted-foreground">Or sign up with</span>
        </div>
    </div>

    <a href="{{ path('app_oauth_connect', {provider: 'github'}) }}"
       class="inline-flex h-10 w-full items-center justify-center gap-2 rounded-md border border-input bg-background text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        Sign up with GitHub
    </a>
</div>
{% endblock %}
