{% extends 'base.html.twig' %}

{% block title %}Case Studies — How Teams Win with Skilora{% endblock %}

{% block head %}
{{ parent() }}
<script>document.documentElement.classList.remove('dark');</script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-zinc-950 text-white">

    <section class="relative pt-32 pb-20 px-6 overflow-hidden">
        <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:80px_80px] pointer-events-none"></div>
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <p class="text-xs uppercase tracking-[0.3em] text-indigo-400 font-semibold mb-4">Case Studies</p>
            <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[0.95] mb-6">
                Real teams.<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-400">Real results.</span>
            </h1>
            <p class="text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
                See how leading Tunisian and international companies use Skilora to scale their teams and ship faster.
            </p>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 pb-24 space-y-12">
        {% for study in studies %}
        <div class="grid md:grid-cols-2 gap-8 items-center rounded-2xl border border-zinc-800 bg-zinc-900/20 overflow-hidden">
            <div class="h-64 md:h-80 overflow-hidden">
                <img src="{{ study.image }}" alt="{{ study.client }}" class="w-full h-full object-cover">
            </div>
            <div class="p-8 md:p-10">
                <div class="flex items-center gap-2 mb-4">
                    {% for tag in study.tags %}
                    <span class="px-2.5 py-1 rounded-md bg-indigo-500/10 text-indigo-400 text-xs font-semibold">{{ tag }}</span>
                    {% endfor %}
                </div>
                <p class="text-sm text-zinc-500 font-semibold uppercase tracking-wider mb-2">{{ study.client }}</p>
                <h3 class="text-2xl font-bold mb-4 leading-tight">{{ study.title }}</h3>
                <p class="text-zinc-400 leading-relaxed mb-6">{{ study.desc }}</p>
                <div class="flex gap-6">
                    {% for result in study.results %}
                    <div class="text-center">
                        <p class="text-xl font-black text-white">{{ result }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endfor %}
    </section>

    <section class="max-w-3xl mx-auto px-6 py-24 text-center border-t border-zinc-800/40">
        <h2 class="text-2xl font-bold mb-4">Want to be our next case study?</h2>
        <p class="text-zinc-400 mb-6">Share your Skilora success story and get featured on our platform.</p>
        <a href="mailto:partners@skilora.tn" class="inline-flex items-center justify-center px-8 py-3 rounded-full bg-indigo-600 text-white font-bold hover:bg-indigo-500 transition-colors">
            Get in Touch
        </a>
    </section>

    <footer class="bg-zinc-950 text-white border-t border-zinc-800 py-12 px-6">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="font-black text-xl tracking-tight">SKILORA</p>
            <p class="text-sm text-zinc-500">&copy; {{ 'now'|date('Y') }} Skilora. All rights reserved.</p>
        </div>
    </footer>
</div>
{% endblock %}
