{% extends 'base.html.twig' %}

{% block title %}Careers — Join the Skilora Team{% endblock %}

{% block head %}
{{ parent() }}
<script>document.documentElement.classList.remove('dark');</script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-zinc-950 text-white">

    <section class="relative pt-32 pb-20 px-6 overflow-hidden">
        <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:80px_80px] pointer-events-none"></div>
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <p class="text-xs uppercase tracking-[0.3em] text-indigo-400 font-semibold mb-4">Careers</p>
            <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[0.95] mb-6">
                Help us build the<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-400">future of work.</span>
            </h1>
            <p class="text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
                We're a small, ambitious team at ESPRIT reinventing how Tunisia's best talent connects with the world's best opportunities.
            </p>
        </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 pb-12">
        <div class="flex flex-wrap justify-center gap-4 mb-16">
            {% set perks = ['Remote-first','Competitive equity','Latest MacBook','Learning budget','Flexible hours','Team retreats'] %}
            {% for perk in perks %}
            <span class="px-4 py-2 rounded-full border border-zinc-700 bg-zinc-900/40 text-sm font-medium text-zinc-300">{{ perk }}</span>
            {% endfor %}
        </div>

        <h2 class="text-2xl font-bold mb-6">Open positions</h2>
        <div class="space-y-4">
            {% for pos in positions %}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-6 rounded-2xl border border-zinc-800 bg-zinc-900/20 hover:border-indigo-500/30 transition-colors">
                <div>
                    <h3 class="font-bold text-lg">{{ pos.title }}</h3>
                    <div class="flex items-center gap-3 mt-1 text-sm text-zinc-500">
                        <span>{{ pos.team }}</span>
                        <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
                        <span>{{ pos.location }}</span>
                        <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
                        <span>{{ pos.type }}</span>
                    </div>
                </div>
                <a href="mailto:careers@skilora.tn?subject=Application: {{ pos.title }}" class="shrink-0 inline-flex items-center justify-center px-6 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-500 transition-colors">
                    Apply Now
                </a>
            </div>
            {% endfor %}
        </div>
    </section>

    <section class="max-w-3xl mx-auto px-6 py-24 text-center border-t border-zinc-800/40">
        <h2 class="text-2xl font-bold mb-4">Don't see your role?</h2>
        <p class="text-zinc-400 mb-6">We're always looking for exceptional people. Send us your story.</p>
        <a href="mailto:careers@skilora.tn" class="inline-flex items-center justify-center px-8 py-3 rounded-full border border-zinc-700 text-white font-semibold hover:border-zinc-500 transition-colors">
            careers@skilora.tn
        </a>
    </section>

    <footer class="bg-zinc-950 text-white border-t border-zinc-800 py-12 px-6">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="font-black text-xl tracking-tight">SKILORA</p>
            <p class="text-sm text-zinc-500">&copy; {{ 'now'|date('Y') }} Skilora. All rights reserved.</p>
        </div>
    </footer>
</div>
{% endblock %}
