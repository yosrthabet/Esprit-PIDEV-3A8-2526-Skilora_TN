{% use 'form_div_layout.html.twig' %}

{% block form_row %}
<div class="mb-4">
    {{ form_label(form) }}
    {{ form_widget(form) }}
    {{ form_errors(form) }}
</div>
{% endblock %}

{% block form_label %}
{% if label is not same as(false) %}
<label{% if id %} for="{{ id }}"{% endif %} class="mb-1 block text-sm font-semibold text-foreground">{{ label|trans }}</label>
{% endif %}
{% endblock %}

{% block form_widget_simple %}
<input type="{{ type }}" {{ block('widget_attributes') }} {% if value is defined %}value="{{ value }}"{% endif %} class="h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm transition focus:border-primary focus:ring-1 focus:ring-primary" />
{% endblock %}

{% block textarea_widget %}
<textarea {{ block('widget_attributes') }} class="w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm transition focus:border-primary focus:ring-1 focus:ring-primary">{{ value }}</textarea>
{% endblock %}

{% block choice_widget_collapsed %}
<select {{ block('widget_attributes') }} class="h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm transition focus:border-primary">
    {% if placeholder is not none %}<option value="">{{ placeholder|trans }}</option>{% endif %}
    {% for choice in choices %}
        <option value="{{ choice.value }}" {% if choice.value == value %}selected{% endif %}>{{ choice.label|trans }}</option>
    {% endfor %}
</select>
{% endblock %}

{% block money_widget %}
<div class="relative">
    {{ block('form_widget_simple') }}
    <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-muted-foreground">{{ money_pattern|replace({'{{ widget }}': ''})|trim }}</span>
</div>
{% endblock %}

{% block form_errors %}
{% if errors|length > 0 %}
<ul class="mt-1 space-y-0.5">
    {% for error in errors %}
        <li class="text-xs text-destructive">{{ error.message }}</li>
    {% endfor %}
</ul>
{% endif %}
{% endblock %}

{% block button_widget %}
<button type="{{ type|default('submit') }}" {{ block('widget_attributes') }} class="inline-flex h-11 items-center justify-center rounded-xl bg-primary px-6 text-sm font-bold text-primary-foreground shadow-sm transition hover:bg-primary/90">{{ label|trans }}</button>
{% endblock %}
