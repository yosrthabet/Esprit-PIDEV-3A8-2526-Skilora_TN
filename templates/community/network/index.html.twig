{% extends 'layouts/adaptive.html.twig' %}

{% block page_title %}Community Network{% endblock %}

{% block content %}
<div class="mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 lg:px-8 animate-fade-in">
    <section class="glass-panel space-y-5 p-8">
        <div>
            <p class="text-xs font-bold uppercase tracking-label text-primary">Community network</p>
            <h1 class="mt-2 text-4xl font-light tracking-holographic">Build your trusted member network.</h1>
            <p class="mt-3 max-w-2xl text-sm text-muted-foreground">Send invitations, review requests, and manage accepted connections.</p>
        </div>
        {% include 'community/_tabs.html.twig' %}
    </section>

    <section class="grid gap-4 md:grid-cols-3">
        {% set pending_received = received_invitations|filter(invitation => invitation.pending)|length %}
        <div class="glass-panel p-5">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-500"><i data-lucide="users" class="h-5 w-5"></i></div>
            <p class="mt-4 text-3xl font-light tracking-holographic">{{ friends|length }}</p>
            <p class="mt-1 text-[10px] font-semibold uppercase tracking-label text-muted-foreground">Connections</p>
        </div>
        <div class="glass-panel p-5">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/10 text-amber-500"><i data-lucide="inbox" class="h-5 w-5"></i></div>
            <p class="mt-4 text-3xl font-light tracking-holographic">{{ pending_received }}</p>
            <p class="mt-1 text-[10px] font-semibold uppercase tracking-label text-muted-foreground">Pending received</p>
        </div>
        <div class="glass-panel p-5">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/10 text-sky-500"><i data-lucide="send" class="h-5 w-5"></i></div>
            <p class="mt-4 text-3xl font-light tracking-holographic">{{ sent_invitations|length }}</p>
            <p class="mt-1 text-[10px] font-semibold uppercase tracking-label text-muted-foreground">Sent invitations</p>
        </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="space-y-6">
            <section class="glass-panel p-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <h2 class="text-xl font-semibold">Find members</h2>
                        <p class="text-sm text-muted-foreground">Admins, existing connections, and pending pairs are excluded.</p>
                    </div>
                </div>
                <div class="mt-5 grid gap-3 sm:grid-cols-2">
                    {% for member in suggestions %}
                        <article class="rounded-2xl border border-border bg-background/60 p-4 hover:border-primary/30 transition">
                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-bold">{{ member.displayName|split(' ')|map(w => w|first)|join('')|upper }}</div>
                                <div>
                                    <p class="font-semibold">{{ member.displayName }}</p>
                                    <p class="text-xs text-muted-foreground">{{ member.roleDisplayName }}</p>
                                </div>
                            </div>
                            <form method="post" action="{{ path('app_community_invitation_send', {userId: member.id}) }}" class="mt-4 space-y-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('community_invitation_send_' ~ member.id) }}">
                                <textarea name="note" rows="2" maxlength="500" placeholder="Optional note" class="w-full rounded-xl border border-border bg-background/70 px-3 py-2 text-sm"></textarea>
                                <button class="rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Send invitation</button>
                            </form>
                        </article>
                    {% else %}
                        <p class="rounded-2xl border border-border bg-background/60 p-5 text-sm text-muted-foreground sm:col-span-2">No available members to invite right now.</p>
                    {% endfor %}
                </div>
            </section>

            <section class="glass-panel p-6">
                <h2 class="text-xl font-semibold">My connections</h2>
                <div class="mt-5 grid gap-3 sm:grid-cols-2">
                    {% for friend in friends %}
                        <article class="rounded-2xl border border-border bg-background/60 p-4 hover:border-primary/30 transition">
                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary text-sm font-bold">{{ friend.displayName|split(' ')|map(w => w|first)|join('')|upper }}</div>
                                <div>
                                    <p class="font-semibold">{{ friend.displayName }}</p>
                                    <p class="text-xs text-muted-foreground">{{ friend.roleDisplayName }}</p>
                                </div>
                            </div>
                        </article>
                    {% else %}
                        <p class="rounded-2xl border border-border bg-background/60 p-5 text-sm text-muted-foreground sm:col-span-2">Accepted invitations will appear here.</p>
                    {% endfor %}
                </div>
            </section>
        </div>

        <div class="space-y-6">
            <section class="glass-panel p-6">
                <h2 class="text-xl font-semibold">Received requests</h2>
                <div class="mt-5 space-y-3">
                    {% for invitation in received_invitations %}
                        <article class="rounded-2xl border border-border bg-background/60 p-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="font-semibold">{{ invitation.inviter.displayName }}</p>
                                    <p class="text-xs text-muted-foreground">{{ invitation.createdAt|date('M d, Y H:i') }}</p>
                                </div>
                                <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-bold text-muted-foreground">{{ invitation.status.label }}</span>
                            </div>
                            {% if invitation.note %}
                                <p class="mt-3 whitespace-pre-line rounded-xl bg-muted/40 p-3 text-sm text-muted-foreground">{{ invitation.note }}</p>
                            {% endif %}
                            {% if invitation.pending %}
                                <div class="mt-4 flex flex-wrap gap-2">
                                    <form method="post" action="{{ path('app_community_invitation_accept', {id: invitation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('community_invitation_accept_' ~ invitation.id) }}">
                                        <button class="rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Accept</button>
                                    </form>
                                    <form method="post" action="{{ path('app_community_invitation_decline', {id: invitation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('community_invitation_decline_' ~ invitation.id) }}">
                                        <button class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Decline</button>
                                    </form>
                                </div>
                            {% endif %}
                        </article>
                    {% else %}
                        <p class="rounded-2xl border border-border bg-background/60 p-5 text-sm text-muted-foreground">No received requests.</p>
                    {% endfor %}
                </div>
            </section>

            <section class="glass-panel p-6">
                <h2 class="text-xl font-semibold">Sent requests</h2>
                <div class="mt-5 space-y-3">
                    {% for invitation in sent_invitations %}
                        <article class="rounded-2xl border border-border bg-background/60 p-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="font-semibold">{{ invitation.invitee.displayName }}</p>
                                    <p class="text-xs text-muted-foreground">{{ invitation.createdAt|date('M d, Y H:i') }}</p>
                                </div>
                                <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-bold text-muted-foreground">{{ invitation.status.label }}</span>
                            </div>
                            {% if invitation.pending %}
                                <form method="post" action="{{ path('app_community_invitation_cancel', {id: invitation.id}) }}" class="mt-4">
                                    <input type="hidden" name="_token" value="{{ csrf_token('community_invitation_cancel_' ~ invitation.id) }}">
                                    <button class="rounded-xl border border-border px-4 py-2 text-sm font-bold text-destructive">Cancel</button>
                                </form>
                            {% endif %}
                        </article>
                    {% else %}
                        <p class="rounded-2xl border border-border bg-background/60 p-5 text-sm text-muted-foreground">No sent requests.</p>
                    {% endfor %}
                </div>
            </section>
        </div>
    </section>
</div>
{% endblock %}
