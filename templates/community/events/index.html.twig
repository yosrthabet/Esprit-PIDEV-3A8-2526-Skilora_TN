{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Community Events{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel flex flex-wrap items-center justify-between gap-4 p-8">
        <div><p class="text-xs font-bold uppercase tracking-label text-primary">Events</p><h1 class="mt-2 text-4xl font-light tracking-holographic">Meet, learn, collaborate.</h1></div>
        {% if not app.user.admin %}<a href="{{ path('app_community_event_new') }}" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">New event</a>{% endif %}
        <div class="w-full">{% include 'community/_tabs.html.twig' %}</div>
    </section>
    <section class="grid gap-4 lg:grid-cols-2">
        {% for event in events %}
            <a href="{{ path('app_community_event_show', {id: event.id}) }}" class="glass-panel p-5 transition hover:border-primary/40">
                <p class="text-xs font-bold text-primary">{{ event.startsAt|date('M d, Y H:i') }}</p>
                <h2 class="mt-3 text-xl font-semibold">{{ event.title }}</h2>
                <p class="mt-2 text-sm text-muted-foreground">{{ event.location ?: 'Online' }} · {{ event.rsvpsCount }} going</p>
            </a>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No events yet.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
