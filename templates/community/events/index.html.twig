{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Community Events{% endblock %}
{% block content %}
{% set total_rsvps = events|reduce((c, e) => c + e.rsvpsCount, 0) %}

<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# ── Hero ── #}
    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(34,197,94,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-green-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_20rem] lg:items-end">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Community events</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Meet, learn,<br class="hidden sm:block"> collaborate.</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">Discover meetups, webinars, and conferences organized by the community.</p>
                <div class="mt-6 flex flex-wrap gap-2">
                    {% if not app.user.admin %}
                        <a href="{{ path('app_community_event_new') }}" class="rounded-full bg-white px-4 py-2 text-sm font-bold text-black shadow-sm transition hover:shadow-md">
                            <i data-lucide="calendar-plus" class="mr-1.5 inline h-3.5 w-3.5"></i> New event
                        </a>
                    {% endif %}
                    <a href="{{ path('app_community') }}" class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur transition hover:bg-white/15">Feed</a>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ events|length }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Events</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ total_rsvps }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">RSVPs</p>
                </div>
            </div>
        </div>
    </section>

    {# ── Tabs ── #}
    <section class="flex flex-wrap items-center gap-3">
        {% include 'community/_tabs.html.twig' %}
    </section>

    {# ── Events grid ── #}
    <section class="grid gap-4 lg:grid-cols-2">
        {% for event in events %}
            <a href="{{ path('app_community_event_show', {id: event.id}) }}" class="group rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-xl">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="text-[11px] font-black uppercase tracking-[0.15em] text-primary">{{ event.startsAt|date('M d, Y · H:i') }}</p>
                        <h2 class="mt-3 text-xl font-bold text-foreground group-hover:text-primary transition-colors">{{ event.title }}</h2>
                        <p class="mt-2 text-sm text-muted-foreground">{{ event.location ?: 'Online' }}</p>
                    </div>
                    <span class="rounded-full bg-muted px-2.5 py-1 text-[11px] font-black shrink-0">{{ event.rsvpsCount }} going</span>
                </div>
            </a>
        {% else %}
            <div class="col-span-full rounded-[1.75rem] border border-dashed border-border bg-card/50 p-12 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-muted">
                    <i data-lucide="calendar" class="h-8 w-8 text-muted-foreground/50"></i>
                </div>
                <p class="mt-4 text-sm font-bold">No events yet</p>
                <p class="mt-1.5 text-xs text-muted-foreground">Create the first community event.</p>
                {% if not app.user.admin %}
                    <a href="{{ path('app_community_event_new') }}" class="mt-4 inline-flex rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground shadow-sm">New event</a>
                {% endif %}
            </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
