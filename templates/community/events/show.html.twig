{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ event.title }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Community event</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">{{ event.title }}</h1>
        <p class="mt-3 text-muted-foreground">{{ event.description ?: 'No description yet.' }}</p>
        <p class="mt-4 text-sm text-muted-foreground">{{ event.startsAt|date('M d, Y H:i') }} · {{ event.location ?: 'Online' }} · Hosted by {{ event.host.displayName }}</p>
        {% if event.onlineUrl %}<a href="{{ event.onlineUrl }}" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-sm font-bold text-primary">Open event link</a>{% endif %}
        {% if not app.user.admin and not rsvp %}
            <form method="post" action="{{ path('app_community_event_rsvp', {id: event.id}) }}" class="mt-5">
                <input type="hidden" name="_token" value="{{ csrf_token('community_event_rsvp_' ~ event.id) }}">
                <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">I'm going</button>
            </form>
        {% elseif rsvp %}
            <span class="mt-5 inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">You're going</span>
        {% endif %}
    </section>
</div>
{% endblock %}
