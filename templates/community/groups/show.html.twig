{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ group.name }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Community group</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">{{ group.name }}</h1>
        <p class="mt-3 text-muted-foreground">{{ group.description ?: 'No description yet.' }}</p>
        <p class="mt-3 text-sm text-muted-foreground">{{ group.membersCount }} members · Owner {{ group.owner.displayName }}</p>
        {% if not app.user.admin and not membership %}
            <form method="post" action="{{ path('app_community_group_join', {id: group.id}) }}" class="mt-5">
                <input type="hidden" name="_token" value="{{ csrf_token('community_group_join_' ~ group.id) }}">
                <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Join group</button>
            </form>
        {% elseif membership %}
            <span class="mt-5 inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">Member</span>
        {% endif %}
    </section>
</div>
{% endblock %}
