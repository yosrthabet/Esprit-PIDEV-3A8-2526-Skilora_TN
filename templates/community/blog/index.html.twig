{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Community Blog{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel flex flex-wrap items-center justify-between gap-4 p-8">
        <div><p class="text-xs font-bold uppercase tracking-label text-primary">Blog</p><h1 class="mt-2 text-4xl font-light tracking-holographic">Long-form community knowledge.</h1></div>
        {% if not app.user.admin %}<a href="{{ path('app_community_blog_new') }}" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">New article</a>{% endif %}
        <div class="w-full">{% include 'community/_tabs.html.twig' %}</div>
    </section>
    <section class="grid gap-4 lg:grid-cols-3">
        {% for article in articles %}
            <a href="{{ path('app_community_blog_show', {slug: article.slug}) }}" class="glass-panel p-5 transition hover:border-primary/40">
                <p class="text-xs text-muted-foreground">{{ article.publishedAt ? article.publishedAt|date('M d, Y') : article.createdAt|date('M d, Y') }} · {{ article.author.displayName }}</p>
                <h2 class="mt-3 text-xl font-semibold">{{ article.title }}</h2>
                <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">{{ article.excerpt ?: article.content|slice(0, 160) }}</p>
            </a>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No articles yet.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
