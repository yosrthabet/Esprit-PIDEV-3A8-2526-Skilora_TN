{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ article.title }}{% endblock %}
{% block content %}
<article class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Community blog</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">{{ article.title }}</h1>
        <p class="mt-3 text-sm text-muted-foreground">By {{ article.author.displayName }} · {{ article.publishedAt ? article.publishedAt|date('M d, Y') : article.createdAt|date('M d, Y') }}</p>
    </section>
    <section class="glass-panel p-8">
        <p class="whitespace-pre-line text-sm leading-7 text-foreground">{{ article.content }}</p>
    </section>
</article>
{% endblock %}
