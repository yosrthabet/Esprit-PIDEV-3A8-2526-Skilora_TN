{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}New Community Post{% endblock %}
{% block content %}
<div class="mx-auto max-w-3xl px-4 py-6 sm:px-6 lg:px-8">
    <form method="post" class="glass-panel space-y-5 p-8">
        <div>
            <p class="text-xs font-bold uppercase tracking-label text-primary">Community</p>
            <h1 class="mt-2 text-3xl font-light tracking-holographic">Start a discussion</h1>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('community_post_new') }}">
        <textarea name="content" rows="8" required placeholder="Share an update, question, opportunity, or learning note..." class="w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm"></textarea>
        <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Publish post</button>
    </form>
</div>
{% endblock %}
