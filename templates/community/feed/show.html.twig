{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Community Thread{% endblock %}
{% block content %}
<div class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <article class="glass-panel p-6">
        <div class="flex items-center justify-between gap-3">
            <div>
                <p class="font-semibold">{{ post.author.displayName }}</p>
                <p class="text-xs text-muted-foreground">{{ post.createdAt|date('M d, Y H:i') }}</p>
            </div>
            <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-bold text-muted-foreground">{{ post.status.label }}</span>
        </div>
        <p class="mt-5 whitespace-pre-line text-sm leading-6">{{ post.content }}</p>
        <div class="mt-5 flex flex-wrap gap-2">
            {% if not app.user.admin and post.visible %}
                <form method="post" action="{{ path('app_community_post_like', {id: post.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('community_like_' ~ post.id) }}">
                    <button class="rounded-xl border border-border px-4 py-2 text-sm font-bold">{{ liked ? 'Unlike' : 'Like' }} · {{ post.likesCount }}</button>
                </form>
            {% endif %}
            {% if app.user.admin or app.user.id == post.author.id %}
                <form method="post" action="{{ path('app_community_post_delete', {id: post.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('community_delete_' ~ post.id) }}">
                    <button class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Delete</button>
                </form>
            {% endif %}
        </div>
    </article>

    <section class="glass-panel p-6">
        <h2 class="text-xl font-semibold">Comments</h2>
        {% if not app.user.admin and post.visible %}
            <form method="post" action="{{ path('app_community_post_comment', {id: post.id}) }}" class="mt-4 flex gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('community_comment_' ~ post.id) }}">
                <input name="content" required placeholder="Write a reply..." class="h-11 flex-1 rounded-xl border border-border bg-background/70 px-4 text-sm">
                <button class="rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground">Reply</button>
            </form>
        {% endif %}
        <div class="mt-5 space-y-3">
            {% for comment in post.comments %}
                <article class="rounded-2xl border border-border bg-background/50 p-4">
                    <div class="flex items-center justify-between gap-3">
                        <span class="font-semibold">{{ comment.author.displayName }}</span>
                        <span class="text-xs text-muted-foreground">{{ comment.createdAt|date('M d, Y H:i') }}</span>
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground">{{ comment.content }}</p>
                </article>
            {% else %}
                <p class="text-sm text-muted-foreground">No replies yet.</p>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
