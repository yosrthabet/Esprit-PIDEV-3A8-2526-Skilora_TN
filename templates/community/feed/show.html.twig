{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Community Thread{% endblock %}
{% block content %}
<div class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    {% include 'components/_breadcrumbs.html.twig' with {items: [{label: 'Community', route: 'app_community'}, {label: 'Thread'}]} %}

    <article class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm sm:p-6">
        <div class="flex items-start gap-4">
            {% set initials = post.author.displayName|split(' ')|map(w => w|first)|join('')|upper %}
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-muted text-sm font-black text-muted-foreground">{{ initials }}</div>
            <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="font-bold text-foreground">{{ post.author.displayName }}</p>
                        <p class="mt-0.5 text-[11px] text-muted-foreground">{{ post.createdAt|date('M d, Y · H:i') }} · {{ post.visibility.value|title }}</p>
                    </div>
                    <span class="rounded-full bg-muted px-2.5 py-1 text-[10px] font-black uppercase tracking-wide text-muted-foreground">{{ post.status.label }}</span>
                </div>
                <p class="mt-4 whitespace-pre-line text-[15px] leading-relaxed text-foreground/90">{{ post.content }}</p>
                {% if post.mediaPath %}<img src="{{ asset(post.mediaPath) }}" alt="Community post image" class="mt-4 max-h-[32rem] w-full rounded-2xl object-cover">{% endif %}
                {# Reaction summary #}
                {% set total_reactions = 0 %}
                {% for type in reaction_types %}
                    {% set total_reactions = total_reactions + reaction_counts[type.value]|default(0) %}
                {% endfor %}
                {% if total_reactions > 0 %}
                <div class="mt-4 flex items-center gap-1 text-xs text-muted-foreground">
                    <span class="flex items-center -space-x-1">
                        {% for type in reaction_types %}
                            {% if reaction_counts[type.value]|default(0) > 0 %}
                            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full border-2 border-card
                                {{ type.value == 'like' ? 'bg-blue-500' : '' }}{{ type.value == 'heart' ? 'bg-red-500' : '' }}{{ type.value == 'laugh' ? 'bg-amber-400' : '' }}{{ type.value == 'fire' ? 'bg-orange-500' : '' }}{{ type.value == 'clap' ? 'bg-green-500' : '' }}{{ type.value == 'wow' ? 'bg-purple-500' : '' }}
                                text-white" title="{{ type.value|title }}">
                                <i data-lucide="{{ type.value == 'like' ? 'thumbs-up' : '' }}{{ type.value == 'heart' ? 'heart' : '' }}{{ type.value == 'laugh' ? 'laugh' : '' }}{{ type.value == 'fire' ? 'flame' : '' }}{{ type.value == 'clap' ? 'hand-metal' : '' }}{{ type.value == 'wow' ? 'star' : '' }}" class="h-3 w-3"></i>
                            </span>
                            {% endif %}
                        {% endfor %}
                    </span>
                    <span class="ml-1">{{ total_reactions }}</span>
                    {% if my_reaction %}<span>· You reacted</span>{% endif %}
                </div>
                {% endif %}

                <div class="mt-3 flex items-center border-t border-border/40 pt-2">
                    {% if not app.user.admin and post.visible %}
                        {# Like with reaction picker #}
                        <div class="reaction-wrapper relative flex-1"
                             x-data="{ flyout: false, holdTimer: null }"
                             @mouseenter="holdTimer = setTimeout(() => { flyout = true }, 500)"
                             @mouseleave="clearTimeout(holdTimer); flyout = false"
                             @touchstart.passive="holdTimer = setTimeout(() => { flyout = true }, 400)"
                             @touchend="clearTimeout(holdTimer)">
                            <form method="post" action="{{ path('app_community_post_react', {id: post.id, type: 'like'}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('community_react_' ~ post.id) }}">
                                <button type="submit"
                                        class="inline-flex w-full items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-muted
                                               {{ my_reaction == 'like' ? 'text-blue-600 dark:text-blue-400' : '' }}{{ my_reaction == 'heart' ? 'text-red-500' : '' }}{{ my_reaction == 'laugh' ? 'text-amber-500' : '' }}{{ my_reaction == 'fire' ? 'text-orange-500' : '' }}{{ my_reaction == 'clap' ? 'text-green-600 dark:text-green-400' : '' }}{{ my_reaction == 'wow' ? 'text-purple-500' : '' }}{{ not my_reaction ? 'text-muted-foreground' : '' }}">
                                    {% if my_reaction == 'like' %}<i data-lucide="thumbs-up" class="h-4 w-4"></i> Like
                                    {% elseif my_reaction == 'heart' %}<i data-lucide="heart" class="h-4 w-4 fill-current"></i> Love
                                    {% elseif my_reaction == 'laugh' %}<i data-lucide="laugh" class="h-4 w-4"></i> Haha
                                    {% elseif my_reaction == 'fire' %}<i data-lucide="flame" class="h-4 w-4 fill-current"></i> Fire
                                    {% elseif my_reaction == 'clap' %}<i data-lucide="hand-metal" class="h-4 w-4"></i> Clap
                                    {% elseif my_reaction == 'wow' %}<i data-lucide="star" class="h-4 w-4"></i> Wow
                                    {% else %}<i data-lucide="thumbs-up" class="h-4 w-4"></i> Like
                                    {% endif %}
                                </button>
                            </form>
                            <div x-show="flyout" x-transition x-cloak @click.away="flyout = false"
                                 class="absolute -top-14 left-0 z-40 flex items-center gap-1 rounded-full border border-border bg-popover px-2 py-1.5 shadow-xl">
                                {% for type in reaction_types %}
                                <form method="post" action="{{ path('app_community_post_react', {id: post.id, type: type.value}) }}" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('community_react_' ~ post.id) }}">
                                    <button type="submit" @click="flyout = false" title="{{ type.value|title }}"
                                            class="flex h-9 w-9 items-center justify-center rounded-full transition-all duration-200 hover:scale-125 hover:bg-muted
                                                   {{ my_reaction == type.value ? 'scale-110 ring-2 ring-primary/30 bg-primary/10' : '' }}
                                                   {{ type.value == 'like' ? 'text-blue-600 dark:text-blue-400' : '' }}{{ type.value == 'heart' ? 'text-red-500' : '' }}{{ type.value == 'laugh' ? 'text-amber-500' : '' }}{{ type.value == 'fire' ? 'text-orange-500' : '' }}{{ type.value == 'clap' ? 'text-green-600 dark:text-green-400' : '' }}{{ type.value == 'wow' ? 'text-purple-500' : '' }}">
                                        <i data-lucide="{{ type.value == 'like' ? 'thumbs-up' : '' }}{{ type.value == 'heart' ? 'heart' : '' }}{{ type.value == 'laugh' ? 'laugh' : '' }}{{ type.value == 'fire' ? 'flame' : '' }}{{ type.value == 'clap' ? 'hand-metal' : '' }}{{ type.value == 'wow' ? 'star' : '' }}" class="h-5 w-5"></i>
                                    </button>
                                </form>
                                {% endfor %}
                            </div>
                        </div>

                        <form method="post" action="{{ path('app_community_post_bookmark', {id: post.id}) }}" class="flex-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('community_bookmark_' ~ post.id) }}">
                            <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-muted {{ bookmarked ? 'text-primary' : 'text-muted-foreground' }}">
                                <i data-lucide="{{ bookmarked ? 'bookmark-check' : 'bookmark' }}" class="h-4 w-4"></i>
                                {{ bookmarked ? 'Saved' : 'Save' }}
                            </button>
                        </form>
                        <form method="post" action="{{ path('app_community_post_share', {id: post.id}) }}" class="flex-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('community_share_' ~ post.id) }}">
                            <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-muted-foreground transition-colors hover:bg-muted">
                                <i data-lucide="repeat-2" class="h-4 w-4"></i>
                                Share{{ post.sharesCount > 0 ? ' · ' ~ post.sharesCount : '' }}
                            </button>
                        </form>
                    {% endif %}
                    {% if app.user.admin or app.user.id == post.author.id %}
                        {% include 'components/_confirm_modal.html.twig' with {
                            trigger_label: 'Delete post',
                            title: 'Delete this post?',
                            description: 'This post and all its comments will be permanently removed.',
                            action_url: path('app_community_post_delete', {id: post.id}),
                            csrf_token: csrf_token('community_delete_' ~ post.id)
                        } %}
                    {% elseif not app.user.admin %}
                        <details class="relative">
                            <summary class="cursor-pointer rounded-full border border-border bg-background/80 px-3 py-1.5 text-xs font-bold">Report</summary>
                            <form method="post" action="{{ path('app_community_post_report', {id: post.id}) }}" class="absolute right-0 z-20 mt-2 w-72 rounded-2xl border border-border bg-popover p-3 shadow-xl">
                                <input type="hidden" name="_token" value="{{ csrf_token('community_report_' ~ post.id) }}">
                                <input name="reason" placeholder="Reason" class="mb-2 w-full rounded-xl border border-border bg-background px-3 py-2 text-xs">
                                <textarea name="details" rows="3" placeholder="Optional details" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs"></textarea>
                                <button class="mt-2 rounded-full bg-destructive px-3 py-1.5 text-xs font-bold text-destructive-foreground">Send report</button>
                            </form>
                        </details>
                    {% endif %}
                </div>
            </div>
        </div>
    </article>

    <section class="rounded-[1.75rem] border border-border/70 bg-card/70 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-border/40">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Replies · {{ post.commentsCount }}</h2>
        </div>

        {% if not app.user.admin and post.visible %}
        <div class="border-b border-border/40 px-5 py-4">
            <form method="post" action="{{ path('app_community_post_comment', {id: post.id}) }}" class="flex items-center gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('community_comment_' ~ post.id) }}">
                <input name="content" required placeholder="Write a reply..." class="h-10 flex-1 rounded-2xl border border-border bg-background/70 px-4 text-sm transition focus:border-primary focus:ring-2 focus:ring-primary/10">
                <button class="rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Reply</button>
            </form>
        </div>
        {% endif %}

        <div class="divide-y divide-border/30">
            {% for comment in comments %}
            <div class="px-5 py-4 transition hover:bg-muted/20">
                <div class="flex items-start gap-3">
                    {% set c_initials = comment.author.displayName|split(' ')|map(w => w|first)|join('')|upper %}
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-muted text-[10px] font-black text-muted-foreground">{{ c_initials }}</div>
                    <div class="min-w-0 flex-1">
                        <div class="rounded-2xl bg-muted/40 px-4 py-3">
                            <div class="flex items-center justify-between gap-2"><p class="text-sm font-bold text-foreground">{{ comment.author.displayName }}</p><p class="text-[10px] text-muted-foreground shrink-0">{{ comment.createdAt|date('M d, H:i') }}</p></div>
                            <p class="mt-1.5 text-sm leading-relaxed text-foreground/90">{{ comment.content }}</p>
                        </div>
                        {% if not app.user.admin and post.visible %}
                        <form method="post" action="{{ path('app_community_post_comment', {id: post.id}) }}" class="mt-2 flex gap-2 pl-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('community_comment_' ~ post.id) }}">
                            <input type="hidden" name="parent_id" value="{{ comment.id }}">
                            <input name="content" placeholder="Reply to {{ comment.author.displayName }}..." class="h-8 flex-1 rounded-xl border border-border bg-background/70 px-3 text-xs">
                            <button class="rounded-full border border-border px-3 text-xs font-bold">Reply</button>
                        </form>
                        {% endif %}
                        {% for reply in comment.replies %}
                        <div class="mt-3 flex items-start gap-3 pl-6">
                            {% set r_initials = reply.author.displayName|split(' ')|map(w => w|first)|join('')|upper %}
                            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-muted text-[9px] font-black text-muted-foreground">{{ r_initials }}</div>
                            <div class="min-w-0 flex-1 rounded-2xl bg-background/70 px-4 py-3"><p class="text-xs font-bold">{{ reply.author.displayName }}</p><p class="mt-1 text-sm">{{ reply.content }}</p></div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% else %}
            <div class="rounded-[1.4rem] border border-dashed border-border bg-background/50 m-4 p-8 text-center text-xs text-muted-foreground">No replies yet. Be the first to respond.</div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
