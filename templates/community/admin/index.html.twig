{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Community Moderation{% endblock %}
{% block content %}
{% set pending_count = posts|filter(p => p.status.value|default('pending') == 'pending')|length %}
{% set approved_count = posts|filter(p => p.status.value|default('') == 'approved')|length %}
{% set rejected_count = posts|filter(p => p.status.value|default('') == 'rejected')|length %}
{% set reported_count = posts|filter(p => p.reportsCount|default(0) > 0)|length %}

<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {% include 'components/_breadcrumbs.html.twig' with {items: [{label: 'Dashboard', route: 'app_dashboard'}, {label: 'Community Moderation'}]} %}

    {# ── Hero ── #}
    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(251,191,36,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-amber-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_28rem] lg:items-end">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Admin moderation</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Community<br class="hidden sm:block"> supervision.</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">Review posts, approve valid content, or reject problematic threads.</p>
            </div>
            <div class="grid grid-cols-4 gap-3">
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ pending_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Pending</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ approved_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Approved</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ rejected_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Rejected</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ reported_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Reported</p>
                </div>
            </div>
        </div>
    </section>

    {# ── Moderation queue ── #}
    <section class="space-y-4">
        {% for post in posts %}
        <article x-data="{ showPreview: false }" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm transition-all hover:border-primary/30">
            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3 min-w-0">
                    {% set initials = post.author.displayName|split(' ')|map(w => w|first)|join('')|upper %}
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-muted text-sm font-black text-muted-foreground">
                        {{ initials }}
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2">
                            <p class="font-bold text-foreground truncate">{{ post.author.displayName }}</p>
                            <span class="rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wide
                                {% if post.status.value|default(post.status.label|default('pending')) == 'approved' %}bg-emerald-500/10 text-emerald-600 dark:text-emerald-400
                                {% elseif post.status.value|default(post.status.label|default('pending')) == 'rejected' %}bg-rose-500/10 text-rose-600 dark:text-rose-400
                                {% else %}bg-amber-500/10 text-amber-600 dark:text-amber-400{% endif %}">
                                {{ post.status.label }}
                            </span>
                        </div>
                        <p class="mt-0.5 text-[11px] text-muted-foreground">{{ post.createdAt|date('M d, Y · H:i') }} · {{ post.likesCount|default(0) }} reactions · {{ post.commentsCount|default(0) }} comments · {{ post.sharesCount|default(0) }} shares · {{ post.reportsCount|default(0) }} reports</p>
                    </div>
                </div>
                <button @click="showPreview = !showPreview" class="shrink-0 rounded-full border border-border px-3 py-1.5 text-xs font-bold hover:bg-muted transition">
                    <span x-text="showPreview ? 'Collapse' : 'Preview'"></span>
                </button>
            </div>

            <div x-show="showPreview" x-transition class="mt-4 rounded-2xl border border-border/50 bg-background/50 p-4">
                <p class="whitespace-pre-line text-sm leading-relaxed text-foreground">{{ post.content }}</p>
            </div>

            {% if not showPreview is defined or true %}
            <p class="mt-3 text-sm text-muted-foreground line-clamp-2">{{ post.content|slice(0, 200) }}{% if post.content|length > 200 %}…{% endif %}</p>
            {% endif %}

            {% if post.moderationReason %}
                <div class="mt-3 flex items-center gap-2 rounded-2xl bg-rose-500/5 border border-rose-500/20 px-3 py-2 text-xs text-rose-600 dark:text-rose-400">
                    <i data-lucide="alert-circle" class="h-3.5 w-3.5 shrink-0"></i> {{ post.moderationReason }}
                </div>
            {% endif %}

            <div class="mt-4 flex flex-wrap items-center gap-2">
                <form method="post" action="{{ path('app_admin_community_post_approve', {id: post.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_community_approve_' ~ post.id) }}">
                    <button class="rounded-full bg-emerald-600 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-700 hover:shadow-md">
                        <i data-lucide="check" class="mr-1 inline h-3.5 w-3.5"></i> Approve
                    </button>
                </form>
                <form method="post" action="{{ path('app_admin_community_post_reject', {id: post.id}) }}" class="flex items-center gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_community_reject_' ~ post.id) }}">
                    <input name="reason" placeholder="Rejection reason…" class="h-10 w-48 rounded-2xl border border-border bg-background/70 px-3 text-sm placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-primary/10 transition">
                    <button class="rounded-full border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-950/30 px-4 py-2 text-sm font-bold text-red-600 dark:text-red-400 transition hover:bg-red-100 dark:hover:bg-red-900/40">
                        <i data-lucide="x" class="mr-1 inline h-3.5 w-3.5"></i> Reject
                    </button>
                </form>
                <a href="{{ path('app_community_post_show', {id: post.id}) }}" class="ml-auto rounded-full border border-border px-3.5 py-1.5 text-xs font-bold hover:bg-muted transition">
                    Open thread →
                </a>
            </div>
        </article>
        {% else %}
        <div class="rounded-[1.75rem] border border-dashed border-border bg-card/50 p-12 text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-muted">
                <i data-lucide="message-square" class="h-8 w-8 text-muted-foreground/50"></i>
            </div>
            <p class="mt-4 text-sm font-bold">No posts to moderate</p>
            <p class="mt-1.5 text-xs text-muted-foreground">All community posts have been reviewed.</p>
        </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
