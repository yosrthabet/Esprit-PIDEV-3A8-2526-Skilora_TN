{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Community Moderation{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Admin moderation</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">Community supervision.</h1>
        <p class="mt-2 text-muted-foreground">Review posts, approve valid content, or reject problematic threads.</p>
    </section>
    <section class="space-y-4">
        {% for post in posts %}
            <article class="glass-panel p-5">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-bold text-muted-foreground">{{ post.status.label }}</span>
                        <h2 class="mt-3 font-semibold">{{ post.author.displayName }}</h2>
                    </div>
                    <a href="{{ path('app_community_post_show', {id: post.id}) }}" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Open</a>
                </div>
                <p class="mt-4 whitespace-pre-line text-sm text-muted-foreground">{{ post.content }}</p>
                {% if post.moderationReason %}<p class="mt-3 text-xs text-destructive">{{ post.moderationReason }}</p>{% endif %}
                <div class="mt-5 flex flex-wrap gap-2">
                    <form method="post" action="{{ path('app_admin_community_post_approve', {id: post.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_community_approve_' ~ post.id) }}">
                        <button class="rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Approve</button>
                    </form>
                    <form method="post" action="{{ path('app_admin_community_post_reject', {id: post.id}) }}" class="flex gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_community_reject_' ~ post.id) }}">
                        <input name="reason" placeholder="Reason" class="h-10 rounded-xl border border-border bg-background/70 px-3 text-sm">
                        <button class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Reject</button>
                    </form>
                </div>
            </article>
        {% else %}
            <div class="glass-panel p-12 text-center text-muted-foreground">No community posts to moderate.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
