{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Quizzes — {{ formation.title }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <a href="{{ path('app_formation_show', {id: formation.id}) }}" class="text-sm font-semibold text-muted-foreground hover:text-foreground">← Back to formation</a>
        <h1 class="mt-4 text-3xl font-light tracking-holographic">Quizzes</h1>
        <p class="mt-1 text-sm text-muted-foreground">{{ formation.title }}</p>
    </section>
    {% if quizzes|length > 0 %}
        <div class="grid gap-4 md:grid-cols-2">
            {% for quiz in quizzes %}
                <div class="glass-panel space-y-3 p-6">
                    <h2 class="font-bold text-lg">{{ quiz.title }}</h2>
                    {% if quiz.description %}<p class="text-sm text-muted-foreground">{{ quiz.description }}</p>{% endif %}
                    <div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
                        <span>{{ quiz.questionCount }} questions</span>
                        <span>· Pass: {{ quiz.passingScore }}%</span>
                        {% if quiz.timeLimitMinutes %}<span>· {{ quiz.timeLimitMinutes }} min</span>{% endif %}
                    </div>
                    <a href="{{ path('app_quiz_take', {id: quiz.id}) }}" class="inline-block rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Start quiz</a>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="glass-panel p-8 text-center"><p class="text-muted-foreground">No quizzes available for this formation yet.</p></div>
    {% endif %}
</div>
{% endblock %}
