{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Edit Quiz — {{ quiz.title }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <a href="{{ path('app_formation_quiz_manage', {id: formation.id}) }}" class="text-sm font-semibold text-muted-foreground hover:text-foreground">← Back to quizzes</a>
        <h1 class="mt-4 text-3xl font-light tracking-holographic">{{ quiz.title }}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{{ quiz.questionCount }} questions · {{ quiz.published ? 'Published' : 'Draft' }}</p>
    </section>

    <section class="glass-panel p-6">
        <h2 class="font-semibold">Quiz settings</h2>
        <form method="post" action="{{ path('app_formation_quiz_update', {id: quiz.id}) }}" class="mt-4 grid gap-3 md:grid-cols-2">
            <input type="hidden" name="_token" value="{{ csrf_token('quiz_update_' ~ quiz.id) }}">
            <input name="title" value="{{ quiz.title }}" required class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            <input name="passing_score" type="number" value="{{ quiz.passingScore }}" min="0" max="100" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            <input name="description" value="{{ quiz.description }}" placeholder="Description" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            <input name="time_limit" type="number" value="{{ quiz.timeLimitMinutes }}" placeholder="Time limit (min)" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            <button class="rounded-xl bg-primary px-5 py-2 text-sm font-bold text-primary-foreground md:col-span-2">Save</button>
        </form>
    </section>

    <section class="glass-panel p-6">
        <h2 class="font-semibold">Questions</h2>
        <div class="mt-4 space-y-4">
            {% for question in quiz.questions %}
            <div class="rounded-2xl border border-border bg-background/50 p-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="font-bold text-sm">{{ loop.index }}. {{ question.questionText }}</p>
                        <ul class="mt-2 space-y-1 text-sm">
                            {% for choice in question.choices %}
                                <li class="{{ loop.index0 == question.correctIndex ? 'font-bold text-green-600' : 'text-muted-foreground' }}">{{ loop.index0 == question.correctIndex ? '✓' : '○' }} {{ choice }}</li>
                            {% endfor %}
                        </ul>
                        {% if question.explanation %}<p class="mt-1 text-xs italic text-muted-foreground">{{ question.explanation }}</p>{% endif %}
                        <p class="mt-1 text-xs text-muted-foreground">{{ question.points }} point{{ question.points > 1 ? 's' : '' }}</p>
                    </div>
                    <form method="post" action="{{ path('app_quiz_question_delete', {quizId: quiz.id, id: question.id}) }}" data-confirm="Delete this question?" data-confirm-label="Delete">
                        <input type="hidden" name="_token" value="{{ csrf_token('quiz_question_delete_' ~ question.id) }}">
                        <button class="text-xs text-destructive hover:underline">Delete</button>
                    </form>
                </div>
            </div>
            {% else %}
                <p class="text-sm text-muted-foreground">No questions yet. Add one below.</p>
            {% endfor %}
        </div>
    </section>

    <section class="glass-panel p-6">
        <h2 class="font-semibold">Add a question</h2>
        <form method="post" action="{{ path('app_quiz_question_add', {id: quiz.id}) }}" class="mt-4 space-y-3">
            <input type="hidden" name="_token" value="{{ csrf_token('quiz_question_add_' ~ quiz.id) }}">
            <input name="question_text" required placeholder="Question text" class="h-11 w-full rounded-xl border border-border bg-background/70 px-4 text-sm">
            <textarea name="choices" rows="4" required placeholder="One choice per line (minimum 2)" class="w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm"></textarea>
            <div class="grid gap-3 md:grid-cols-3">
                <input name="correct_index" type="number" value="0" min="0" placeholder="Correct answer index (0-based)" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
                <input name="points" type="number" value="1" min="1" placeholder="Points" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
                <input name="explanation" placeholder="Explanation (optional)" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            </div>
            <button class="rounded-xl bg-primary px-5 py-2 text-sm font-bold text-primary-foreground">Add Question</button>
        </form>
    </section>
</div>
{% endblock %}
