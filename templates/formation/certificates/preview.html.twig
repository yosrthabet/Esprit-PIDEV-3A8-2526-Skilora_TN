{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Certificate Preview{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
    {% include 'components/_breadcrumbs.html.twig' with {items: [{label: 'Certificates', route: 'app_certificates'}, {label: 'Preview'}]} %}
    {% include 'formation/certificates/_certificate_core.html.twig' with {certificate: certificate, verification_url: verification_url} %}
    <div class="text-center">
        <a href="{{ path('app_certificate_show', {id: certificate.id}) }}" class="inline-flex items-center gap-2 rounded-2xl border border-border px-5 py-3 text-sm font-semibold transition hover:bg-muted">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Back to certificate
        </a>
    </div>
</div>
{% endblock %}
