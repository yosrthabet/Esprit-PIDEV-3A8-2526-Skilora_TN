<article class="certificate glass-panel overflow-hidden p-10 text-center">
    <p class="eyebrow text-xs font-bold uppercase tracking-label text-primary">Skilora Certificate</p>
    <h1 class="title mt-4 text-4xl font-light tracking-holographic">{{ certificate.enrollment.formation.title }}</h1>
    <p class="mt-4 text-muted-foreground">Awarded to</p>
    <p class="name mt-2 text-2xl font-semibold">{{ certificate.enrollment.user.displayName }}</p>
    <p class="meta mt-6 text-sm text-muted-foreground">Issued {{ certificate.issuedAt|date('M d, Y') }} · Trainer {{ certificate.enrollment.formation.trainer.displayName }}</p>
    <p class="verify mt-6 rounded-xl bg-muted p-3 text-xs font-mono text-muted-foreground">{{ verification_url }}</p>
</article>
