<article class="certificate relative overflow-hidden rounded-[2rem] p-10 sm:p-14 text-center" style="background:#1a1a1f;border:1px solid rgba(245,158,11,.15);box-shadow:0 20px 50px -10px rgba(0,0,0,.4)">
    <div class="absolute inset-0 rounded-[2rem]" style="background:linear-gradient(160deg,#1a1a1f 0%,#27272a 40%,#1f1f23 100%)"></div>
    <div class="absolute inset-0 rounded-[2rem]" style="background:radial-gradient(ellipse at top center, rgba(245,158,11,.1), transparent 55%)"></div>
    <div class="absolute inset-4 rounded-[1.5rem] pointer-events-none" style="border:1px solid rgba(245,158,11,.1)"></div>

    <div class="relative z-10">
        <p class="text-[11px] font-black uppercase tracking-[0.35em]" style="color:rgba(251,191,36,.75)">Skilora Certificate</p>
        <div class="mx-auto mt-3 h-px w-24" style="background:linear-gradient(to right,transparent,rgba(245,158,11,.4),transparent)"></div>
        <h1 class="mt-6 text-3xl sm:text-4xl font-extralight tracking-tight" style="color:#fff">{{ certificate.enrollment.formation.title }}</h1>
        <p class="mt-6 text-xs uppercase tracking-[0.2em]" style="color:#a1a1aa">Awarded to</p>
        <p class="mt-2 text-2xl sm:text-3xl font-semibold" style="background:linear-gradient(to right,#fde68a,#fef9c3,#fde68a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">{{ certificate.enrollment.user.displayName }}</p>
        <p class="mt-6 text-sm" style="color:#a1a1aa">Issued {{ certificate.issuedAt|date('F d, Y') }} · Trainer {{ certificate.enrollment.formation.trainer.displayName }}</p>
        {% if signature_data_uri|default(null) %}
            <div class="mt-10 pt-6" style="border-top:1px solid rgba(63,63,70,.4)">
                <img src="{{ signature_data_uri }}" alt="Trainer signature" class="mx-auto h-20 max-w-[240px] object-contain" style="filter:brightness(0) invert(1);opacity:.85">
                <div class="mx-auto mt-2 h-px w-48" style="background:linear-gradient(to right,transparent,rgba(245,158,11,.4),transparent)"></div>
                <p class="mt-3 text-sm font-medium" style="color:#d4d4d8">{{ certificate.enrollment.formation.trainer.displayName }}</p>
                <p class="text-[11px] tracking-wide" style="color:#71717a">Director / Trainer</p>
            </div>
        {% endif %}
        <p class="mt-8 rounded-xl px-4 py-3 text-xs font-mono select-all tracking-wider" style="background:rgba(39,39,42,.5);border:1px solid rgba(63,63,70,.4);color:#a1a1aa">{{ verification_url }}</p>
    </div>
</article>
