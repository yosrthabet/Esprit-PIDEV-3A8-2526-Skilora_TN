{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Certificates{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Certificates</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">Verified learning achievements.</h1>
    </section>
    <section class="grid gap-4 md:grid-cols-2">
        {% for certificate in certificates %}
            <a href="{{ path('app_certificate_show', {id: certificate.id}) }}" class="glass-panel p-5 transition hover:border-primary/40">
                <h2 class="text-xl font-semibold">{{ certificate.enrollment.formation.title }}</h2>
                <p class="mt-2 text-sm text-muted-foreground">Issued {{ certificate.issuedAt|date('M d, Y') }}</p>
                <p class="mt-4 rounded-xl bg-muted p-3 text-xs font-mono text-muted-foreground">{{ certificate.verificationId }}</p>
            </a>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">Complete a formation to receive your first certificate.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
