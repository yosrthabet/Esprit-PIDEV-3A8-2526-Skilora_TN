{% extends 'base.html.twig' %}
{% block title %}Certificate Verification · Skilora{% endblock %}
{% block body %}
<div class="min-h-screen px-4 py-12 sm:px-6 lg:px-8" style="background:#0f0f12">
    <main class="mx-auto max-w-3xl relative overflow-hidden rounded-[2rem] p-10 sm:p-14 text-center" style="background:#1a1a1f;border:1px solid rgba(245,158,11,.15);box-shadow:0 20px 50px -10px rgba(0,0,0,.5)">
        <div class="absolute inset-0 rounded-[2rem]" style="background:linear-gradient(160deg,#1a1a1f 0%,#27272a 40%,#1f1f23 100%)"></div>
        <div class="absolute inset-0 rounded-[2rem]" style="background:radial-gradient(ellipse at top center, rgba(245,158,11,.1), transparent 50%)"></div>
        <div class="absolute inset-4 rounded-[1.5rem] pointer-events-none" style="border:1px solid rgba(245,158,11,.08)"></div>

        <div class="relative z-10">
            {% if certificate %}
                <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full" style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3)">
                    <svg class="h-8 w-8" style="color:#10b981" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <p class="text-[11px] font-black uppercase tracking-[0.35em]" style="color:rgba(16,185,129,.8)">Verified credential</p>
                <div class="mx-auto mt-3 h-px w-24" style="background:linear-gradient(to right,transparent,rgba(16,185,129,.4),transparent)"></div>

                <h1 class="mt-8 text-3xl sm:text-4xl font-extralight tracking-tight" style="color:#fff">Valid Skilora Certificate</h1>

                <p class="mt-8 text-xs uppercase tracking-[0.2em]" style="color:#a1a1aa">Awarded to</p>
                <p class="mt-2 text-2xl sm:text-3xl font-semibold" style="background:linear-gradient(to right,#fde68a,#fef9c3,#fde68a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">{{ certificate.enrollment.user.displayName }}</p>

                <p class="mt-8 text-xs uppercase tracking-[0.2em]" style="color:#a1a1aa">For completing</p>
                <p class="mt-2 text-xl font-semibold" style="color:#fff">{{ certificate.enrollment.formation.title }}</p>

                <p class="mt-8 text-sm" style="color:#71717a">Trainer: {{ certificate.enrollment.formation.trainer.displayName }} · Issued {{ certificate.issuedAt|date('F d, Y') }}</p>

                <div class="mt-8 rounded-xl px-5 py-3" style="background:rgba(39,39,42,.5);border:1px solid rgba(63,63,70,.4)">
                    <p class="text-[10px] font-bold uppercase tracking-[0.15em] mb-1" style="color:#71717a">Verification ID</p>
                    <p class="font-mono text-xs select-all tracking-wider" style="color:#d4d4d8">{{ certificate.verificationId }}</p>
                </div>
            {% else %}
                <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3)">
                    <svg class="h-8 w-8" style="color:#ef4444" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <p class="text-[11px] font-black uppercase tracking-[0.35em]" style="color:rgba(239,68,68,.8)">Verification failed</p>
                <h1 class="mt-6 text-3xl font-extralight" style="color:#fff">Certificate not found</h1>
                <p class="mt-4 text-sm" style="color:#a1a1aa">No issued certificate matches verification ID <span class="font-mono" style="color:#d4d4d8">{{ verification_id }}</span>.</p>
            {% endif %}
        </div>
    </main>

    <p class="mt-8 text-center text-xs" style="color:#52525b">Verified by Skilora · <a href="/" style="color:rgba(245,158,11,.7);text-decoration:none">skilora.tn</a></p>
</div>
{% endblock %}
