{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Trainer Formations{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# Flash messages #}
    {% for type in ['success', 'error'] %}
        {% for msg in app.flashes(type) %}
            <div class="rounded-xl border p-4 text-sm {{ type == 'success' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400' : 'border-destructive/30 bg-destructive/10 text-destructive' }}">{{ msg }}</div>
        {% endfor %}
    {% endfor %}

    <section class="glass-panel flex flex-wrap items-center justify-between gap-4 p-8">
        <div>
            <p class="text-xs font-bold uppercase tracking-label text-primary">Trainer studio</p>
            <h1 class="mt-2 text-4xl font-light tracking-holographic">Build your course catalog.</h1>
        </div>
        <a href="{{ path('app_trainer_formation_new') }}" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">New formation</a>
        <form method="get" action="{{ path('app_trainer_formations') }}" class="grid w-full gap-3 md:grid-cols-[1fr_auto]">
            <input name="q" value="{{ q }}" placeholder="Search by title or category" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
            <button class="rounded-xl border border-border px-5 text-sm font-bold">Search</button>
        </form>
    </section>
    <p class="text-sm text-muted-foreground">{{ total }} formations · page {{ page }} / {{ page_count }}</p>
    <section class="grid gap-4 lg:grid-cols-2">
        {% for formation in formations %}
            <article class="glass-panel p-5">
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold {{ formation.status.badgeClass }}">{{ formation.status.label }}</span>
                    {% if formation.reviewScore %}
                        <span class="text-xs text-muted-foreground">AI score: {{ formation.reviewScore }}%</span>
                    {% endif %}
                </div>
                <h2 class="mt-3 text-xl font-semibold">{{ formation.title ?: 'Untitled formation' }}</h2>
                <p class="mt-2 text-sm text-muted-foreground">{{ formation.modules|length }} modules · {{ formation.enrollments|length }} students</p>
                {% if formation.status.value == 'refused' and formation.reviewNote %}
                    <p class="mt-2 rounded-lg border border-destructive/20 bg-destructive/5 p-2 text-xs text-destructive">{{ formation.reviewNote }}</p>
                {% endif %}
                <div class="mt-5 flex flex-wrap gap-2">
                    {% if formation.status.value in ['draft', 'refused', 'published'] %}
                        <a href="{{ path('app_trainer_formation_edit', {id: formation.id}) }}" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Edit</a>
                    {% endif %}
                    <a href="{{ path('app_trainer_formation_modules', {id: formation.id}) }}" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Modules</a>
                    <a href="{{ path('app_trainer_formation_materials', {id: formation.id}) }}" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Materials</a>
                    <a href="{{ path('app_trainer_formation_students', {id: formation.id}) }}" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Students</a>
                    <a href="{{ path('app_formation_show', {id: formation.id}) }}" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Preview</a>
                    {% if formation.status.value in ['draft', 'refused'] %}
                    <form method="post" action="{{ path('app_trainer_formation_delete', {id: formation.id}) }}" data-confirm="Delete this formation?" data-confirm-label="Delete">
                        <input type="hidden" name="_token" value="{{ csrf_token('trainer_formation_delete_' ~ formation.id) }}">
                        <button class="rounded-xl border border-border px-4 py-2 text-sm font-bold text-destructive">Delete</button>
                    </form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">Create your first formation to start building the trainer side of Skilora.</div>
        {% endfor %}
    </section>
    {% if page_count > 1 %}
        <nav class="flex justify-center gap-3">
            <a class="rounded-full border border-border px-4 py-2 text-sm {{ page <= 1 ? 'pointer-events-none opacity-40' }}" href="{{ path('app_trainer_formations', {q: q, page: page - 1}) }}">Previous</a>
            <a class="rounded-full border border-border px-4 py-2 text-sm {{ page >= page_count ? 'pointer-events-none opacity-40' }}" href="{{ path('app_trainer_formations', {q: q, page: page + 1}) }}">Next</a>
        </nav>
    {% endif %}
</div>
{% endblock %}
