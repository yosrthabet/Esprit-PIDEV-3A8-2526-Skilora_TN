{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Formation Students{% endblock %}
{% block content %}
<div class="mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Student roster</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">{{ formation.title }}</h1>
        <p class="mt-2 text-muted-foreground">Track enrollments, progress, completion, and certificates.</p>
    </section>
    <section class="space-y-3">
        {% for enrollment in enrollments %}
            {% set percent = progress_service.getCompletionPercent(enrollment) %}
            <article class="glass-panel p-5">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <h2 class="font-semibold">{{ enrollment.user.displayName }}</h2>
                        <p class="mt-1 text-sm text-muted-foreground">Enrolled {{ enrollment.enrolledAt|date('M d, Y') }} · {{ enrollment.status.value|title }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-bold">{{ percent }}%</p>
                        {% if enrollment.certificate %}<p class="text-xs text-muted-foreground">Certificate {{ enrollment.certificate.verificationId|slice(0, 10) }}...</p>{% endif %}
                    </div>
                </div>
                <div class="mt-4 h-2 rounded-full bg-muted"><div class="h-2 rounded-full bg-primary" style="width: {{ percent }}%"></div></div>
            </article>
        {% else %}
            <div class="glass-panel p-12 text-center text-muted-foreground">No learners have enrolled yet.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
