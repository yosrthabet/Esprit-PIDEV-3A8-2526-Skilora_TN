{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Formation Modules{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# Flash messages #}
    {% for type in ['success', 'error'] %}
        {% for msg in app.flashes(type) %}
            <div class="rounded-xl border p-4 text-sm {{ type == 'success' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400' : 'border-destructive/30 bg-destructive/10 text-destructive' }}">{{ msg }}</div>
        {% endfor %}
    {% endfor %}

    <section class="glass-panel p-8">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-bold uppercase tracking-label text-primary">Curriculum builder</p>
                <h1 class="mt-2 text-3xl font-light tracking-holographic">{{ formation.title }}</h1>
                <p class="mt-2 text-muted-foreground">Add lessons in order, then submit for AI review.</p>
            </div>
            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold {{ formation.status.badgeClass }}">{{ formation.status.label }}</span>
        </div>

        {# Under review / refused messaging #}
        {% if formation.status.value == 'pending_review' %}
            <div class="mt-4 flex items-center gap-3 rounded-xl border border-amber-500/30 bg-amber-500/10 p-4">
                <i data-lucide="clock" class="h-5 w-5 text-amber-500"></i>
                <div>
                    <p class="text-sm font-semibold text-amber-400">Under AI Review</p>
                    <p class="text-xs text-muted-foreground">Your formation is being reviewed by our AI system. You'll be notified via email once a decision is made.</p>
                </div>
            </div>
        {% elseif formation.status.value == 'refused' %}
            <div class="mt-4 flex items-center gap-3 rounded-xl border border-destructive/30 bg-destructive/10 p-4">
                <i data-lucide="x-circle" class="h-5 w-5 text-destructive"></i>
                <div>
                    <p class="text-sm font-semibold text-destructive">Review Refused</p>
                    <p class="text-xs text-muted-foreground">{{ formation.reviewNote|default('Your formation did not meet quality standards. Please improve content and resubmit.') }}</p>
                </div>
            </div>
        {% endif %}
    </section>

    {% set can_edit = formation.status.value in ['draft', 'refused', 'published'] %}
    {% if can_edit %}
    <form method="post" class="glass-panel grid gap-4 p-5 md:grid-cols-[1fr_160px_auto]">
        <input type="hidden" name="_token" value="{{ csrf_token('trainer_module_' ~ formation.id) }}">
        <input name="title" required placeholder="Module title" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
        <input name="duration_minutes" type="number" min="0" placeholder="Minutes" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
        <button class="rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground">Add module</button>
        <textarea name="description" rows="2" placeholder="Module notes" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm md:col-span-3"></textarea>
    </form>
    {% endif %}

    <section class="space-y-3">
        {% for module in formation.modules %}
            <div class="glass-panel p-5">
                <h2 class="font-semibold">{{ module.position }}. {{ module.title }}</h2>
                <p class="mt-1 text-sm text-muted-foreground">{{ module.description ?: module.durationMinutes ~ ' minutes' }}</p>
                {% if can_edit %}
                <form method="post" action="{{ path('app_trainer_formation_module_delete', {id: formation.id, moduleId: module.id}) }}" class="mt-3" data-confirm="Delete this module?" data-confirm-label="Delete">
                    <input type="hidden" name="_token" value="{{ csrf_token('trainer_module_delete_' ~ formation.id ~ '_' ~ module.id) }}">
                    <button class="rounded-xl border border-border px-3 py-2 text-sm font-bold text-destructive">Delete module</button>
                </form>
                {% endif %}
                <div class="mt-4 space-y-2">
                    {% for material in module.materials %}
                        <a href="{{ material.resourceUrl }}" target="_blank" rel="noopener noreferrer" class="block rounded-xl border border-border bg-background/50 px-3 py-2 text-sm hover:border-primary/40">{{ material.position }}. {{ material.title }} <span class="text-xs text-muted-foreground">{{ material.kind }}</span></a>
                    {% else %}
                        <p class="text-sm text-muted-foreground">No materials for this module yet.</p>
                    {% endfor %}
                </div>
                {% if can_edit %}
                <form method="post" action="{{ path('app_trainer_formation_material_add', {id: formation.id, moduleId: module.id}) }}" class="mt-4 grid gap-3 md:grid-cols-[1fr_120px_1fr_auto]">
                    <input type="hidden" name="_token" value="{{ csrf_token('trainer_material_' ~ formation.id ~ '_' ~ module.id) }}">
                    <input name="title" required placeholder="Resource title" class="h-10 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <input name="kind" placeholder="link" class="h-10 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <input name="resource_url" required placeholder="https://..." class="h-10 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <button class="rounded-xl border border-border px-4 text-sm font-bold">Add resource</button>
                </form>
                {% endif %}
            </div>
        {% else %}
            <div class="glass-panel p-10 text-center text-muted-foreground">No modules yet.</div>
        {% endfor %}
    </section>

    {# Submit for review / Done button #}
    {% if formation.status.value in ['draft', 'refused'] and formation.modules|length > 0 %}
    <div class="glass-panel flex items-center justify-between p-6">
        <div>
            <p class="text-sm font-semibold">Ready to publish?</p>
            <p class="text-xs text-muted-foreground">Submit your formation for AI review. You need at least 1 module and your certificate signature.</p>
        </div>
        <form method="post" action="{{ path('app_trainer_formation_submit_review', {id: formation.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('trainer_formation_submit_' ~ formation.id) }}">
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-emerald-700">
                <i data-lucide="send" class="h-4 w-4"></i> Submit for review
            </button>
        </form>
    </div>
    {% endif %}

    <div class="flex gap-3">
        <a href="{{ path('app_trainer_formations') }}" class="inline-flex items-center gap-2 rounded-xl border border-border px-5 py-3 text-sm font-semibold hover:bg-muted">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Back to formations
        </a>
        {% if can_edit %}
        <a href="{{ path('app_trainer_formation_edit', {id: formation.id}) }}" class="inline-flex items-center gap-2 rounded-xl border border-border px-5 py-3 text-sm font-semibold hover:bg-muted">
            <i data-lucide="edit" class="h-4 w-4"></i> Edit details
        </a>
        {% endif %}
    </div>
</div>
{% endblock %}
