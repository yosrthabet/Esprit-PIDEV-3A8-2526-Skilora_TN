{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Formation Modules{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Curriculum builder</p>
        <h1 class="mt-2 text-3xl font-light tracking-holographic">{{ formation.title }}</h1>
        <p class="mt-2 text-muted-foreground">Add lessons in order. Admins can publish once the course is ready.</p>
    </section>
    <form method="post" class="glass-panel grid gap-4 p-5 md:grid-cols-[1fr_160px_auto]">
        <input type="hidden" name="_token" value="{{ csrf_token('trainer_module_' ~ formation.id) }}">
        <input name="title" required placeholder="Module title" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
        <input name="duration_minutes" type="number" min="0" placeholder="Minutes" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
        <button class="rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground">Add module</button>
        <textarea name="description" rows="2" placeholder="Module notes" class="rounded-xl border border-border bg-background/70 px-4 py-3 text-sm md:col-span-3"></textarea>
    </form>
    <section class="space-y-3">
        {% for module in formation.modules %}
            <div class="glass-panel p-5">
                <h2 class="font-semibold">{{ module.position }}. {{ module.title }}</h2>
                <p class="mt-1 text-sm text-muted-foreground">{{ module.description ?: module.durationMinutes ~ ' minutes' }}</p>
                <form method="post" action="{{ path('app_trainer_formation_module_delete', {id: formation.id, moduleId: module.id}) }}" class="mt-3" onsubmit="return confirm('Delete this module?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('trainer_module_delete_' ~ formation.id ~ '_' ~ module.id) }}">
                    <button class="rounded-xl border border-border px-3 py-2 text-sm font-bold text-destructive">Delete module</button>
                </form>
                <div class="mt-4 space-y-2">
                    {% for material in module.materials %}
                        <a href="{{ material.resourceUrl }}" target="_blank" rel="noopener noreferrer" class="block rounded-xl border border-border bg-background/50 px-3 py-2 text-sm hover:border-primary/40">{{ material.position }}. {{ material.title }} <span class="text-xs text-muted-foreground">{{ material.kind }}</span></a>
                    {% else %}
                        <p class="text-sm text-muted-foreground">No materials for this module yet.</p>
                    {% endfor %}
                </div>
                <form method="post" action="{{ path('app_trainer_formation_material_add', {id: formation.id, moduleId: module.id}) }}" class="mt-4 grid gap-3 md:grid-cols-[1fr_120px_1fr_auto]">
                    <input type="hidden" name="_token" value="{{ csrf_token('trainer_material_' ~ formation.id ~ '_' ~ module.id) }}">
                    <input name="title" required placeholder="Resource title" class="h-10 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <input name="kind" placeholder="link" class="h-10 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <input name="resource_url" required placeholder="https://..." class="h-10 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    <button class="rounded-xl border border-border px-4 text-sm font-bold">Add resource</button>
                </form>
            </div>
        {% else %}
            <div class="glass-panel p-10 text-center text-muted-foreground">No modules yet.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
