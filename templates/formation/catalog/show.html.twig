{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ formation.title }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ formation.category }}</span>
            <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{{ formation.level.value|replace({'_': ' '})|title }}</span>
            <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{{ formation.durationHours }}h</span>
        </div>
        <h1 class="mt-4 text-4xl font-light tracking-holographic">{{ formation.title }}</h1>
        <p class="mt-3 text-muted-foreground">{{ formation.description ?: 'The trainer has not added a long description yet.' }}</p>
        <p class="mt-3 text-sm text-muted-foreground">
            {% if review_summary.count > 0 %}
                {{ review_summary.average }}/5 from {{ review_summary.count }} review{{ review_summary.count > 1 ? 's' }}
            {% else %}
                No learner reviews yet.
            {% endif %}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
            {% if enrollment %}
                <a href="{{ path('app_learning_show', {id: enrollment.id}) }}" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Continue learning</a>
            {% elseif formation.published and app.user and not app.user.admin %}
                <form method="post" action="{{ path('app_formation_enroll', {id: formation.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('enroll_formation_' ~ formation.id) }}">
                    <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Enroll now</button>
                </form>
            {% elseif formation.published and not app.user %}
                <a href="{{ path('app_login') }}" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Log in to enroll</a>
            {% endif %}
            {% if can_edit_modules %}
                <a href="{{ path('app_trainer_formation_modules', {id: formation.id}) }}" class="rounded-xl border border-border px-5 py-3 text-sm font-bold">Manage modules</a>
            {% endif %}
        </div>
    </section>

    <section class="glass-panel p-6">
        <h2 class="text-xl font-semibold">Modules</h2>
        <div class="mt-4 space-y-3">
            {% for module in formation.modules %}
                <div class="rounded-2xl border border-border bg-background/50 p-4">
                    <div class="flex items-center justify-between gap-4">
                        <h3 class="font-semibold">{{ module.position }}. {{ module.title }}</h3>
                        <span class="text-xs text-muted-foreground">{{ module.durationMinutes }} min</span>
                    </div>
                    {% if module.description %}<p class="mt-2 text-sm text-muted-foreground">{{ module.description }}</p>{% endif %}
                    {% if module.materials|length > 0 %}
                        <div class="mt-3 flex flex-wrap gap-2">
                            {% for material in module.materials %}
                                <a href="{{ material.resourceUrl }}" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground">{{ material.title }}</a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <p class="text-sm text-muted-foreground">No modules have been added yet.</p>
            {% endfor %}
        </div>
    </section>

    <section class="glass-panel p-6">
        <h2 class="text-xl font-semibold">Learner reviews</h2>
        {% if can_review %}
            <form method="post" action="{{ path('app_formation_review', {id: formation.id}) }}" class="mt-4 grid gap-3 md:grid-cols-[120px_1fr_auto]">
                <input type="hidden" name="_token" value="{{ csrf_token('formation_review_' ~ formation.id) }}">
                <select name="rating" class="h-11 rounded-xl border border-border bg-background/70 px-3 text-sm">
                    {% for value in 5..1 %}<option value="{{ value }}" {{ review and review.rating == value ? 'selected' }}>{{ value }}/5</option>{% endfor %}
                </select>
                <input name="comment" value="{{ review ? review.comment : '' }}" placeholder="What should future learners know?" class="h-11 rounded-xl border border-border bg-background/70 px-4 text-sm">
                <button class="rounded-xl bg-primary px-5 text-sm font-bold text-primary-foreground">Review</button>
            </form>
        {% endif %}
        <div class="mt-5 space-y-3">
            {% for item in formation.reviews %}
                <article class="rounded-2xl border border-border bg-background/50 p-4">
                    <div class="flex items-center justify-between gap-3">
                        <span class="font-semibold">{{ item.user.displayName }}</span>
                        <span class="text-xs font-bold text-primary">{{ item.rating }}/5</span>
                    </div>
                    {% if item.comment %}<p class="mt-2 text-sm text-muted-foreground">{{ item.comment }}</p>{% endif %}
                </article>
            {% else %}
                <p class="text-sm text-muted-foreground">No reviews have been posted yet.</p>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
