{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Review Formation{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-bold text-muted-foreground">{{ formation.status.value|title }}</span>
        <h1 class="mt-4 text-4xl font-light tracking-holographic">{{ formation.title }}</h1>
        <p class="mt-2 text-muted-foreground">Trainer: {{ formation.trainer.displayName }} · {{ formation.modules|length }} modules</p>
        <div class="mt-6 flex flex-wrap gap-3">
            <a href="{{ path('app_admin_formation_edit', {id: formation.id}) }}" class="rounded-xl border border-border px-5 py-3 text-sm font-bold">Edit</a>
            <form method="post" action="{{ path('app_admin_formation_publish', {id: formation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_formation_publish_' ~ formation.id) }}">
                <button class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">Publish</button>
            </form>
            <form method="post" action="{{ path('app_admin_formation_archive', {id: formation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_formation_archive_' ~ formation.id) }}">
                <button class="rounded-xl border border-border px-5 py-3 text-sm font-bold">Archive</button>
            </form>
            <form method="post" action="{{ path('app_admin_formation_delete', {id: formation.id}) }}" data-confirm="Delete this formation?" data-confirm-label="Delete">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_formation_delete_' ~ formation.id) }}">
                <button class="rounded-xl border border-border px-5 py-3 text-sm font-bold text-destructive">Delete</button>
            </form>
        </div>
    </section>
    <section class="glass-panel p-6">
        <h2 class="text-xl font-semibold">Description</h2>
        <p class="mt-2 text-muted-foreground">{{ formation.description ?: 'No description.' }}</p>
    </section>
</div>
{% endblock %}
