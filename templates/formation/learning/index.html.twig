{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Learning{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Learning space</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">Your active formations.</h1>
    </section>
    <section class="grid gap-4 lg:grid-cols-2">
        {% for enrollment in enrollments %}
            {% set percent = progress_service.getCompletionPercent(enrollment) %}
            <a href="{{ path('app_learning_show', {id: enrollment.id}) }}" class="glass-panel p-5 transition hover:border-primary/40">
                <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-bold text-muted-foreground">{{ enrollment.status.value|title }}</span>
                <h2 class="mt-4 text-xl font-semibold">{{ enrollment.formation.title }}</h2>
                <div class="mt-4 h-2 rounded-full bg-muted"><div class="h-2 rounded-full bg-primary" style="width: {{ percent }}%"></div></div>
                <p class="mt-2 text-xs text-muted-foreground">{{ percent }}% complete</p>
            </a>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No enrollments yet. Visit the formations catalog to start learning.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
