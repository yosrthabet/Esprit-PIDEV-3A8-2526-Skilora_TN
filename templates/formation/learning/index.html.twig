{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Learning{% endblock %}
{% block content %}
{% set completed = enrollments|filter(e => e.status.value == 'completed')|length %}
{% set in_progress = enrollments|filter(e => e.status.value != 'completed')|length %}

<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# ── Hero ── #}
    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(16,185,129,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-emerald-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_28rem] lg:items-end">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Learning space</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Your active<br class="hidden sm:block"> formations.</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">Track your progress and complete courses at your own pace.</p>
                <div class="mt-6 flex flex-wrap gap-2">
                    <a href="{{ path('app_formations') }}" class="rounded-full bg-white px-4 py-2 text-sm font-bold text-black shadow-sm transition hover:shadow-md">
                        <i data-lucide="compass" class="mr-1.5 inline h-3.5 w-3.5"></i> Browse catalog
                    </a>
                </div>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ enrollments|length }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Enrolled</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ in_progress }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Active</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ completed }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Done</p>
                </div>
            </div>
        </div>
    </section>

    {# ── Enrollments ── #}
    <section class="grid gap-4 lg:grid-cols-2">
        {% for enrollment in enrollments %}
            {% set percent = progress_service.getCompletionPercent(enrollment) %}
            <a href="{{ path('app_learning_show', {id: enrollment.id}) }}" class="group rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-xl">
                <div class="flex items-center justify-between gap-3">
                    <span class="rounded-full bg-muted px-2.5 py-1 text-[10px] font-black uppercase tracking-wide text-muted-foreground">{{ enrollment.status.value|title }}</span>
                    <span class="rounded-full bg-muted px-2.5 py-1 text-[11px] font-black">{{ percent }}%</span>
                </div>
                <h2 class="mt-4 text-xl font-bold text-foreground group-hover:text-primary transition-colors">{{ enrollment.formation.title }}</h2>
                <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-muted"><div class="h-full rounded-full bg-primary transition-all" style="width: {{ percent }}%"></div></div>
                <div class="mt-3 flex items-center justify-between text-[11px] font-semibold text-muted-foreground">
                    <span>{{ percent }}% complete</span>
                    <span>Continue →</span>
                </div>
            </a>
        {% else %}
            <div class="col-span-full rounded-[1.75rem] border border-dashed border-border bg-card/50 p-12 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-muted">
                    <i data-lucide="book-open" class="h-8 w-8 text-muted-foreground/50"></i>
                </div>
                <p class="mt-4 text-sm font-bold">No enrollments yet</p>
                <p class="mt-1.5 text-xs text-muted-foreground">Visit the formations catalog to start learning.</p>
                <a href="{{ path('app_formations') }}" class="mt-4 inline-flex rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground shadow-sm">Browse catalog</a>
            </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
