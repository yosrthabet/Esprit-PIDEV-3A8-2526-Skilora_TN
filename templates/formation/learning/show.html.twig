{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ enrollment.formation.title }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8 animate-fade-in" x-data="learningPage()">

    {% include 'components/_breadcrumbs.html.twig' with {items: [{label: 'Learning', route: 'app_learning'}, {label: enrollment.formation.title}]} %}

    {# Flash messages #}
    {% for type in ['success', 'error'] %}
        {% for msg in app.flashes(type) %}
            <div class="rounded-xl border p-4 text-sm {{ type == 'success' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400' : 'border-destructive/30 bg-destructive/10 text-destructive' }}">{{ msg }}</div>
        {% endfor %}
    {% endfor %}

    <div class="grid gap-6 lg:grid-cols-[1fr_20rem]">
        <div class="space-y-6">
            <section class="glass-panel p-8">
                <p class="text-xs font-bold uppercase tracking-label text-primary">Learning</p>
                <h1 class="mt-2 text-4xl font-light tracking-holographic">{{ enrollment.formation.title }}</h1>
                <p class="mt-2 text-sm text-muted-foreground">by {{ enrollment.formation.trainer.displayName }}</p>
                {% if enrollment.certificate %}
                    <div class="mt-5 flex flex-wrap gap-3">
                        <a href="{{ path('app_certificate_show', {id: enrollment.certificate.id}) }}" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-700">
                            <i data-lucide="award" class="h-4 w-4"></i> View certificate
                        </a>
                        <a href="{{ path('app_certificate_download', {id: enrollment.certificate.id}) }}" class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2.5 text-sm font-semibold hover:bg-muted transition">
                            <i data-lucide="download" class="h-4 w-4"></i> Download PDF
                        </a>
                        <a href="{{ path('app_certificate_qr', {id: enrollment.certificate.id}) }}" class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2.5 text-sm font-semibold hover:bg-muted transition">
                            <i data-lucide="qr-code" class="h-4 w-4"></i> QR Code
                        </a>
                    </div>
                {% endif %}
            </section>

            {# ── Completion celebration + review prompt ── #}
            {% if progress_percent == 100 %}
                <section class="glass-panel border-emerald-500/30 bg-gradient-to-r from-emerald-500/5 to-transparent p-6">
                    <div class="flex items-center gap-4">
                        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/15">
                            <i data-lucide="trophy" class="h-6 w-6 text-emerald-500"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-emerald-400">Formation completed!</h3>
                            <p class="text-sm text-muted-foreground">Congratulations! Your certificate has been generated.</p>
                        </div>
                    </div>
                    {% if not has_reviewed %}
                        <div class="mt-5 rounded-xl border border-border/60 bg-muted/20 p-4">
                            <p class="text-sm font-semibold">Rate this formation</p>
                            <p class="text-xs text-muted-foreground mb-3">Help other learners by sharing your experience</p>
                            <form method="post" action="{{ path('app_formation_review', {id: enrollment.formation.id}) }}" class="space-y-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('formation_review_' ~ enrollment.formation.id) }}">
                                <div class="flex items-center gap-1" x-data="{ rating: 5 }">
                                    <template x-for="star in [1,2,3,4,5]">
                                        <button type="button" @click="rating = star" class="text-2xl transition" :class="star <= rating ? 'text-amber-400' : 'text-muted-foreground/30'">★</button>
                                    </template>
                                    <input type="hidden" name="rating" :value="rating">
                                </div>
                                <textarea name="comment" rows="2" placeholder="What did you think of this course?" class="w-full rounded-xl border border-border bg-background/70 px-4 py-3 text-sm"></textarea>
                                <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground">Submit review</button>
                            </form>
                        </div>
                    {% else %}
                        <p class="mt-4 text-sm text-muted-foreground"><i data-lucide="check-circle" class="inline h-4 w-4 text-emerald-500"></i> You've already reviewed this formation. Thank you!</p>
                    {% endif %}
                </section>
            {% endif %}

            {# ── Modules list ── #}
            <section class="space-y-3">
                {% for module in enrollment.formation.modules %}
                    {% set done = module.id in completed_module_ids %}
                    <div class="glass-panel flex items-start gap-4 p-5 transition cursor-pointer {{ done ? 'border-emerald-500/20' : 'hover:border-primary/30' }}"
                         @click="openModule({{ module.id }}, '{{ module.title|e('js') }}', '{{ module.description|default('')|e('js') }}', {{ module.durationMinutes }}, {{ done ? 'true' : 'false' }}, {{ module.materials|length }})">
                        <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full {{ done ? 'bg-emerald-500 text-white' : 'bg-muted text-muted-foreground' }} text-xs font-bold">
                            {% if done %}<i data-lucide="check" class="h-4 w-4"></i>{% else %}{{ module.position }}{% endif %}
                        </div>
                        <div class="flex-1 min-w-0">
                            <h2 class="font-semibold {{ done ? 'text-foreground' : '' }}">{{ module.title }}</h2>
                            <p class="mt-1 text-sm text-muted-foreground">{{ module.description ?: module.durationMinutes ~ ' minutes' }}</p>
                            {% if module.materials|length > 0 %}
                                <p class="mt-2 text-xs text-muted-foreground"><i data-lucide="paperclip" class="inline h-3 w-3"></i> {{ module.materials|length }} resource{{ module.materials|length > 1 ? 's' : '' }}</p>
                            {% endif %}
                        </div>
                        {% if done %}
                            <span class="shrink-0 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">Done</span>
                        {% else %}
                            <span class="shrink-0 rounded-full bg-primary/10 px-2.5 py-0.5 text-[10px] font-bold text-primary">Open</span>
                        {% endif %}
                    </div>
                {% else %}
                    {% include 'components/_empty_state.html.twig' with {icon: 'book-open', title: 'No modules yet', description: 'The trainer hasn\'t added any modules to this formation.'} %}
                {% endfor %}
            </section>
        </div>

        {# ── Progress Sidebar ── #}
        <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
            <div class="glass-panel p-5">
                <h3 class="text-sm font-semibold text-foreground">Progress</h3>
                <div class="mt-4 flex items-center justify-center">
                    <div class="relative h-28 w-28">
                        <svg viewBox="0 0 100 100" class="h-full w-full -rotate-90">
                            <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" class="text-muted" stroke-width="8"/>
                            <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" class="text-primary" stroke-width="8" stroke-dasharray="{{ 264 }}" stroke-dashoffset="{{ 264 - (264 * progress_percent / 100) }}" stroke-linecap="round"/>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <span class="text-2xl font-light tracking-holographic">{{ progress_percent }}%</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 flex justify-between text-xs text-muted-foreground">
                    <span>{{ completed_module_ids|length }} / {{ enrollment.formation.modules|length }} modules</span>
                </div>
            </div>
            <div class="glass-panel p-5">
                <h3 class="text-sm font-semibold text-foreground">Quick nav</h3>
                <div class="mt-3 space-y-1">
                    {% for module in enrollment.formation.modules %}
                    {% set done = module.id in completed_module_ids %}
                    <div class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-xs cursor-pointer hover:bg-muted/50 transition {{ done ? 'text-foreground' : 'text-muted-foreground' }}"
                         @click="openModule({{ module.id }}, '{{ module.title|e('js') }}', '{{ module.description|default('')|e('js') }}', {{ module.durationMinutes }}, {{ done ? 'true' : 'false' }}, {{ module.materials|length }})">
                        <div class="h-1.5 w-1.5 rounded-full {{ done ? 'bg-emerald-500' : 'bg-muted-foreground/40' }}"></div>
                        <span class="truncate">{{ module.title }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% if enrollment.certificate %}
            <div class="glass-panel p-5 border-emerald-500/20">
                <h3 class="text-sm font-semibold text-emerald-400">Certificate</h3>
                <p class="mt-1 text-xs text-muted-foreground">Issued {{ enrollment.certificate.issuedAt|date('M d, Y') }}</p>
                <div class="mt-3 space-y-2">
                    <a href="{{ path('app_certificate_show', {id: enrollment.certificate.id}) }}" class="flex items-center gap-2 text-xs font-semibold text-primary hover:underline"><i data-lucide="eye" class="h-3 w-3"></i> View</a>
                    <a href="{{ path('app_certificate_download', {id: enrollment.certificate.id}) }}" class="flex items-center gap-2 text-xs font-semibold text-primary hover:underline"><i data-lucide="download" class="h-3 w-3"></i> Download PDF</a>
                    <a href="{{ path('app_certificate_qr', {id: enrollment.certificate.id}) }}" class="flex items-center gap-2 text-xs font-semibold text-primary hover:underline"><i data-lucide="qr-code" class="h-3 w-3"></i> QR / Share</a>
                </div>
            </div>
            {% endif %}
        </aside>
    </div>

    {# ── Module Content Modal ── #}
    <div x-show="moduleOpen" x-transition.opacity.duration.200ms
         class="fixed inset-0 z-50 flex items-center justify-center p-4"
         @keydown.escape.window="moduleOpen = false" style="display:none;">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="moduleOpen = false"></div>
        <div class="relative z-10 w-full max-w-2xl max-h-[85vh] overflow-y-auto rounded-2xl border border-border bg-card shadow-2xl"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             @click.stop>
            {# Modal header #}
            <div class="sticky top-0 z-10 flex items-center justify-between border-b border-border/60 bg-card/95 backdrop-blur-md px-6 py-4">
                <div>
                    <h3 class="text-base font-semibold text-foreground" x-text="currentModule.title"></h3>
                    <p class="text-xs text-muted-foreground"><span x-text="currentModule.duration"></span> minutes</p>
                </div>
                <button type="button" @click="moduleOpen = false" class="flex h-8 w-8 items-center justify-center rounded-lg hover:bg-muted">
                    <i data-lucide="x" class="h-4 w-4"></i>
                </button>
            </div>

            {# Modal body #}
            <div class="p-6 space-y-5">
                <template x-if="currentModule.description">
                    <div class="rounded-xl bg-muted/30 p-4">
                        <p class="text-sm text-foreground" x-text="currentModule.description"></p>
                    </div>
                </template>

                {# Materials #}
                <div x-show="currentModule.materialsCount > 0">
                    <h4 class="text-sm font-semibold mb-3">Learning resources</h4>
                    <div id="module-materials-container" class="space-y-2">
                    </div>
                </div>

                <div x-show="currentModule.materialsCount === 0" class="rounded-xl border border-dashed border-border p-6 text-center">
                    <i data-lucide="book-open" class="mx-auto h-8 w-8 text-muted-foreground/50"></i>
                    <p class="mt-2 text-sm text-muted-foreground">No materials attached. Complete this module when ready.</p>
                </div>
            </div>

            {# Modal footer #}
            <div class="sticky bottom-0 flex items-center justify-between border-t border-border/60 bg-card/95 backdrop-blur-md px-6 py-4">
                <template x-if="currentModule.done">
                    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-500">
                        <i data-lucide="check-circle" class="h-4 w-4"></i> Completed
                    </span>
                </template>
                <template x-if="!currentModule.done">
                    <form method="post" action="{{ path('app_learning_progress', {id: enrollment.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('learning_progress_' ~ enrollment.id) }}">
                        <input type="hidden" name="module_id" :value="currentModule.id">
                        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary/90 transition">
                            <i data-lucide="check-circle" class="h-4 w-4"></i> Mark as complete
                        </button>
                    </form>
                </template>
                <button type="button" @click="moduleOpen = false" class="rounded-xl border border-border px-4 py-2.5 text-sm font-semibold hover:bg-muted">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
function learningPage() {
    return {
        moduleOpen: false,
        currentModule: { id: 0, title: '', description: '', duration: 0, done: false, materialsCount: 0 },
        openModule(id, title, description, duration, done, materialsCount) {
            this.currentModule = { id, title, description, duration, done, materialsCount };
            this.moduleOpen = true;
            document.body.style.overflow = 'hidden';
            this.$nextTick(() => this.loadMaterials(id));
        },
        loadMaterials(moduleId) {
            const container = document.getElementById('module-materials-container');
            if (!container) return;
            // Get materials from the DOM data
            const moduleEl = document.querySelector(`[data-module-id="${moduleId}"]`);
            if (moduleEl) {
                container.innerHTML = moduleEl.innerHTML;
            } else {
                container.innerHTML = '';
            }
        },
        init() {
            this.$watch('moduleOpen', (val) => {
                if (!val) document.body.style.overflow = '';
            });
        }
    };
}
</script>

{# Hidden material data for each module #}
{% for module in enrollment.formation.modules %}
<template data-module-id="{{ module.id }}">
    {% for material in module.materials %}
        <a href="{{ material.resourceUrl }}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 rounded-xl border border-border bg-background/50 p-3 text-sm transition hover:border-primary/40 hover:bg-muted/30">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10">
                <i data-lucide="{{ material.kind == 'video' ? 'play-circle' : (material.kind == 'pdf' ? 'file-text' : 'link') }}" class="h-4 w-4 text-primary"></i>
            </div>
            <div class="flex-1 min-w-0">
                <p class="font-medium truncate">{{ material.title }}</p>
                <p class="text-xs text-muted-foreground">{{ material.kind|default('link') }}</p>
            </div>
            <i data-lucide="external-link" class="h-4 w-4 text-muted-foreground"></i>
        </a>
    {% endfor %}
</template>
{% endfor %}
{% endblock %}
