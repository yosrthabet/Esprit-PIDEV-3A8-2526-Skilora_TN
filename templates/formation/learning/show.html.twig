{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}{{ enrollment.formation.title }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Learning</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">{{ enrollment.formation.title }}</h1>
        <div class="mt-5 h-2 rounded-full bg-muted"><div class="h-2 rounded-full bg-primary" style="width: {{ progress_percent }}%"></div></div>
        <p class="mt-2 text-sm text-muted-foreground">{{ progress_percent }}% complete</p>
        {% if enrollment.certificate %}
            <a href="{{ path('app_certificates') }}" class="mt-4 inline-flex rounded-xl bg-primary px-5 py-3 text-sm font-bold text-primary-foreground">View certificate</a>
        {% endif %}
    </section>
    <section class="space-y-3">
        {% for module in enrollment.formation.modules %}
            {% set done = module.id in completed_module_ids %}
            <div class="glass-panel flex items-center justify-between gap-4 p-5">
                <div>
                    <h2 class="font-semibold">{{ module.position }}. {{ module.title }}</h2>
                    <p class="mt-1 text-sm text-muted-foreground">{{ module.description ?: module.durationMinutes ~ ' minutes' }}</p>
                    {% if module.materials|length > 0 %}
                        <div class="mt-3 flex flex-wrap gap-2">
                            {% for material in module.materials %}
                                <a href="{{ material.resourceUrl }}" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground">{{ material.title }}</a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                {% if done %}
                    <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-600">Complete</span>
                {% else %}
                    <form method="post" action="{{ path('app_learning_progress', {id: enrollment.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('learning_progress_' ~ enrollment.id) }}">
                        <input type="hidden" name="module_id" value="{{ module.id }}">
                        <button class="rounded-xl border border-border px-4 py-2 text-sm font-bold">Mark complete</button>
                    </form>
                {% endif %}
            </div>
        {% else %}
            <div class="glass-panel p-10 text-center text-muted-foreground">This formation has no modules yet.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
