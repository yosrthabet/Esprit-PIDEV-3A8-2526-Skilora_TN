{% extends 'layouts/adaptive.html.twig' %}

{% block page_title %}Withdraw Funds{% endblock %}

{% block content %}
<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# ── Request Payout ── #}
    <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-6 shadow-sm">
        <h2 class="text-xs font-black uppercase tracking-[0.2em]">Request Withdrawal</h2>

        {% if bank_accounts is empty %}
            <div class="mt-4 rounded-2xl border border-dashed border-border bg-background/50 p-6 text-center">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-muted"><i data-lucide="landmark" class="h-7 w-7 text-muted-foreground/50"></i></div>
                <p class="mt-3 text-sm text-muted-foreground">You need to add a bank account before requesting a payout.</p>
                <a href="{{ path('app_finance_bank_accounts') }}" class="mt-3 inline-flex rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Add Bank Account</a>
            </div>
        {% else %}
            <form method="post" action="{{ path('app_finance_payout_request') }}" class="mt-4 space-y-4 max-w-lg">
                <input type="hidden" name="_token" value="{{ csrf_token('payout_request') }}">
                <div>
                    <label class="block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground mb-1.5">Bank Account</label>
                    <select name="bank_account_id" required class="w-full rounded-2xl border border-border bg-background/70 px-3 py-2.5 text-sm">
                        {% for account in bank_accounts %}
                            <option value="{{ account.id }}">{{ account.bankName }} — {{ account.maskedIban }} ({{ account.accountHolder }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground mb-1.5">Amount (TND)</label>
                    <input type="number" name="amount" step="0.01" min="1" required placeholder="0.00" class="w-full rounded-2xl border border-border bg-background/70 px-3 py-2.5 text-sm">
                </div>
                <div>
                    <label class="block text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground mb-1.5">Note (optional)</label>
                    <textarea name="note" rows="2" placeholder="Any additional details…" class="w-full rounded-2xl border border-border bg-background/70 px-3 py-2.5 text-sm resize-none"></textarea>
                </div>
                <button type="submit" class="inline-flex rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">
                    <i data-lucide="arrow-up-right" class="mr-1.5 inline h-4 w-4"></i> Submit Withdrawal Request
                </button>
            </form>
        {% endif %}
    </section>

    {# ── History ── #}
    <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-6 shadow-sm">
        <h2 class="text-xs font-black uppercase tracking-[0.2em]">Withdrawal History</h2>

        {% if payouts is empty %}
            <p class="mt-4 rounded-2xl border border-dashed border-border bg-background/50 p-6 text-sm text-muted-foreground text-center">No withdrawal requests yet.</p>
        {% else %}
            <div class="mt-4 overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-border/50 text-left text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">
                            <th class="pb-3 pr-4">#</th>
                            <th class="pb-3 pr-4">Amount</th>
                            <th class="pb-3 pr-4">Bank Account</th>
                            <th class="pb-3 pr-4">Status</th>
                            <th class="pb-3 pr-4">Date</th>
                            <th class="pb-3">Admin Note</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/30">
                        {% for payout in payouts %}
                            <tr class="hover:bg-muted/20 transition">
                                <td class="py-3 pr-4 font-mono text-xs text-muted-foreground">{{ payout.id }}</td>
                                <td class="py-3 pr-4 font-bold">{{ payout.amount }} {{ payout.currency.value }}</td>
                                <td class="py-3 pr-4 text-muted-foreground">{{ payout.bankAccount.bankName }} — {{ payout.bankAccount.maskedIban }}</td>
                                <td class="py-3 pr-4">
                                    {% set statusColor = {
                                        'pending': 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
                                        'approved': 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400',
                                        'processing': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
                                        'completed': 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
                                        'rejected': 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400',
                                    } %}
                                    <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-black uppercase tracking-wider {{ statusColor[payout.status.value] ?? 'bg-muted text-muted-foreground' }}">
                                        {{ payout.status.value }}
                                    </span>
                                </td>
                                <td class="py-3 pr-4 text-muted-foreground text-xs">{{ payout.createdAt|date('M d, Y H:i') }}</td>
                                <td class="py-3 text-xs text-muted-foreground">{{ payout.adminNote ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
