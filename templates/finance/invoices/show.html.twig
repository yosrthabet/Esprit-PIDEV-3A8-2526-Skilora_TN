{% extends 'layouts/adaptive.html.twig' %}

{% block page_title %}Invoice {{ invoice.number }}{% endblock %}

{% block content %}
{% set contract = invoice.contract %}
{% set application = contract.hireOffer.application %}
<div class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8 print:border-0 print:shadow-none">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <a href="{{ path('app_finance_invoices') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-muted-foreground hover:text-foreground"><i data-lucide="arrow-left" class="h-4 w-4"></i>Back to invoices</a>
                <p class="mt-6 text-xs font-bold uppercase tracking-label text-primary">Invoice</p>
                <h1 class="mt-2 text-4xl font-light tracking-holographic">{{ invoice.number }}</h1>
                <p class="mt-2 text-sm text-muted-foreground">Generated from contract <a href="{{ path('app_contract_show', {id: contract.id}) }}" class="font-semibold text-primary hover:underline">{{ application.jobOffer.title }}</a>.</p>
            </div>
            <button type="button" onclick="window.print()" class="rounded-xl border border-border px-4 py-2 text-sm font-bold print:hidden">Print</button>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
                <p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Status</p>
                <p class="mt-2 text-2xl font-light">{{ invoice.status.label }}</p>
            </div>
            <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
                <p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Issued</p>
                <p class="mt-2 text-2xl font-light">{{ invoice.issuedAt|date('M d, Y') }}</p>
            </div>
            <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
                <p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Paid</p>
                <p class="mt-2 text-2xl font-light">{{ invoice.paidAt ? invoice.paidAt|date('M d, Y') : 'Not paid' }}</p>
            </div>
        </div>

        <div class="mt-8 grid gap-6 md:grid-cols-2">
            <section class="rounded-2xl border border-border/60 bg-background/60 p-5">
                <p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Issuer</p>
                <p class="mt-3 font-semibold">{{ invoice.issuer.displayName }}</p>
                <p class="mt-1 text-sm text-muted-foreground">{{ invoice.issuer.email }}</p>
            </section>
            <section class="rounded-2xl border border-border/60 bg-background/60 p-5">
                <p class="text-xs font-bold uppercase tracking-label text-muted-foreground">Recipient</p>
                <p class="mt-3 font-semibold">{{ invoice.recipient.displayName }}</p>
                <p class="mt-1 text-sm text-muted-foreground">{{ invoice.recipient.email }}</p>
            </section>
        </div>

        <section class="mt-8 overflow-hidden rounded-2xl border border-border/60">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-border bg-background/60 text-left text-xs uppercase tracking-label text-muted-foreground">
                        <th class="px-4 py-3 font-semibold">Description</th>
                        <th class="px-4 py-3 text-right font-semibold">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="px-4 py-4">
                            <p class="font-medium">Service delivery for {{ application.jobOffer.title }}</p>
                            <p class="mt-1 text-xs text-muted-foreground">Contract #{{ contract.id }} · {{ application.jobOffer.companyLabel }}</p>
                        </td>
                        <td class="px-4 py-4 text-right font-semibold">{{ invoice.amount ?: '0.00' }} {{ invoice.currency.value }}</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="border-t border-border bg-background/60">
                        <td class="px-4 py-4 text-right text-xs font-bold uppercase tracking-label text-muted-foreground">Total</td>
                        <td class="px-4 py-4 text-right text-lg font-bold">{{ invoice.amount ?: '0.00' }} {{ invoice.currency.value }}</td>
                    </tr>
                </tfoot>
            </table>
        </section>
    </section>
</div>
{% endblock %}
