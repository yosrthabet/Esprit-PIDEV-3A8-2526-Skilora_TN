{% extends 'layouts/adaptive.html.twig' %}

{% block page_title %}Finance{% endblock %}

{% block content %}
<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# ── Hero ── #}
    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(99,102,241,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-indigo-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_36rem] lg:items-end">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Finance dashboard</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Contracts,<br class="hidden sm:block"> invoices & escrow.</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">Internal finance ledger from accepted hire offers. Manage contracts, track escrow, review disputes.</p>
                <div class="mt-6 flex flex-wrap gap-2">
                    <a href="{{ path('app_contracts') }}" class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur transition hover:bg-white/15">
                        <i data-lucide="file-signature" class="mr-1.5 inline h-3.5 w-3.5"></i> Contracts
                    </a>
                    <a href="{{ path('app_finance_analytics') }}" class="rounded-full bg-white px-4 py-2 text-sm font-bold text-black shadow-sm transition hover:shadow-md">
                        <i data-lucide="bar-chart-3" class="mr-1.5 inline h-3.5 w-3.5"></i> Analytics
                    </a>
                    <a href="{{ path('app_finance_calculator') }}" class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur transition hover:bg-white/15">
                        <i data-lucide="calculator" class="mr-1.5 inline h-3.5 w-3.5"></i> Salary Calculator
                    </a>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ contract_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Contracts</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ active_escrow_total|number_format(0, '.', ',') }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Escrow</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ paid_invoice_total|number_format(0, '.', ',') }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Paid</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ open_dispute_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Disputes</p>
                </div>
            </div>
        </div>
    </section>

    {# ── Contract status ── #}
    <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
        <h2 class="text-xs font-black uppercase tracking-[0.2em]">Contract status</h2>
        <p class="mt-1 text-sm text-muted-foreground">Counts across contracts where you are the employer or freelancer.</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
            {% for status, count in status_counts %}
                <div class="rounded-2xl border border-border/60 bg-background/60 p-4">
                    <p class="text-2xl font-light">{{ count }}</p>
                    <p class="mt-1 text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">{{ status|replace({'_': ' '})|title }}</p>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="grid gap-6 xl:grid-cols-[1.25fr_1fr]">
        {# ── Escrow ledger ── #}
        <article class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Recent escrow ledger</h2>
            <p class="mt-1 text-sm text-muted-foreground">Internal ledger events created by contract finance actions.</p>
            <div class="mt-4 overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-border text-left text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">
                            <th class="py-3 pr-4">Type</th>
                            <th class="py-3 pr-4">Contract</th>
                            <th class="py-3 pr-4 text-right">Amount</th>
                            <th class="py-3 text-right">Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/50">
                        {% for transaction in recent_transactions %}
                            {% set contract = transaction.contract %}
                            {% set application = contract.hireOffer.application %}
                            <tr class="hover:bg-muted/20 transition">
                                <td class="py-3 pr-4"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-black text-primary">{{ transaction.type.label }}</span></td>
                                <td class="py-3 pr-4"><a href="{{ path('app_contract_show', {id: contract.id}) }}" class="font-bold hover:text-primary transition">{{ application.jobOffer.title }}</a></td>
                                <td class="py-3 pr-4 text-right font-bold">{{ transaction.amount ?: '0.00' }} {{ transaction.currency.value }}</td>
                                <td class="py-3 text-right text-muted-foreground">{{ transaction.createdAt|date('M d, Y') }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="py-8 text-center text-muted-foreground">No escrow ledger entries yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </article>

        <aside class="space-y-6">
            {# ── Disputes ── #}
            <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
                <h2 class="text-xs font-black uppercase tracking-[0.2em]">Open disputes</h2>
                <div class="mt-4 space-y-3">
                    {% for dispute in open_disputes %}
                        {% set contract = dispute.contract %}
                        {% set application = contract.hireOffer.application %}
                        <article class="rounded-2xl border border-border/60 bg-background/60 p-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="font-bold">{{ dispute.reason }}</p>
                                    <p class="mt-1 text-[11px] text-muted-foreground">{{ application.jobOffer.title }} · {{ dispute.createdAt|date('M d, Y') }}</p>
                                </div>
                                <a href="{{ path('app_contract_show', {id: contract.id}) }}" class="rounded-full border border-border px-3 py-1.5 text-xs font-bold hover:bg-muted transition">Open</a>
                            </div>
                        </article>
                    {% else %}
                        <p class="rounded-2xl border border-dashed border-border bg-background/50 p-4 text-sm text-muted-foreground text-center">No open disputes.</p>
                    {% endfor %}
                </div>
            </section>

            {# ── Recent contracts ── #}
            <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
                <h2 class="text-xs font-black uppercase tracking-[0.2em]">Recent contracts</h2>
                <div class="mt-4 space-y-3">
                    {% for contract in contracts %}
                        {% set application = contract.hireOffer.application %}
                        <a href="{{ path('app_contract_show', {id: contract.id}) }}" class="block rounded-2xl border border-border/60 bg-background/60 p-4 transition hover:border-primary/40 hover:shadow-sm">
                            <span class="rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-black text-primary">{{ contract.status.label }}</span>
                            <p class="mt-3 font-bold">{{ application.jobOffer.title }}</p>
                            <p class="mt-1 text-xs text-muted-foreground">{{ contract.amount ?: 'Negotiable' }} {{ contract.currency.value }}</p>
                        </a>
                    {% else %}
                        <p class="rounded-2xl border border-dashed border-border bg-background/50 p-4 text-sm text-muted-foreground text-center">No contracts yet.</p>
                    {% endfor %}
                </div>
            </section>
        </aside>
    </section>
</div>
{% endblock %}
