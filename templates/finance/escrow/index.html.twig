{% extends 'layouts/adaptive.html.twig' %}

{% block page_title %}Escrow Ledger{% endblock %}

{% block content %}
<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# ── Hero ── #}
    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(16,185,129,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-emerald-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-6">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Internal escrow ledger</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Escrow transactions</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">Internal platform ledger state created by contract actions. Not real payment gateway movement.</p>
            </div>
            <a href="{{ path('app_finance') }}" class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur transition hover:bg-white/15">Finance dashboard</a>
        </div>
    </section>

    {# ── Table ── #}
    <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-border text-left text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">
                        <th class="py-3 pr-4">Type</th>
                        <th class="py-3 pr-4">Contract</th>
                        <th class="py-3 pr-4">Status</th>
                        <th class="py-3 pr-4 text-right">Amount</th>
                        <th class="py-3 text-right">Created</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/50">
                    {% for transaction in transactions %}
                        {% set contract = transaction.contract %}
                        {% set application = contract.hireOffer.application %}
                        <tr class="hover:bg-muted/20 transition">
                            <td class="py-3 pr-4"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-black text-primary">{{ transaction.type.label }}</span></td>
                            <td class="py-3 pr-4"><a href="{{ path('app_contract_show', {id: contract.id}) }}" class="font-bold hover:text-primary transition">{{ application.jobOffer.title }}</a></td>
                            <td class="py-3 pr-4 text-muted-foreground">{{ transaction.status|title }}</td>
                            <td class="py-3 pr-4 text-right font-bold">{{ transaction.amount ?: '0.00' }} {{ transaction.currency.value }}</td>
                            <td class="py-3 text-right text-muted-foreground">{{ transaction.createdAt|date('M d, Y H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="py-12 text-center text-muted-foreground">No escrow ledger entries yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
