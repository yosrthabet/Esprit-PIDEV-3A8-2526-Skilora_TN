{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Contracts{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8">
        <p class="text-xs font-bold uppercase tracking-label text-primary">Finance bridge</p>
        <h1 class="mt-2 text-4xl font-light tracking-holographic">Contracts</h1>
        <p class="mt-2 text-muted-foreground">Accepted hire offers become contracts. Funding escrow activates the work.</p>
    </section>
    <section class="grid gap-4 lg:grid-cols-2">
        {% for contract in contracts %}
            {% set offer = contract.hireOffer %}
            {% set application = offer.application %}
            <a href="{{ path('app_contract_show', {id: contract.id}) }}" class="glass-panel p-5 transition hover:border-primary/40">
                <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ contract.status.label }}</span>
                <h2 class="mt-3 text-xl font-semibold">{{ application.jobOffer.title }}</h2>
                <p class="mt-1 text-sm text-muted-foreground">{{ application.jobOffer.companyLabel }} · {{ contract.amount ?: 'Negotiable' }} {{ contract.currency.value }}</p>
                <p class="mt-3 text-xs text-muted-foreground">Created {{ contract.createdAt|date('M d, Y') }}</p>
            </a>
        {% else %}
            <div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No contracts yet. Accept a hire offer to create one.</div>
        {% endfor %}
    </section>
</div>
{% endblock %}
