{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Contract{% endblock %}
{% block content %}
{% set offer = contract.hireOffer %}
{% set application = offer.application %}
{% set is_employer = app.user.id == contract.employer.id|default(null) %}
{% set is_freelancer = app.user.id == contract.freelancer.id %}
<div class="mx-auto grid max-w-[94rem] gap-6 px-4 py-6 lg:grid-cols-[1fr_24rem] sm:px-6 lg:px-8">

    {# Flash messages (full-width, outside grid) #}
    {% for type in ['success', 'error', 'info'] %}
        {% for msg in app.flashes(type) %}
            <div class="col-span-full rounded-xl border p-4 text-sm
                {{ type == 'success' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400' : '' }}
                {{ type == 'error' ? 'border-destructive/30 bg-destructive/10 text-destructive' : '' }}
                {{ type == 'info' ? 'border-blue-500/30 bg-blue-500/10 text-blue-400' : '' }}
            ">{{ msg }}</div>
        {% endfor %}
    {% endfor %}

    <article class="space-y-6">
        {# ── Hero ── #}
        <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(99,102,241,.28))">
            <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-indigo-500/30 blur-3xl"></div>
            <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
            <div class="relative">
                <a href="{{ path('app_contracts') }}" class="inline-flex items-center gap-2 text-sm font-bold text-white/60 transition hover:text-white"><i data-lucide="arrow-left" class="h-4 w-4"></i> Back to contracts</a>
                <div class="mt-5 flex flex-wrap items-center gap-2">
                    <span class="rounded-full border border-white/20 bg-white/15 px-3 py-1 text-[10px] font-black uppercase tracking-wide backdrop-blur">{{ contract.status.label }}</span>
                    {% if contract.escrowFundedAt %}<span class="rounded-full border border-emerald-400/30 bg-emerald-500/20 px-3 py-1 text-[10px] font-black uppercase tracking-wide text-emerald-300 backdrop-blur">Escrow funded</span>{% endif %}
                </div>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">{{ application.jobOffer.title }}</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">{{ application.jobOffer.companyLabel }} · {{ contract.amount ?: 'Negotiable' }} {{ contract.currency.value }}</p>
                <div class="mt-6 grid grid-cols-3 gap-3">
                    <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                        <p class="text-3xl font-light">{{ contract.status.label }}</p>
                        <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">State</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                        <p class="text-3xl font-light">{{ contract.amount ?: '—' }}</p>
                        <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Amount</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                        <p class="text-3xl font-light">{{ offer.contractType ?: 'Contract' }}</p>
                        <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Type</p>
                    </div>
                </div>
            </div>
        </section>

        {# ── Lifecycle timeline ── #}
        {% set steps = [
            {key: 'pending_funding', label: 'Awaiting escrow', icon: 'wallet', done: contract.escrowFundedAt is not null},
            {key: 'active',          label: 'Work in progress', icon: 'briefcase', done: contract.submittedAt is not null},
            {key: 'submitted',       label: 'Delivery submitted', icon: 'send', done: contract.approvedAt is not null},
            {key: 'approved',        label: 'Delivery approved', icon: 'check-circle', done: contract.releasedAt is not null},
            {key: 'closed',          label: 'Escrow released', icon: 'banknote', done: contract.releasedAt is not null}
        ] %}
        <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Contract lifecycle</h2>
            <div class="mt-5 flex items-start gap-0">
                {% for step in steps %}
                    {% set is_current = contract.status.value == step.key %}
                    <div class="flex flex-1 flex-col items-center text-center">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full
                            {{ step.done ? 'bg-emerald-500 text-white' : (is_current ? 'bg-primary text-primary-foreground ring-2 ring-primary/40' : 'bg-muted text-muted-foreground') }}">
                            <i data-lucide="{{ step.done ? 'check' : step.icon }}" class="h-4 w-4"></i>
                        </div>
                        <p class="mt-2 text-[10px] font-bold {{ step.done ? 'text-emerald-400' : (is_current ? 'text-primary' : 'text-muted-foreground') }}">{{ step.label }}</p>
                    </div>
                    {% if not loop.last %}
                        <div class="mt-5 h-0.5 flex-1 {{ step.done ? 'bg-emerald-500/50' : 'bg-border' }}"></div>
                    {% endif %}
                {% endfor %}
            </div>
        </section>

        {# ── Wallet credit notice for freelancer ── #}
        {% if is_freelancer and contract.status.value == 'closed' %}
            <section class="rounded-[1.75rem] border border-emerald-500/30 bg-emerald-500/5 p-5">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500/15">
                        <i data-lucide="wallet" class="h-5 w-5 text-emerald-500"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-emerald-400">Funds added to your wallet</p>
                        <p class="text-xs text-muted-foreground">{{ contract.amount }} {{ contract.currency.value }} has been credited. You can withdraw from your wallet at any time.</p>
                    </div>
                    <a href="{{ path('app_finance_wallet') }}" class="ml-auto shrink-0 rounded-full bg-emerald-600 px-4 py-2 text-xs font-bold text-white hover:bg-emerald-700 transition">Go to wallet</a>
                </div>
            </section>
        {% endif %}

        {# ── Pending funding notice for freelancer ── #}
        {% if is_freelancer and contract.status.value == 'pending_funding' %}
            <section class="rounded-[1.75rem] border border-amber-500/30 bg-amber-500/5 p-5">
                <div class="flex items-center gap-3">
                    <i data-lucide="clock" class="h-5 w-5 text-amber-500"></i>
                    <div>
                        <p class="text-sm font-semibold text-amber-400">Waiting for employer to fund escrow</p>
                        <p class="text-xs text-muted-foreground">The employer needs to fund the escrow before work can begin. You'll be notified when it's ready.</p>
                    </div>
                </div>
            </section>
        {% endif %}

        {# ── Terms ── #}
        {% if offer.benefits %}
        <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Terms / benefits</h2>
            <p class="mt-4 whitespace-pre-line text-sm text-muted-foreground">{{ offer.benefits }}</p>
        </section>
        {% endif %}

        {# ── Deliveries ── #}
        <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Deliveries</h2>
            <div class="mt-4 space-y-3">
                {% for delivery in contract.deliveries %}
                    <article class="rounded-2xl border border-border/60 bg-background/60 p-4">
                        <div class="flex flex-wrap items-center justify-between gap-3"><h3 class="font-bold">{{ delivery.title }}</h3><span class="text-[11px] text-muted-foreground">{{ delivery.createdAt|date('M d, Y H:i') }}</span></div>
                        <p class="mt-2 whitespace-pre-line text-sm text-muted-foreground">{{ delivery.message }}</p>
                        {% if delivery.attachmentUrl %}<a href="{{ delivery.attachmentUrl }}" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-sm font-bold text-primary hover:underline">Open attachment</a>{% endif %}
                    </article>
                {% else %}
                    <p class="rounded-2xl border border-dashed border-border bg-background/50 p-4 text-sm text-muted-foreground text-center">No delivery submitted yet.</p>
                {% endfor %}
            </div>
        </section>

        {# ── Escrow & invoices ── #}
        <section class="grid gap-4 lg:grid-cols-2">
            <div class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
                <h2 class="text-xs font-black uppercase tracking-[0.2em]">Escrow ledger</h2>
                <div class="mt-3 space-y-2 text-sm text-muted-foreground">
                    {% for transaction in contract.transactions %}<p><span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-black text-primary">{{ transaction.type.label }}</span> · {{ transaction.amount ?: '—' }} {{ transaction.currency.value }} · {{ transaction.status }}</p>{% else %}<p class="text-center">No escrow ledger entries yet.</p>{% endfor %}
                </div>
            </div>
            <div class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
                <h2 class="text-xs font-black uppercase tracking-[0.2em]">Invoices</h2>
                <div class="mt-3 space-y-2 text-sm text-muted-foreground">
                    {% for invoice in contract.invoices %}<p><span class="font-bold text-foreground">{{ invoice.number }}</span> · {{ invoice.status.label }} · {{ invoice.amount ?: '—' }} {{ invoice.currency.value }}</p>{% else %}<p class="text-center">No invoice generated yet.</p>{% endfor %}
                </div>
            </div>
        </section>

        {# ── Milestones ── #}
        <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-xs font-black uppercase tracking-[0.2em]">Milestones</h2>
                <p class="text-[11px] text-muted-foreground">Internal milestone schedule. Real payment provider wiring comes later.</p>
            </div>
            <div class="mt-4 space-y-3">
                {% for milestone in milestones|default([]) %}
                    <article class="rounded-2xl border border-border/60 bg-background/60 p-4">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div><h3 class="font-bold">{{ milestone.title }}</h3><p class="mt-1 text-sm text-muted-foreground">{{ milestone.description ?: 'No description.' }}</p></div>
                            <span class="rounded-full bg-muted px-2.5 py-1 text-[10px] font-black">{{ milestone.status|title }}</span>
                        </div>
                        <p class="mt-3 text-sm text-muted-foreground"><span class="font-bold text-foreground">{{ milestone.amount }} {{ milestone.currency.value }}</span>{% if milestone.dueAt %} · due {{ milestone.dueAt|date('M d, Y') }}{% endif %}</p>
                        {% if is_employer and milestone.status == 'pending' %}
                            <div class="mt-3 flex gap-2">
                                <form method="post" action="{{ path('app_contract_milestone_pay', {contract: contract.id, milestone: milestone.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('milestone_pay_' ~ milestone.id) }}"><button class="rounded-full bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Mark paid</button></form>
                                <form method="post" action="{{ path('app_contract_milestone_cancel', {contract: contract.id, milestone: milestone.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('milestone_cancel_' ~ milestone.id) }}"><button class="rounded-full border border-border px-4 py-2 text-xs font-bold hover:bg-muted transition">Cancel</button></form>
                            </div>
                        {% endif %}
                    </article>
                {% else %}
                    <p class="rounded-2xl border border-dashed border-border bg-background/50 p-5 text-sm text-muted-foreground text-center">No milestones have been created yet.</p>
                {% endfor %}
            </div>
        </section>
    </article>

    {# ── Sidebar ── #}
    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Escrow</h2>
            <p class="mt-2 text-sm text-muted-foreground">Internal escrow state. Payment gateway wiring remains separate.</p>
            {% if is_employer and contract.status.value == 'pending_funding' %}<form method="post" action="{{ path('app_contract_fund', {id: contract.id}) }}" class="mt-4"><input type="hidden" name="_token" value="{{ csrf_token('fund_contract_' ~ contract.id) }}"><button class="w-full rounded-full bg-primary px-4 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Mark escrow funded</button></form>{% endif %}
        </div>
        {% if is_freelancer and contract.status.value == 'active' %}
        <form method="post" action="{{ path('app_contract_delivery_submit', {id: contract.id}) }}" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm space-y-3">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Submit delivery</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('submit_delivery_' ~ contract.id) }}">
            <input name="title" required placeholder="Delivery title" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <textarea name="message" required rows="4" placeholder="What did you deliver?" class="w-full rounded-2xl border border-border bg-background/70 px-3 py-2 text-sm"></textarea>
            <input name="attachment_url" placeholder="Attachment URL" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <button class="w-full rounded-full bg-primary px-4 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Submit</button>
        </form>
        {% endif %}
        {% if is_employer and contract.status.value == 'submitted' %}
        <form method="post" action="{{ path('app_contract_approve', {id: contract.id}) }}" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <input type="hidden" name="_token" value="{{ csrf_token('approve_contract_' ~ contract.id) }}">
            <button class="w-full rounded-full bg-primary px-4 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Approve delivery</button>
        </form>
        {% endif %}
        {% if is_employer and contract.status.value == 'approved' %}
        <form method="post" action="{{ path('app_contract_release', {id: contract.id}) }}" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
            <input type="hidden" name="_token" value="{{ csrf_token('release_contract_' ~ contract.id) }}">
            <button class="w-full rounded-full bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:shadow-md hover:bg-emerald-700">Release escrow</button>
        </form>
        {% endif %}
        {% if contract.status.value in ['active', 'submitted', 'approved'] %}
        <form method="post" action="{{ path('app_contract_dispute', {id: contract.id}) }}" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm space-y-3">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Open dispute</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('dispute_contract_' ~ contract.id) }}">
            <input name="reason" required placeholder="Reason" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <textarea name="details" rows="3" placeholder="Details" class="w-full rounded-2xl border border-border bg-background/70 px-3 py-2 text-sm"></textarea>
            <button class="w-full rounded-full border border-border px-4 py-3 text-sm font-bold hover:bg-muted transition">Open dispute</button>
        </form>
        {% endif %}
        {% if is_employer %}
        <form method="post" action="{{ path('app_contract_milestone_create', {id: contract.id}) }}" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm space-y-3">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Add milestone</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('milestone_new_' ~ contract.id) }}">
            <input name="title" required placeholder="Milestone title" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <input name="amount" required inputmode="decimal" placeholder="Amount" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <textarea name="description" rows="3" placeholder="Description" class="w-full rounded-2xl border border-border bg-background/70 px-3 py-2 text-sm"></textarea>
            <input name="due_at" type="date" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <button class="w-full rounded-full bg-primary px-4 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Create milestone</button>
        </form>
        {% endif %}
        {% if contract.status.value == 'closed' %}
        <form method="post" action="{{ path('app_contract_review', {id: contract.id}) }}" class="rounded-[1.75rem] border border-emerald-500/20 bg-card/70 p-5 shadow-sm space-y-3" x-data="{ rating: 5 }">
            <h2 class="text-xs font-black uppercase tracking-[0.2em] text-emerald-400">Leave a review</h2>
            <p class="text-xs text-muted-foreground">Rate your experience with {{ is_freelancer ? 'the employer' : 'the freelancer' }}.</p>
            <input type="hidden" name="_token" value="{{ csrf_token('review_contract_' ~ contract.id) }}">
            <div class="flex items-center gap-1">
                <template x-for="star in [1,2,3,4,5]">
                    <button type="button" @click="rating = star" class="text-2xl transition" :class="star <= rating ? 'text-amber-400' : 'text-muted-foreground/30'">★</button>
                </template>
                <input type="hidden" name="rating" :value="rating">
            </div>
            <input name="communication" type="number" min="1" max="5" placeholder="Communication (1-5)" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <input name="quality" type="number" min="1" max="5" placeholder="Quality (1-5)" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <input name="timeliness" type="number" min="1" max="5" placeholder="Timeliness (1-5)" class="h-10 w-full rounded-2xl border border-border bg-background/70 px-3 text-sm">
            <textarea name="comment" rows="3" placeholder="Your experience..." class="w-full rounded-2xl border border-border bg-background/70 px-3 py-2 text-sm"></textarea>
            <button class="w-full rounded-full bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:shadow-md hover:bg-emerald-700">Submit review</button>
        </form>
        {% endif %}
    </aside>
</div>
{% endblock %}
