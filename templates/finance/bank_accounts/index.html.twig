{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Bank Accounts{% endblock %}
{% block content %}
<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# ── Hero ── #}
    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(245,158,11,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-amber-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-6">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Payout settings</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Bank accounts</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">Store payout destinations with masked IBAN display.</p>
            </div>
            <div class="rounded-3xl border border-white/10 bg-white/10 px-5 py-3 backdrop-blur">
                <p class="text-3xl font-light">{{ accounts|length }}</p>
                <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Accounts</p>
            </div>
        </div>
    </section>

    <div class="grid gap-6 lg:grid-cols-[24rem_1fr]">
        {# ── Add form ── #}
        <form method="post" class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm space-y-4">
            <h2 class="text-xs font-black uppercase tracking-[0.2em]">Add account</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('bank_account_new_' ~ app.user.id) }}">
            <input name="bank_name" required placeholder="Bank name" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm">
            <input name="account_holder" required placeholder="Account holder" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm">
            <input name="iban" required placeholder="IBAN" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm">
            <input name="swift" placeholder="SWIFT/BIC" class="h-11 w-full rounded-2xl border border-border bg-background/70 px-4 text-sm">
            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="primary" value="1" class="rounded"> Primary account</label>
            <button class="w-full rounded-full bg-primary px-4 py-3 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Save account</button>
        </form>

        {# ── Accounts ── #}
        <section class="grid gap-4 md:grid-cols-2">
            {% for account in accounts %}
                <article class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
                    <div class="flex justify-between gap-3">
                        <h2 class="font-bold">{{ account.bankName }}</h2>
                        {% if account.primary %}<span class="rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-black text-primary">Primary</span>{% endif %}
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground">{{ account.accountHolder }}</p>
                    <p class="mt-3 font-mono text-sm font-bold">{{ account.maskedIban }}</p>
                    <p class="mt-1 text-[11px] text-muted-foreground">{{ account.swift ?: 'No SWIFT' }}</p>
                    <form method="post" action="{{ path('app_finance_bank_account_delete', {id: account.id}) }}" class="mt-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('bank_account_delete_' ~ account.id) }}">
                        <button class="rounded-full border border-destructive/30 px-3 py-1.5 text-xs font-bold text-destructive hover:bg-destructive/10 transition">Delete</button>
                    </form>
                </article>
            {% else %}
                <div class="col-span-full rounded-[1.75rem] border border-dashed border-border bg-card/50 p-12 text-center">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-muted"><i data-lucide="landmark" class="h-8 w-8 text-muted-foreground/50"></i></div>
                    <p class="mt-4 text-sm font-bold">No bank accounts yet</p>
                </div>
            {% endfor %}
        </section>
    </div>
</div>
{% endblock %}
