{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Payslips{% endblock %}
{% block content %}
<div x-data="{ showCreate: false }" class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8 animate-fade-in">

    {% include 'components/_breadcrumbs.html.twig' with {items: [{label: 'Finance', route: 'app_admin_finance'}, {label: 'Payslips'}]} %}

    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(139,92,246,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-violet-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-6">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Admin finance</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Payslips</h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">Issue, view, and export employee payslips.</p>
            </div>
            <button @click="showCreate = true" class="rounded-full bg-white px-4 py-2 text-sm font-bold text-black shadow-sm transition hover:shadow-md">
                <i data-lucide="plus" class="mr-1.5 inline h-3.5 w-3.5"></i> Issue payslip
            </button>
        </div>
    </section>

    <section class="rounded-[1.75rem] border border-border/70 bg-card/70 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
            <thead class="border-b border-border bg-muted/40">
                <tr>
                    <th class="px-5 py-3 text-left text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Employee</th>
                    <th class="px-5 py-3 text-left text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Period</th>
                    <th class="px-5 py-3 text-right text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Gross</th>
                    <th class="px-5 py-3 text-right text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Net</th>
                    <th class="px-5 py-3 text-center text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Status</th>
                    <th class="px-5 py-3 text-right text-[11px] font-black uppercase tracking-[0.15em] text-muted-foreground">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border/40">
                {% for payslip in payslips %}
                <tr class="hover:bg-muted/20 transition">
                    <td class="px-5 py-3 font-bold">{{ payslip.employee.displayName }}</td>
                    <td class="px-5 py-3 text-muted-foreground">{{ payslip.periodStart|date('M d') }} – {{ payslip.periodEnd|date('M d, Y') }}</td>
                    <td class="px-5 py-3 text-right">{{ payslip.grossAmount }} {{ payslip.currency.value }}</td>
                    <td class="px-5 py-3 text-right font-bold">{{ payslip.netAmount }} {{ payslip.currency.value }}</td>
                    <td class="px-5 py-3 text-center">
                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-[10px] font-black
                            {% if payslip.status == 'paid' %}bg-emerald-500/10 text-emerald-600 dark:text-emerald-400
                            {% elseif payslip.status == 'pending' %}bg-amber-500/10 text-amber-600 dark:text-amber-400
                            {% else %}bg-muted text-muted-foreground{% endif %}">
                            {{ payslip.status|title }}
                        </span>
                    </td>
                    <td class="px-5 py-3 text-right">
                        <a href="{{ path('app_admin_finance_payslip_pdf', {id: payslip.id}) }}" class="inline-flex items-center gap-1 rounded-full border border-border px-3 py-1.5 text-xs font-bold transition hover:bg-muted" title="Download PDF">
                            <i data-lucide="download" class="h-3.5 w-3.5"></i> PDF
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6">
                    {% include 'components/_empty_state.html.twig' with {icon: 'file-text', title: 'No payslips yet', description: 'Issue your first payslip using the button above.'} %}
                </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    {# ── Create Payslip Modal ── #}
    <template x-teleport="body">
        <div x-show="showCreate" x-transition.opacity class="fixed inset-0 z-[9999] flex items-center justify-center p-4" @keydown.escape.window="showCreate = false">
            <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" @click="showCreate = false"></div>
            <div x-show="showCreate" x-transition class="relative w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-2xl">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-lg font-semibold">Issue new payslip</h3>
                    <button @click="showCreate = false" class="rounded-lg p-1.5 hover:bg-muted transition"><i data-lucide="x" class="h-4 w-4"></i></button>
                </div>
                <form method="post" class="space-y-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('payslip_new') }}">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-label text-muted-foreground mb-1.5">Employee</label>
                        <select name="employee_id" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                            {% for user in users %}<option value="{{ user.id }}">{{ user.displayName }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-label text-muted-foreground mb-1.5">Period start</label>
                            <input name="period_start" type="date" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-label text-muted-foreground mb-1.5">Period end</label>
                            <input name="period_end" type="date" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-label text-muted-foreground mb-1.5">Gross amount</label>
                            <input name="gross_amount" placeholder="0.00" inputmode="decimal" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-label text-muted-foreground mb-1.5">Net amount</label>
                            <input name="net_amount" placeholder="0.00" inputmode="decimal" class="h-11 w-full rounded-xl border border-border bg-background/70 px-3 text-sm">
                        </div>
                    </div>
                    <div class="flex justify-end gap-3 pt-2">
                        <button type="button" @click="showCreate = false" class="rounded-xl border border-border px-4 py-2.5 text-sm font-semibold hover:bg-muted transition">Cancel</button>
                        <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground transition hover:bg-primary/90">Issue payslip</button>
                    </div>
                </form>
            </div>
        </div>
    </template>
</div>
{% endblock %}
