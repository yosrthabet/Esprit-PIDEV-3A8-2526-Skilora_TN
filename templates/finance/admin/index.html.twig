{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Admin Finance{% endblock %}
{% block content %}
<div class="mx-auto max-w-[94rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    {# ── Hero ── #}
    <section class="relative overflow-hidden rounded-[2rem] border border-border/60 p-6 text-white shadow-2xl shadow-black/20 sm:p-8 lg:p-10" style="background:linear-gradient(135deg,rgba(24,24,27,.98),rgba(39,39,42,.94) 48%,rgba(139,92,246,.22))">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-violet-500/30 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 h-40 w-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.35em] text-white/60">Admin finance</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">Contracts, escrow,<br class="hidden sm:block"> disputes.</h1>
                <div class="mt-6 flex flex-wrap gap-2">
                    <a href="{{ path('app_admin_finance_exchange_rates') }}" class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur transition hover:bg-white/15">Exchange Rates</a>
                    <a href="{{ path('app_admin_finance_payslips') }}" class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur transition hover:bg-white/15">Payslips</a>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ total_contracts }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Contracts</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ active_escrow_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Escrows</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-2xl font-light">{{ total_volume }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Volume</p>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur">
                    <p class="text-3xl font-light">{{ open_dispute_count }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">Disputes</p>
                </div>
            </div>
        </div>
    </section>

    {# ── Open disputes ── #}
    <section class="rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm">
        <h2 class="text-xs font-black uppercase tracking-[0.2em]">Open disputes</h2>
        <div class="mt-4 space-y-3">
            {% for dispute in disputes %}
                <article class="rounded-2xl border border-border/60 bg-background/60 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <p class="font-bold">{{ dispute.reason }}</p>
                            <p class="text-[11px] text-muted-foreground">Contract #{{ dispute.contract.id }} · opened by {{ dispute.openedBy.displayName }}</p>
                        </div>
                        <a href="{{ path('app_admin_finance_contract_show', {id: dispute.contract.id}) }}" class="rounded-full border border-border px-3 py-1.5 text-xs font-bold hover:bg-muted transition">Open contract</a>
                    </div>
                    {% if dispute.details %}<p class="mt-2 text-sm text-muted-foreground">{{ dispute.details }}</p>{% endif %}
                    <form method="post" action="{{ path('app_admin_finance_dispute_resolve', {id: dispute.id}) }}" class="mt-3 flex gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('resolve_dispute_' ~ dispute.id) }}">
                        <input name="resolution" required placeholder="Resolution" class="h-10 flex-1 rounded-2xl border border-border bg-background/70 px-3 text-sm">
                        <button class="rounded-full bg-primary px-5 text-sm font-bold text-primary-foreground shadow-sm transition hover:shadow-md">Resolve</button>
                    </form>
                </article>
            {% else %}
                <p class="rounded-2xl border border-dashed border-border bg-background/50 p-4 text-sm text-muted-foreground text-center">No open disputes.</p>
            {% endfor %}
        </div>
    </section>

    {# ── All contracts ── #}
    <section class="grid gap-4 lg:grid-cols-2">
        {% for contract in contracts %}
            {% set application = contract.hireOffer.application %}
            <a href="{{ path('app_admin_finance_contract_show', {id: contract.id}) }}" class="group rounded-[1.75rem] border border-border/70 bg-card/70 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-xl hover:border-primary/40">
                <span class="rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-black text-primary">{{ contract.status.label }}</span>
                <h2 class="mt-3 text-xl font-bold">{{ application.jobOffer.title }}</h2>
                <p class="mt-1 text-sm text-muted-foreground"><span class="font-bold text-foreground">{{ contract.amount ?: 'Negotiable' }} {{ contract.currency.value }}</span></p>
            </a>
        {% else %}
            <div class="col-span-full rounded-[1.75rem] border border-dashed border-border bg-card/50 p-12 text-center">
                <p class="text-sm font-bold">No contracts yet</p>
            </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
