{% extends 'layouts/adaptive.html.twig' %}
{% block page_title %}Admin Finance{% endblock %}
{% block content %}
<div class="mx-auto max-w-[90rem] space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <section class="glass-panel p-8"><p class="text-xs font-bold uppercase tracking-label text-primary">Admin finance</p><h1 class="mt-2 text-4xl font-light tracking-holographic">Contracts, escrow, disputes.</h1></section>
    <section class="glass-panel p-5">
        <h2 class="text-xl font-semibold">Open disputes</h2>
        <div class="mt-4 space-y-3">
            {% for dispute in disputes %}
                <article class="rounded-2xl border border-border bg-background/60 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3"><div><p class="font-semibold">{{ dispute.reason }}</p><p class="text-xs text-muted-foreground">Contract #{{ dispute.contract.id }} · opened by {{ dispute.openedBy.displayName }}</p></div><a href="{{ path('app_admin_finance_contract_show', {id: dispute.contract.id}) }}" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">Open contract</a></div>
                    {% if dispute.details %}<p class="mt-2 text-sm text-muted-foreground">{{ dispute.details }}</p>{% endif %}
                    <form method="post" action="{{ path('app_admin_finance_dispute_resolve', {id: dispute.id}) }}" class="mt-3 flex gap-2"><input type="hidden" name="_token" value="{{ csrf_token('resolve_dispute_' ~ dispute.id) }}"><input name="resolution" required placeholder="Resolution" class="h-10 flex-1 rounded-xl border border-border bg-background/70 px-3 text-sm"><button class="rounded-xl bg-primary px-4 text-sm font-bold text-primary-foreground">Resolve</button></form>
                </article>
            {% else %}<p class="text-sm text-muted-foreground">No open disputes.</p>{% endfor %}
        </div>
    </section>
    <section class="grid gap-4 lg:grid-cols-2">
        {% for contract in contracts %}
            {% set application = contract.hireOffer.application %}
            <a href="{{ path('app_admin_finance_contract_show', {id: contract.id}) }}" class="glass-panel p-5 transition hover:border-primary/40"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">{{ contract.status.label }}</span><h2 class="mt-3 text-xl font-semibold">{{ application.jobOffer.title }}</h2><p class="mt-1 text-sm text-muted-foreground">{{ contract.amount ?: 'Negotiable' }} {{ contract.currency.value }}</p></a>
        {% else %}<div class="glass-panel col-span-full p-12 text-center text-muted-foreground">No contracts yet.</div>{% endfor %}
    </section>
</div>
{% endblock %}
