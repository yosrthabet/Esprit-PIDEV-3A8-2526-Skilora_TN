<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><style>body{font-family:sans-serif;font-size:12px;color:#222}h1{font-size:18px;margin-bottom:4px}table{width:100%;border-collapse:collapse;margin-top:16px}th,td{border:1px solid #ccc;padding:6px 8px;text-align:left}th{background:#f5f5f5;font-weight:bold}.total{font-weight:bold;font-size:14px}</style></head>
<body>
    <h1>Payslip</h1>
    <p><strong>Employee:</strong> {{ payslip.employee.displayName }}</p>
    <p><strong>Period:</strong> {{ payslip.periodStart|date('Y-m-d') }} — {{ payslip.periodEnd|date('Y-m-d') }}</p>
    <p><strong>Issued:</strong> {{ payslip.createdAt|date('Y-m-d') }}</p>
    <table>
        <thead><tr><th>Description</th><th style="text-align:right">Amount</th></tr></thead>
        <tbody>
            <tr><td>Gross Salary</td><td style="text-align:right">{{ payslip.grossAmount }} {{ payslip.currency.value }}</td></tr>
            <tr><td>Deductions</td><td style="text-align:right">- {{ (payslip.grossAmount - payslip.netAmount)|number_format(2, '.', '') }} {{ payslip.currency.value }}</td></tr>
            <tr class="total"><td>Net Salary</td><td style="text-align:right">{{ payslip.netAmount }} {{ payslip.currency.value }}</td></tr>
        </tbody>
    </table>
    <p style="margin-top:24px;font-size:10px;color:#888">Generated by Skilora</p>
</body>
</html>
