#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

PORT="${PORT:-8000}"
HOST="${HOST:-127.0.0.1}"

find_available_port() {
    local candidate="$1"
    while lsof -i :"$candidate" -sTCP:LISTEN >/dev/null 2>&1; do
        echo "Port $candidate is busy, trying $((candidate + 1))..."
        candidate=$((candidate + 1))
    done
    printf '%s' "$candidate"
}

PORT="$(find_available_port "$PORT")"

cleanup() {
    kill 0 2>/dev/null || true
}
trap cleanup INT TERM

echo "Starting Skilora dev environment..."
echo "  App  -> http://${HOST}:${PORT}"
echo "  Vite -> http://${HOST}:5173"
echo ""
echo "Press Ctrl+C to stop."
echo ""

npm run dev -- --host "$HOST" &
VITE_PID=$!

if command -v symfony >/dev/null 2>&1; then
    symfony server:start --no-tls --listen-ip="$HOST" --port="$PORT" --allow-http &
    SERVER_PID=$!
else
    php -S "${HOST}:${PORT}" -t public/ &
    SERVER_PID=$!
fi

wait -n "$VITE_PID" "$SERVER_PID" 2>/dev/null || true
cleanup
