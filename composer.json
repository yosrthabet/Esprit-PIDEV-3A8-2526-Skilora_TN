{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.3",
        "dompdf/dompdf": "^3.1.5",
        "endroid/qr-code": "5.0",
        "knpuniversity/oauth2-client-bundle": "^2.20.2",
        "league/oauth2-github": "^3.1.1",
        "league/oauth2-google": "^5.0",
        "scheb/2fa-bundle": "^7.13.1",
        "scheb/2fa-totp": "^7.13.1",
        "smalot/pdfparser": "^2.12.5",
        "stripe/stripe-php": ">=20.1",
        "symfony/asset": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/flex": "^2.10",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/google-mailer": "6.4.*",
        "symfony/http-client": "6.4.*",
        "symfony/lock": "6.4.*",
        "symfony/mailer": "6.4.*",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/rate-limiter": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/translation": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/ux-chartjs": "^2.35",
        "symfony/ux-twig-component": "^2.35",
        "symfony/validator": "6.4.*",
        "symfony/yaml": "6.4.*",
        "symfonycasts/verify-email-bundle": "^1.18",
        "tattali/calendar-bundle": ">=1.3",
        "web-auth/webauthn-lib": ">=5.3.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "audit": {
            "block-insecure": false
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "require-dev": {
        "ahmed-bhs/doctrine-doctor": ">=2.8.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5.63",
        "symfony/browser-kit": "6.4.*",
        "symfony/css-selector": "6.4.*",
        "symfony/debug-bundle": "6.4.*",
        "symfony/web-profiler-bundle": "6.4.*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "suggest": {
        "ext-gd": "Recommended: embed PNG images (e.g. director signature) in certificate PDFs via Dompdf."
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "6.4.*"
        }
    }
}
